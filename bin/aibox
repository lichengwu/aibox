#!/usr/bin/env bash
# aibox — AI coding 工具集模块管理器
# 仓库: https://github.com/lichengwu/aibox
#
# 用法:
#   aibox install <module>          安装模块
#   aibox uninstall <module>        卸载模块
#   aibox update <module> | --all   更新模块
#   aibox list                      已安装模块
#   aibox list-available            可用模块
#   aibox <module> <action> [args]  调用模块服务动作（如 aibox pi-web start）
#   aibox self {update|uninstall|version}
#   aibox help
set -euo pipefail

AIBOX_REPO="lichengwu/aibox"
AIBOX_BRANCH="${AIBOX_BRANCH:-main}"
AIBOX_RAW="${AIBOX_RAW:-https://raw.githubusercontent.com/${AIBOX_REPO}/${AIBOX_BRANCH}}"
AIBOX_HOME="${AIBOX_HOME:-$HOME/.aibox}"
AIBOX_MOD_DIR="$AIBOX_HOME/modules"
AIBOX_INSTALLED="$AIBOX_HOME/installed.sh"
AIBOX_BIN_DIR="${AIBOX_BIN_DIR:-$HOME/.local/bin}"
AIBOX_VERSION="0.1.0"
AIBOX_LAST_DEST=""

log()  { printf '\033[36m[aibox]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[!]\033[0m %s\n' "$*"; }
die()  { printf '\033[31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

# ---------- registry ----------
load_registry() {
  local reg
  reg="$(curl -fsSL "$AIBOX_RAW/registry.sh" 2>/dev/null)" || die "拉取 registry 失败：$AIBOX_RAW/registry.sh"
  eval "$reg"
}

# 读模块字段：module_field <name> <field> —— 依赖已 load_registry
module_field() {
  local key="AIBOX_MODULE_${1//-/_}_${2}"
  eval "printf '%s' \"\${${key}:-}\""
}

module_exists() {
  local m
  for m in ${AIBOX_MODULES:-}; do [ "$m" = "$1" ] && return 0; done
  return 1
}

# 把模块名归一化为 installed 变量键（pi-web -> pi_web）
_ikey() { printf 'AIBOX_INSTALLED_%s' "${1//-/_}"; }

# ---------- installed 状态（文件存储，纯变量，无需 source）----------
is_installed() {
  [ -f "$AIBOX_INSTALLED" ] || return 1
  grep -q "^$(_ikey "$1")=" "$AIBOX_INSTALLED"
}

mark_installed() {
  local key; key="$(_ikey "$1")"
  touch "$AIBOX_INSTALLED"
  { grep -v "^${key}=" "$AIBOX_INSTALLED" 2>/dev/null || true; echo "${key}=\"${2:-unknown}\""; } > "$AIBOX_INSTALLED.tmp"
  mv "$AIBOX_INSTALLED.tmp" "$AIBOX_INSTALLED"
}

unmark_installed() {
  [ -f "$AIBOX_INSTALLED" ] || return 0
  local key; key="$(_ikey "$1")"
  grep -v "^${key}=" "$AIBOX_INSTALLED" > "$AIBOX_INSTALLED.tmp" 2>/dev/null || true
  mv "$AIBOX_INSTALLED.tmp" "$AIBOX_INSTALLED"
}

installed_names() {
  [ -f "$AIBOX_INSTALLED" ] || return 0
  grep -oE "^AIBOX_INSTALLED_[a-z0-9_]+=" "$AIBOX_INSTALLED" 2>/dev/null \
    | sed -E 's/^AIBOX_INSTALLED_//; s/=$//' | tr '_' '-'
}

# 下载模块脚本到本地缓存（结果写入 AIBOX_LAST_DEST）
download_module() {
  local name="$1" dir files f
  load_registry
  module_exists "$name" || die "未知模块: ${name}（aibox list-available 查看可用模块）"
  dir="$(module_field "$name" dir)"
  files="$(module_field "$name" files)"
  [ -n "$dir" ] || die "模块 $name 缺少 dir 字段"
  AIBOX_LAST_DEST="$AIBOX_MOD_DIR/$name"
  mkdir -p "$AIBOX_LAST_DEST"
  for f in $files; do
    log "  拉 $dir/$f"
    curl -fsSL "$AIBOX_RAW/$dir/$f" -o "$AIBOX_LAST_DEST/$f" || die "下载 $dir/$f 失败（确认分支/路径）"
    chmod +x "$AIBOX_LAST_DEST/$f" 2>/dev/null || true
  done
}

# ---------- 命令 ----------
cmd_install() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: aibox install <module>"
  download_module "$name"
  local dest="$AIBOX_LAST_DEST"
  local plat; plat="$(module_field "$name" platform)"
  if [ -n "$plat" ] && [ "$plat" != "$(uname -s | tr '[:upper:]' '[:lower:]')" ]; then
    warn "模块 $name 目标平台 ${plat}，当前 $(uname -s)（继续可能有错）"
  fi
  local inst; inst="$(module_field "$name" install)"
  log "安装 $name ..."
  if [ -n "$inst" ] && [ -f "$dest/$inst" ]; then
    AIBOX_MODULE="$name" bash "$dest/$inst"
  fi
  mark_installed "$name" "$(module_field "$name" version)"
  log "已安装 $name ($(module_field "$name" version)) -> $dest"
}

cmd_uninstall() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: aibox uninstall <module>"
  is_installed "$name" || { warn "$name 未安装"; return; }
  local dest="$AIBOX_MOD_DIR/$name"
  load_registry
  local uninst; uninst="$(module_field "$name" uninstall)"
  if [ -n "$uninst" ] && [ -f "$dest/$uninst" ]; then
    AIBOX_MODULE="$name" bash "$dest/$uninst"
  else
    warn "无 uninstall 钩子，仅清理缓存"
  fi
  rm -rf "$dest"
  unmark_installed "$name"
  log "已卸载 $name"
}

cmd_update() {
  local name="" self_flag=0 restart_arg="" a
  for a in "$@"; do
    case "$a" in
      --all)                  self_flag=1 ;;
      --restart|--no-restart) restart_arg="$a" ;;
      *)                      [ -z "$name" ] && name="$a" ;;
    esac
  done

  if [ -n "$name" ]; then
    is_installed "${name}" || die "${name} 未安装"
    log "更新 ${name}（重新拉取模块脚本）..."
    download_module "${name}"
    local dest="$AIBOX_LAST_DEST" upd
    upd="$(module_field "${name}" update)"
    if [ -n "$upd" ] && [ -f "$dest/$upd" ]; then
      # shellcheck disable=SC2086
      AIBOX_MODULE="${name}" bash "$dest/$upd" ${restart_arg:+"$restart_arg"}
    else
      warn "无 update 钩子，已刷新脚本缓存"
    fi
    mark_installed "${name}" "$(module_field "${name}" version)"
    log "${name} 已更新到 $(module_field "${name}" version)"
  elif [ "$self_flag" = "1" ]; then
    log "更新所有已装模块 ..."
    local m
    for m in $(installed_names); do cmd_update "$m"; done
  else
    die "用法: aibox update <module> [--restart|--no-restart] [--all] | --all"
  fi

  if [ "$self_flag" = "1" ]; then
    log "更新 aibox 主程序 ..."
    cmd_self_update || warn "aibox 自身更新失败（网络？），模块已更新"
  fi
}

cmd_list() {
  if [ ! -f "$AIBOX_INSTALLED" ]; then
    echo "（尚未安装任何模块）"
    echo "可用: aibox list-available"
    return
  fi
  echo "已安装模块："
  local key val name
  while IFS='=' read -r key val; do
    [ -n "$key" ] || continue
    name="${key#AIBOX_INSTALLED_}"
    name="${name//_/-}"
    val="${val%\"}"; val="${val#\"}"
    printf '  %-16s %s\n' "$name" "$val"
  done < "$AIBOX_INSTALLED"
}

cmd_list_available() {
  load_registry
  echo "可用模块（registry @ ${AIBOX_BRANCH}）："
  local m desc ver inst
  for m in ${AIBOX_MODULES:-}; do
    desc="$(module_field "$m" description)"
    ver="$(module_field "$m" version)"
    inst=""; is_installed "$m" && inst="[已装]"
    printf '  %-16s %-8s %s %s\n' "$m" "$ver" "$desc" "$inst"
  done
}

cmd_module_action() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: aibox <module> <action>  或  aibox help"
  shift
  local action="${1:-}"
  if [ -z "$action" ]; then
    echo "模块 ${name}。用法: aibox $name <action>"
    return
  fi
  shift
  is_installed "$name" || die "$name 未安装（先: aibox install ${name}）"
  local svc="$AIBOX_MOD_DIR/$name/svc.sh"
  [ -f "$svc" ] || die "缺少 ${svc}（试 aibox update ${name}）"
  AIBOX_MODULE="$name" bash "$svc" "$action" "$@"
}

cmd_self_update() {
  local before after
  before="$AIBOX_VERSION"
  log "aibox 自身更新：当前 $before，重新 bootstrap ..."
  if curl -fsSL "$AIBOX_RAW/install.sh" | bash; then
    after="$("$AIBOX_BIN_DIR/aibox" version 2>/dev/null | awk '{print $2}')"
    [ -z "$after" ] && after="unknown"
    if [ "$before" = "$after" ]; then
      log "aibox 自身更新完成：已是最新 ($after)"
    else
      log "aibox 自身更新完成：$before -> $after"
    fi
    return 0
  fi
  return 1
}

cmd_self_uninstall() {
  warn "将删除 $AIBOX_HOME 与 $AIBOX_BIN_DIR/aibox"
  warn "已装模块的自身卸载请先: aibox uninstall <module>"
  rm -rf "$AIBOX_HOME"
  rm -f "$AIBOX_BIN_DIR/aibox"
  log "已卸载 aibox"
}

usage() {
  cat <<EOF
aibox $AIBOX_VERSION — AI coding 工具集模块管理器
仓库: https://github.com/lichengwu/aibox

用法:
  aibox install <module>          安装模块
  aibox uninstall <module>        卸载模块
  aibox update <module> | --all   更新模块
  aibox list                      已安装模块
  aibox list-available            可用模块
  aibox <module> <action> [args]  调用模块服务动作（如 aibox pi-web start）
  aibox self update               更新 aibox 主程序
  aibox self uninstall            卸载 aibox
  aibox self version              主程序版本
  aibox version | -v | --version
  aibox help | -h | --help

首个模块: aibox install pi-web
EOF
}

# ---------- dispatch ----------
case "${1:-help}" in
  install)          shift; cmd_install "$@" ;;
  uninstall)        shift; cmd_uninstall "$@" ;;
  update)           shift; cmd_update "$@" ;;
  list)             cmd_list ;;
  list-available|available|search)
                    cmd_list_available ;;
  self)
    case "${2:-}" in
      update)       cmd_self_update ;;
      uninstall)   cmd_self_uninstall ;;
      version)     echo "aibox $AIBOX_VERSION" ;;
      *)           die "用法: aibox self {update|uninstall|version}" ;;
    esac ;;
  version|-v|--version) echo "aibox $AIBOX_VERSION" ;;
  help|-h|--help)   usage ;;
  *)                cmd_module_action "$@" ;;
esac
