#!/usr/bin/env bash
# =============================================================================
#  openmaic — OpenMAIC unified ops CLI
#
#  Owner: aibox module tools/openmaic (repo https://github.com/lichengwu/aibox)
#  Runs on: **deploy host** (Linux, requires docker; default deploy dir $AIBOX_HOME/apps/openmaic)
#           distributed to the target host by `aibox install openmaic`; this repo is the single source.
#  Site info: no hardcoded addresses. Host-specific items (proxy, etc.) are passed in via
#           /etc/openmaic/openmaic.conf or OPENMAIC_* environment variables.
#
#  Design conventions
#    * Single entry point: every ops action goes through `openmaic <command>`
#    * Unified exit codes (see EXIT_* constants), consumable by monitoring systems
#    * Dangerous operations require interactive confirmation by default; non-interactive
#      environments must pass --yes explicitly
#    * Global support for --dry-run / --json / --quiet / --no-color
#    * Idempotent: up / backup / doctor can be run repeatedly
#    * Concurrency guard: upgrade / restore / down hold a lock; backup skips if it cannot get the lock
#    * Config/runtime separation: /etc/openmaic holds secrets (reusable across reinstalls)
#                          $AIBOX_HOME/apps/openmaic holds runtime artifacts (can be wiped wholesale)
# =============================================================================
set -uo pipefail

OPENMAIC_CLI_VERSION="1.0.1"
REPO="THU-MAIC/OpenMAIC"

# ---------------------------------------------------------------- Exit codes
EXIT_OK=0            # Success
EXIT_ERR=1           # Generic runtime error
EXIT_USAGE=2         # Usage error
EXIT_DEP=3           # Missing dependency (docker / curl / git ...)
EXIT_PRECHECK=4      # Pre-check failed (doctor found a blocking issue)
EXIT_ROLLED_BACK=10  # Upgrade failed but auto-rolled back
EXIT_MANUAL=20       # Failed and needs manual intervention
EXIT_NOT_READY=30    # Service not ready (health check timed out)
EXIT_LOCKED=40       # Concurrency conflict (could not acquire lock)
EXIT_CANCELLED=50    # Cancelled by user

# ---------------------------------------------------------------- Paths
CONF_DIR="${OPENMAIC_CONF_DIR:-/etc/openmaic}"
CONF_FILE="$CONF_DIR/openmaic.conf"
PERSIST_BUILD="$CONF_DIR/env.build"
PERSIST_RUNTIME="$CONF_DIR/env.runtime"

# Deploy root: derived from $AIBOX_HOME/apps per the aibox module convention (see aibox docs/module-spec.md).
# macOS and Linux use the same expression; no platform branching:
#   Linux(root)  -> /root/.aibox/apps/openmaic
#   macOS(user)  -> ~/.aibox/apps/openmaic
# Explicit OPENMAIC_BASE_DIR takes precedence. The guard is mandatory: there is no HOME in a
# systemd service context (verified in practice). If resolution fails, it must error out rather
# than ever producing a path like /.aibox/apps/openmaic.
BASE_DIR="${OPENMAIC_BASE_DIR:-}"
if [ -z "$BASE_DIR" ]; then
  _apps_root="${AIBOX_APPS_ROOT:-}"
  if [ -z "$_apps_root" ]; then
    # Note: ${AIBOX_HOME:-$HOME/.aibox}, NOT ${AIBOX_HOME:-$HOME} --
    # the latter would drop the .aibox segment and resolve to $HOME/apps/openmaic.
    _apps_base="${AIBOX_HOME:-${HOME:+$HOME/.aibox}}"
    if [ -z "$_apps_base" ]; then
      printf '[openmaic] cannot determine deploy root: HOME and AIBOX_HOME are both empty\n' >&2
      printf '[openmaic] please set it explicitly, e.g.: OPENMAIC_BASE_DIR=/root/.aibox/apps/openmaic openmaic status\n' >&2
      exit 3
    fi
    _apps_root="$_apps_base/apps"
  fi
  BASE_DIR="$_apps_root/openmaic"
fi
unset _apps_root _apps_base 2>/dev/null || true

# The config file may override the defaults below (env vars take highest precedence)
if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi

APP_DIR="${OPENMAIC_APP_DIR:-$BASE_DIR/app}"
BACKUP_DIR="${OPENMAIC_BACKUP_DIR:-$BASE_DIR/backups}"
LOG_DIR="${OPENMAIC_LOG_DIR:-$BASE_DIR/logs}"
STATE_DIR="${OPENMAIC_STATE_DIR:-$BASE_DIR/state}"
RUN_DIR="${OPENMAIC_RUN_DIR:-$BASE_DIR/run}"

HEALTH_URL="${OPENMAIC_HEALTH_URL:-http://127.0.0.1:3000/api/health}"
HEALTH_TIMEOUT="${OPENMAIC_HEALTH_TIMEOUT:-300}"
BACKUP_KEEP="${OPENMAIC_BACKUP_KEEP:-14}"
BUILD_TIMEOUT_MAIN="${OPENMAIC_BUILD_TIMEOUT_MAIN:-3600}"
BUILD_TIMEOUT_RENDER="${OPENMAIC_BUILD_TIMEOUT_RENDER:-2400}"
# Source pull proxy: if the deploy host cannot reach GitHub directly, set a proxy here.
# Accepts a full URL (http://host:port, socks5://host:port) and also a bare host:port
# (http:// is prepended automatically).
# Reads OPENMAIC_PROXY_URL first, falling back to the legacy key OPENMAIC_PROXY_HOST.
# Empty = do not attempt a proxy channel; use only direct connection and public mirrors.
# Site-specific, so no default is provided.
PROXY_URL="${OPENMAIC_PROXY_URL:-${OPENMAIC_PROXY_HOST:-}}"
case "$PROXY_URL" in
  "" | *://*) ;;
  *) PROXY_URL="http://$PROXY_URL" ;;
esac
# Display form: strip credentials from the URL so proxy username/password never hit the logs.
PROXY_DISPLAY="$PROXY_URL"
case "$PROXY_DISPLAY" in
  *://*:*@*) PROXY_DISPLAY=$(printf '%s' "$PROXY_DISPLAY" | sed -E 's#(://[^:/@]+):[^@]*@#\1:***@#') ;;
esac
RENDER_ENABLED="${OPENMAIC_RENDER_ENABLED:-1}"
# Connect to the shared aibox base PG (avoids a per-module PG, saving resources):
#   1=enabled -- apply_local_patches drops docker-compose.shared.yml into $APP_DIR,
#            compose() appends it with -f automatically; on install it creates the openmaic
#            database in aibox-base-postgres automatically (if base is running).
#   0=standalone PG (default; upstream compose ships its own postgres service).
# You can also drop an override file into $APP_DIR to trigger shared mode
# (shared_pg_active is keyed off the file being in place).
SHARED_PG="${OPENMAIC_SHARED_PG:-0}"
SHARED_OVERRIDE="$APP_DIR/docker-compose.shared.yml"

C_TAG="$STATE_DIR/current-tag"
P_TAG="$STATE_DIR/previous-tag"
HISTORY="$STATE_DIR/upgrade-history.tsv"

DB_USER="openmaic"
DB_NAME="openmaic"
SERVICE_APP="openmaic"

# ---------------------------------------------------------------- Global state
JSON_MODE=0
QUIET=0
ASSUME_YES=0
DRY_RUN=0
NO_COLOR=0
[ -t 1 ] || NO_COLOR=1

C_BOLD=''; C_RED=''; C_GRN=''; C_YEL=''; C_BLU=''; C_DIM=''; C_RST=''
if [ "$NO_COLOR" = 0 ]; then
  C_BOLD=$'\033[1m'; C_RED=$'\033[31m'; C_GRN=$'\033[32m'
  C_YEL=$'\033[33m'; C_BLU=$'\033[36m'; C_DIM=$'\033[2m'; C_RST=$'\033[0m'
fi

# =============================================================================
#  Output layer
# =============================================================================
say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
info() { [ "$QUIET" = 1 ] || printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RST"; }
ok()   { [ "$QUIET" = 1 ] || printf '%s✓%s  %s\n' "$C_GRN" "$C_RST" "$*"; }
warn() { printf '%s⚠%s  %s\n' "$C_YEL" "$C_RST" "$*" >&2; }
err()  { printf '%s✗%s  %s\n' "$C_RED" "$C_RST" "$*" >&2; }
dim()  { [ "$QUIET" = 1 ] || printf '%s%s%s\n' "$C_DIM" "$*" "$C_RST"; }
step() { [ "$QUIET" = 1 ] || printf '\n%s▸ %s%s\n' "$C_BLU" "$*" "$C_RST"; }
hint() { [ "$QUIET" = 1 ] || printf '  %s%s%s\n' "$C_DIM" "$*" "$C_RST"; }
ts()   { date '+%F %T'; }

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}
  printf '%s' "$s"
}

human_dur() {
  local s="${1:-0}"
  if   [ "$s" -lt 60 ];    then echo "${s}s"
  elif [ "$s" -lt 3600 ];  then echo "$((s/60))m$((s%60))s"
  elif [ "$s" -lt 86400 ]; then echo "$((s/3600))h$((s%3600/60))m"
  else echo "$((s/86400))d$((s%86400/3600))h"; fi
}

human_size() {
  local k="${1:-0}"
  if   [ "$k" -lt 1024 ];      then echo "${k}K"
  elif [ "$k" -lt 1048576 ];   then echo "$((k/1024))M"
  else echo "$((k/1048576))G"; fi
}

# =============================================================================
#  Utility layer
# =============================================================================
require_cmd() {
  local missing=0 c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || { err "missing command: $c"; missing=1; }
  done
  [ "$missing" = 0 ] || return "$EXIT_DEP"
}

# Commands that need a "deploy host" environment -- they read $APP_DIR runtime state or operate on it via docker compose.
# These commands touch docker containers/volumes/source and require docker + compose (OS-agnostic; macOS uses Docker Desktop).
# The other commands (help / version / doctor / health / models / backup list / backup verify / completion) are read-only and cross-platform.
NEEDS_HOST_CMDS="status url powerlog up down restart logs render upgrade rollback restore db install clean shell"

require_docker() {
  local cmd="$1"
  command -v docker >/dev/null 2>&1 || {
    err "command ${cmd} requires docker (docker not found in PATH)"
    hint "install docker: aibox install openmaic checks deps automatically; or run aibox check_deps openmaic manually"
    return "$EXIT_DEP"
  }
  if docker compose version >/dev/null 2>&1 || command -v docker-compose >/dev/null 2>&1; then
    return 0
  fi
  err "command ${cmd} requires docker compose (v2 plugin or docker-compose command)"
  return "$EXIT_DEP"
}

ensure_dirs() {
  mkdir -p "$BACKUP_DIR" "$LOG_DIR" "$STATE_DIR" "$RUN_DIR" 2>/dev/null || true
}

# Unified runner for side-effecting commands (in --dry-run it only prints)
run() {
  if [ "$DRY_RUN" = 1 ]; then
    printf '  %s[dry-run]%s %s\n' "$C_DIM" "$C_RST" "$*"
    return 0
  fi
  "$@"
}

# Confirm dangerous operations; reject (don't hang on input) when non-interactive and --yes was not given
confirm() {
  local prompt="$1"
  if [ "$ASSUME_YES" = 1 ]; then
    dim "  --yes given, skipping confirmation: $prompt"
    return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then
    printf '  %s[dry-run]%s would ask: %s\n' "$C_DIM" "$C_RST" "$prompt"
    return 0
  fi
  if [ ! -t 0 ]; then
    err "non-interactive environment, refusing to run a dangerous operation (add --yes to force)"
    return "$EXIT_USAGE"
  fi
  printf '%s%s%s [y/N] ' "$C_YEL" "$prompt" "$C_RST"
  local ans=""
  read -r ans || ans=""
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) warn "cancelled"; return "$EXIT_CANCELLED" ;;
  esac
}

# Concurrency lock: returns EXIT_LOCKED if the lock cannot be acquired.
# Uses fixed fd 9 instead of the bash 4 `exec {fd}>` syntax -- the latter would make this file
# fail at **parse time** on macOS's bundled bash 3.2, so even `--help` would not run. The target
# runtime is Linux bash 5, but staying "parseable" lets us give a clear message (rather than a
# syntax error) on unsupported platforms.
with_lock() {
  local wait_mode="${1:-nowait}"; shift
  ensure_dirs
  exec 9>"$RUN_DIR/openmaic.lock" || return "$EXIT_ERR"
  if [ "$wait_mode" = "try" ]; then
    flock -n 9 || { err "another ops operation is in progress, skipped"; return "$EXIT_LOCKED"; }
  else
    flock -n 9 || { err "another ops operation is in progress, please try again later"; return "$EXIT_LOCKED"; }
  fi
  "$@"
  local rc=$?
  exec 9>&- 2>/dev/null || true
  return $rc
}

# =============================================================================
#  Service layer
# =============================================================================
compose_profiles() {
  printf -- '--profile server-persistence'
  if [ "$RENDER_ENABLED" = 1 ]; then printf -- ' --profile video-export'; fi
  return 0
}

# compose file list: base + shared PG override (the latter is appended only when in place).
# docker-compose.yml is listed explicitly because once -f is given, compose no longer auto-detects the default file.
compose_files() {
  printf -- '-f docker-compose.yml'
  [ -f "$SHARED_OVERRIDE" ] && printf -- ' -f docker-compose.shared.yml'
  return 0
}

# Profile-aware base integration (aibox --profile <name>): named profiles use
# base-<profile>.env + aibox-base-<profile>-postgres; the default profile "base" keeps the
# unsuffixed names. Standalone (no aibox) → AIBOX_PROFILE unset → base.
_AIBOX_PROF="${AIBOX_PROFILE:-base}"
_BASE_SUFFIX=""
[ "$_AIBOX_PROF" != "base" ] && _BASE_SUFFIX="-${_AIBOX_PROF}"
BASE_ENV_FILE="${AIBOX_HOME:-${HOME:+$HOME/.aibox}}/base${_BASE_SUFFIX}.env"
BASE_PG_CONTAINER="aibox-base${_BASE_SUFFIX}-postgres"

# In shared mode, append --env-file <base[-profile].env> (single source of connection info;
# compose interpolates ${AIBOX_POSTGRES_*}).
# base.env is written by aibox base start; if missing it warns (app cannot connect; visible in doctor)
# but does not block compose itself.
compose_env_file() {
  shared_pg_active || return 0
  if [ ! -f "$BASE_ENV_FILE" ]; then
    warn "shared mode but $BASE_ENV_FILE does not exist (run first: aibox${_BASE_SUFFIX:+ --profile ${_AIBOX_PROF}} base start)"
    return 0
  fi
  printf -- '--env-file %s' "$BASE_ENV_FILE"
}

compose() {
  # docker.io source pool: on `up*` subcommands pre-pull uncached images through
  # the ranked mirror pool when the daemon's direct route is dead (healthy
  # networks: a bounded hello-world probe, then compose pulls directly — zero
  # overhead). See the pool block below compose_timed.
  case "${1:-}" in
  up*) docker_pool_prepull $(compose_images) || true ;;
  esac
  ( cd "$APP_DIR" || exit 1
    # shellcheck disable=SC2046
    docker compose $(compose_profiles) $(compose_files) $(compose_env_file) "$@" )
}

# Timed invocation -- when the network is blocked, docker build hangs silently instead of erroring,
# so there must be an upper bound.
compose_timed() {
  local secs="$1"; shift
  ( cd "$APP_DIR" || exit 1
    # shellcheck disable=SC2046
    timeout "$secs" docker compose $(compose_profiles) $(compose_files) $(compose_env_file) "$@" )
}

# ---- docker.io download source pool (pull-via-mirror + tag) ----
# Same pattern as the dify/gitlab/base compose modules and windmill's
# WM_HUB_MIRROR: at `up` time a bounded direct daemon-route probe runs (a real
# `docker pull hello-world` — the DAEMON's egress, not the host's); healthy
# networks keep the zero-overhead default. When the direct route is dead,
# mirrors (live-verified: docker.1ms.run, docker.m.daocloud.io, dockerproxy.net,
# hub.rat.dev) are ranked by concurrent probe pulls and uncached docker.io
# images are pre-pulled via `docker pull <mirror>/<image>` + `docker tag`
# (mirrors proxy identical digests), so `compose up` finds them cached.
# Other registries stay direct-only. Knobs (env): AIBOX_DOCKER_POOL (list;
# "direct" = disabled), AIBOX_DOCKER_MIRROR (user mirror, first),
# AIBOX_DOCKER_FORCE_POOL=1 (skip the direct probe), AIBOX_DOCKER_PROBE_TIMEOUT
# (15), AIBOX_DOCKER_MIRROR_PROBE_TIMEOUT (30), AIBOX_DOCKER_PULL_TIMEOUT (1800).
DOCKER_POOL_MIRRORS="docker.1ms.run docker.m.daocloud.io dockerproxy.net hub.rat.dev"

# Image list the (profile/file/env-aware) compose would pull.
compose_images() {
  ( cd "$APP_DIR" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    docker compose $(compose_profiles) $(compose_files) $(compose_env_file) config --images 2>/dev/null || true )
}

# Is this image ref served by docker.io? A ref WITH a slash has a
# host-or-namespace first segment — dots/colons there mean a foreign registry.
# Without a slash it is name[:tag] on the DEFAULT registry (postgres:15-alpine —
# its colon is the TAG separator, not a port).
_dk_is_dockerio() {
  case "${1}" in
  docker.io/*) return 0 ;;   # explicit default-registry form is still docker.io
  */*)
    case "${1%%/*}" in
    *.* | *:*) return 1 ;;
    *) return 0 ;;
    esac
    ;;
  *) return 0 ;;
  esac
}

# Mirror-prefixed ref (official images live under library/).
_dk_pool_ref() { # $1=mirror-host $2=image-ref
  # Branch order matters: docker.io/* must come before the wildcard */*.
  case "${2}" in
  docker.io/*) printf '%s/%s' "${1}" "${2#docker.io/}" ;;
  */*) printf '%s/%s' "${1}" "${2}" ;;
  *) printf '%s/library/%s' "${1}" "${2}" ;;
  esac
}

# Bounded docker command with a wall-clock watchdog (docker pull has no
# timeout of its own). Date-based deadline so the poll interval never distorts
# the budget. Returns docker's rc, or 124 on timeout.
_dk_bounded() { # $1=timeout_s, rest = docker args
  local t="${1}"; shift
  local logf pid deadline rc
  logf="$(mktemp "${TMPDIR:-/tmp}/dkpool.XXXXXX")" || return 1
  docker "$@" >"${logf}" 2>&1 &
  pid=$!
  deadline=$(( $(date +%s) + t ))
  while kill -0 "${pid}" 2>/dev/null; do
    if [ "$(date +%s)" -ge "${deadline}" ]; then
      kill "${pid}" 2>/dev/null || true
      pkill -P "${pid}" 2>/dev/null || true
      wait "${pid}" 2>/dev/null
      rm -f "${logf}"
      return 124
    fi
    sleep "${AIBOX_DOCKER_POLL:-5}"
  done
  rc=0
  wait "${pid}" || rc=$?
  if [ "${rc}" -ne 0 ]; then
    tail -3 "${logf}" >&2 2>/dev/null || true
  fi
  rm -f "${logf}"
  return "${rc}"
}

# Pre-pull uncached docker.io images through the mirror pool. No-op (fast
# probe) when the daemon's direct route is healthy.
docker_pool_prepull() { # $@ = image refs
  case "${AIBOX_DOCKER_POOL:-}" in
  direct | none | off) return 0 ;;
  esac
  local img uncached="" m mirrors cands pid pids="" tmpd i t0 done1 rc_all=0 full
  for img in "$@"; do
    docker image inspect "${img}" >/dev/null 2>&1 && continue
    _dk_is_dockerio "${img}" || continue
    uncached="${uncached}${uncached:+ }${img}"
  done
  [ -n "${uncached}" ] || return 0
  if [ "${AIBOX_DOCKER_FORCE_POOL:-0}" != "1" ]; then
    docker rmi hello-world >/dev/null 2>&1 || true
    if _dk_bounded "${AIBOX_DOCKER_PROBE_TIMEOUT:-15}" pull hello-world >/dev/null 2>&1; then
      log "docker: direct daemon route OK — compose will pull ${uncached} directly"
      return 0
    fi
  fi
  warn "docker: direct route unusable — engaging the mirror pool for: ${uncached}"
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}/dkrank.XXXXXX")" || return 0
  mirrors="${AIBOX_DOCKER_MIRROR:-}"
  mirrors="${mirrors}${mirrors:+ }${AIBOX_DOCKER_POOL:-${DOCKER_POOL_MIRRORS}}"
  i=0
  # shellcheck disable=SC2086
  for m in ${mirrors}; do
    i=$((i + 1))
    (
      t0=$(date +%s)
      if _dk_bounded "${AIBOX_DOCKER_MIRROR_PROBE_TIMEOUT:-30}" pull "$(_dk_pool_ref "${m}" hello-world)" >/dev/null 2>&1; then
        printf '%s\t%s\n' "$(( $(date +%s) - t0 ))" "${m}" >"${tmpd}/r${i}.res"
      fi
    ) &
    pids="${pids} $!"
  done
  # shellcheck disable=SC2086
  for pid in $pids; do wait "${pid}" 2>/dev/null || true; done
  cands="$(cat "${tmpd}"/r*.res 2>/dev/null | sort -n | cut -f2 || true)"
  rm -rf "${tmpd}"
  if [ -z "${cands}" ]; then
    warn "docker: every mirror probe failed — compose will try direct"
    return 0
  fi
  log "docker mirror ranking: $(printf '%s' "${cands}" | tr '\n' ' ')"
  # shellcheck disable=SC2086
  for img in ${uncached}; do
    docker image inspect "${img}" >/dev/null 2>&1 && continue
    done1=0
    # shellcheck disable=SC2086
    for m in ${cands}; do
      full="$(_dk_pool_ref "${m}" "${img}")"
      log "docker pull ${full} (mirror ${m}, watchdog ${AIBOX_DOCKER_PULL_TIMEOUT:-1800}s)"
      if _dk_bounded "${AIBOX_DOCKER_PULL_TIMEOUT:-1800}" pull "${full}"; then
        docker tag "${full}" "${img}" || { warn "docker tag failed: ${full} → ${img}"; continue; }
        docker rmi "${full}" >/dev/null 2>&1 || true
        ok "pulled ${img} via ${m}"
        done1=1
        break
      fi
      warn "docker: mirror ${m} failed for ${img} — trying the next"
    done
    if [ "${done1}" != "1" ]; then
      warn "docker: no mirror could pull ${img} — compose will try direct"
      rc_all=1
    fi
  done
  return "${rc_all}"
}

# ---- Shared aibox base PG adapter ----
# Whether shared mode is active: flag=1 or the override file already landed in $APP_DIR
# (the latter lets a manually dropped file take effect too).
shared_pg_active() { [ "$SHARED_PG" = 1 ] || [ -f "$SHARED_OVERRIDE" ]; }

# Whether the current PG is reachable. In shared mode it checks the aibox-base-postgres container;
# otherwise it checks the local postgres service.
pg_running() {
  if shared_pg_active; then
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$BASE_PG_CONTAINER"
  else
    compose ps --status running --services 2>/dev/null | grep -qx postgres
  fi
}

# psql entry point. $1=mode: tty=interactive (-it, -T off); pipe=streamed via stdin (-i, -T).
# Remaining args are passed through to psql unchanged.
pg_psql() {
  local mode="$1"; shift
  if shared_pg_active; then
    [ "$mode" = tty ] && docker exec -it "$BASE_PG_CONTAINER" psql -U aibox -d openmaic "$@" \
                      || docker exec -i  "$BASE_PG_CONTAINER" psql -U aibox -d openmaic "$@"
  else
    [ "$mode" = tty ] && compose exec    postgres psql -U "$DB_USER" -d "$DB_NAME" "$@" \
                      || compose exec -T postgres psql -U "$DB_USER" -d "$DB_NAME" "$@"
  fi
}

# pg_dump entry point (shared mode goes through aibox-base-postgres).
pg_dump_cmd() {
  if shared_pg_active; then
    docker exec "$BASE_PG_CONTAINER" pg_dump -U aibox -d openmaic "$@"
  else
    compose exec -T postgres pg_dump -U "$DB_USER" -d "$DB_NAME" "$@"
  fi
}

run_logged() {
  local name="$1"; shift
  local stamp logf
  stamp=$(date +%Y%m%d-%H%M%S)
  logf="$LOG_DIR/${stamp}-${name}.log"
  ensure_dirs
  log "→ ${name} (log ${logf})"
  if [ "$DRY_RUN" = 1 ]; then
    printf '  %s[dry-run]%s %s\n' "$C_DIM" "$C_RST" "$*"
    return 0
  fi
  local rc=0
  "$@" >"$logf" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then ok "$name done"; return 0; fi
  if [ "$rc" -eq 124 ]; then
    err "$name timed out and was aborted"
    hint "troubleshoot: confirm the local patch is in place → grep -- '--registry=' \"$APP_DIR/render-service/Dockerfile\""
    hint "build log: $logf"
    return 1
  fi
  err "$name failed, last 30 lines:"
  tail -n 30 "$logf" >&2
  return 1
}

log() { [ "$QUIET" = 1 ] || printf '%s[%s]%s %s\n' "$C_DIM" "$(ts)" "$C_RST" "$*"; }

health_ok()   { curl -fsS --max-time 8 "$HEALTH_URL" >/dev/null 2>&1; }
health_body() { curl -fsS --max-time 8 "$HEALTH_URL" 2>/dev/null || echo '{}'; }

wait_health() {
  local limit="${1:-$HEALTH_TIMEOUT}" waited=0
  info "waiting for service to be ready (up to ${limit}s)..."
  while [ "$waited" -lt "$limit" ]; do
    if health_ok; then ok "service is ready (${waited}s)"; return 0; fi
    sleep 5; waited=$((waited+5))
    [ $((waited % 30)) -eq 0 ] && dim "  ...waited ${waited}s"
  done
  err "timed out: service is not ready"
  return "$EXIT_NOT_READY"
}

current_tag() {
  if [ -f "$C_TAG" ]; then cat "$C_TAG"; return; fi
  ( cd "$APP_DIR" 2>/dev/null && git describe --tags --always 2>/dev/null ) || echo "unknown"
}

previous_tag() { [ -f "$P_TAG" ] && cat "$P_TAG" || echo ""; }

current_commit() { ( cd "$APP_DIR" 2>/dev/null && git rev-parse --short HEAD 2>/dev/null ) || echo "unknown"; }

latest_tag() {
  local api="https://api.github.com/repos/$REPO/releases/latest" out=""
  out=$(curl -fsS --max-time 20 "$api" 2>/dev/null) || out=""
  if [ -z "$out" ] && [ -n "$PROXY_URL" ]; then
    out=$(curl -fsS --max-time 25 -x "$PROXY_URL" "$api" 2>/dev/null) || out=""
  fi
  [ -n "$out" ] || return 1
  printf '%s' "$out" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
    | sed -E 's/.*"([^"]*)"$/\1/'
}

# Multi-channel fallback for pulling source. The proxy channel is tried only when PROXY_URL is non-empty.
git_fetch_tag() {
  local tag="$1" url
  if [ -n "$PROXY_URL" ]; then
    url="https://github.com/$REPO.git"
    log "channel: direct (via proxy ${PROXY_DISPLAY})"
    if ( cd "$APP_DIR" && env "https_proxy=$PROXY_URL" "http_proxy=$PROXY_URL" \
           GIT_TERMINAL_PROMPT=0 git fetch --tags --force "$url" >/dev/null 2>&1 ); then return 0; fi
  fi
  log "channel: direct (no proxy)"
  url="https://github.com/$REPO.git"
  if ( cd "$APP_DIR" && GIT_TERMINAL_PROMPT=0 git fetch --tags --force "$url" >/dev/null 2>&1 ); then return 0; fi

  local base
  for base in "https://ghproxy.net/https://github.com" "https://gh-proxy.com/https://github.com"; do
    url="$base/$REPO.git"
    log "channel: $base"
    if ( cd "$APP_DIR" && GIT_TERMINAL_PROMPT=0 git fetch --tags --force "$url" >/dev/null 2>&1 ); then return 0; fi
  done
  return 1
}

# Shared PG override: controlled by OPENMAIC_SHARED_PG, lands idempotently into $APP_DIR.
# git checkout --force would wipe it, so it is rebuilt on every checkout inside apply_local_patches.
ensure_shared_pg_override() {
  if [ "$SHARED_PG" = 1 ]; then
    _shared_override_write
  else
    if [ -f "$SHARED_OVERRIDE" ]; then
      if [ "$DRY_RUN" = 1 ]; then
        dim "  [dry-run] would remove ${SHARED_OVERRIDE} (OPENMAIC_SHARED_PG=0, back to standalone PG)"
      else
        rm -f "$SHARED_OVERRIDE"
        ok "removed shared PG override (OPENMAIC_SHARED_PG=0, back to standalone PG)"
      fi
    fi
  fi
  return 0
}

_shared_override_write() {
  [ -f "$APP_DIR/docker-compose.yml" ] || { warn "upstream docker-compose.yml not checked out, skipping shared override"; return 0; }
  if [ -f "$SHARED_OVERRIDE" ] && grep -q 'AIBOX_POSTGRES_HOST' "$SHARED_OVERRIDE" 2>/dev/null; then
    dim "  shared PG override already in place, skipping"
    return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then
    dim "  [dry-run] would write $SHARED_OVERRIDE"
    return 0
  fi
  cat >"$SHARED_OVERRIDE" <<'OVERRIDE'
# OpenMAIC compose override to connect to the shared aibox base PG.
# Dropped into $APP_DIR automatically by the openmaic CLI when OPENMAIC_SHARED_PG=1 (apply_local_patches).
# You can also do it by hand: cp this file to $APP_DIR/docker-compose.shared.yml -- the CLI detects it
# and appends it with -f in compose calls (openmaic up/install/upgrade/backup, etc. all honor it).
#
# Shared PG mode (avoids a per-module PG, saving resources):
#   1. aibox base start && aibox base createdb openmaic
#   2. Enable shared mode: write OPENMAIC_SHARED_PG=1 to /etc/openmaic/openmaic.conf
#      (or temporarily: OPENMAIC_SHARED_PG=1 openmaic install)
#   3. openmaic install / up -- the CLI drops this file + creates the openmaic DB + starts the app
#      connected to the shared PG.
#
# Downgrade (back to standalone PG): set OPENMAIC_SHARED_PG=0 then openmaic up (the CLI removes the override).
#
# Principle: postgres replicas:0 (no local PG started); the openmaic app joins the aibox-base network
#       (connects to the shared PG via the service name aibox-base-postgres); the DATABASE_URL in
#       environment is built from ${AIBOX_POSTGRES_*} -- values are injected from $AIBOX_HOME/base.env via
#       compose --env-file (it overrides DATABASE_URL in .env.local -- environment takes precedence over env_file).
#       .env.local must still exist (PERSISTENCE_DEV_TOKEN, API Key, ACCESS_CODE, etc.).
#       render-service is left untouched -- it sits on the internal: true render network; adding aibox-base
#       would break its egress isolation.
services:
  postgres:
    deploy:
      replicas: 0

  openmaic:
    depends_on: []
    networks:
      - default
      - render
      - aiboxbasenet
    environment:
      - DATABASE_URL=postgres://${AIBOX_POSTGRES_USER}:${AIBOX_POSTGRES_PASSWORD}@${AIBOX_POSTGRES_HOST}:${AIBOX_POSTGRES_PORT}/openmaic

networks:
  aiboxbasenet:
    name: ${AIBOX_BASE_NETWORK:-aibox-base}
    external: true
OVERRIDE
  ok "shared PG override is in place (${SHARED_OVERRIDE})"
}

# Create the openmaic database on the shared aibox base PG (idempotent). Called on install;
# if base is not running it warns but does not block.
ensure_shared_db() {
  [ "$SHARED_PG" = 1 ] || return 0
  if [ "$DRY_RUN" = 1 ]; then
    dim "  [dry-run] would ensure shared database openmaic (aibox-base-postgres)"
    return 0
  fi
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx aibox-base-postgres; then
    warn "OPENMAIC_SHARED_PG=1 but aibox-base-postgres is not running"
    hint "start the shared base first: aibox base start && aibox base createdb openmaic"
    hint "  (if not started, the app cannot reach PG after openmaic up and the health check will fail)"
    return 0
  fi
  if docker exec aibox-base-postgres psql -U aibox -tAc "SELECT 1 FROM pg_database WHERE datname='openmaic'" 2>/dev/null | grep -q 1; then
    ok "shared database openmaic is ready (aibox-base-postgres)"
    return 0
  fi
  if docker exec aibox-base-postgres psql -U aibox -c 'CREATE DATABASE "openmaic";' >/dev/null 2>&1; then
    ok "created shared database openmaic (aibox-base-postgres)"
  else
    err "failed to create shared database openmaic (is the aibox-base-postgres user not 'aibox'? adjust AIBOX_BASE_POSTGRES_USER and retry, and update DATABASE_URL in the override accordingly)"
    return "$EXIT_PRECHECK"
  fi
}

# git checkout --force overwrites local changes, so patches must be rebuilt after every checkout.
apply_local_patches() {
  # Shared PG override (controlled by OPENMAIC_SHARED_PG; idempotent; runs before other patches; non-blocking)
  ensure_shared_pg_override

  local f="$APP_DIR/render-service/Dockerfile"
  [ -f "$f" ] || { warn "${f} not found, skipping patches"; return 0; }

  if grep -q -- '--registry=' "$f"; then
    dim "  patch already in place, skipping"
    return 0
  fi
  if ! grep -qE '^RUN npm ci' "$f"; then
    err "upstream npm ci line format has changed, refusing to patch silently -- please inspect $f manually"
    hint "expected match: RUN npm ci ... ; not found"
    return 1
  fi

  if [ "$DRY_RUN" = 1 ]; then
    dim "  [dry-run] would rebuild the render-service npm registry patch"
    return 0
  fi

  cp -a "$f" "$f.bak"
  if ! grep -qE '^COPY package\.json package-lock\.json \./' "$f"; then
    err "upstream Dockerfile COPY line format has changed, refusing to patch silently -- needs manual inspection"
    mv -f "$f.bak" "$f"
    return 1
  fi
  # 1) Inject an ARG after the COPY package.json / package-lock.json line
  sed -i '/^COPY package\.json package-lock\.json \.\//a ARG NPM_REGISTRY=https://registry.npmmirror.com' "$f"
  # 2) Append the registry flag to the npm ci line
  sed -i -E 's#^(RUN npm ci.*)$#\1 --registry=${NPM_REGISTRY}#' "$f"

  if grep -q -- '--registry=${NPM_REGISTRY}' "$f"; then
    ok "rebuilt render-service patch"
    rm -f "$f.bak"
    return 0
  fi
  err "patch rebuild failed, restored"
  mv -f "$f.bak" "$f"
  return 1
}

sync_config_to_persist() {
  [ "$DRY_RUN" = 1 ] && { dim "  [dry-run] would sync config to $CONF_DIR"; return 0; }
  mkdir -p "$CONF_DIR"
  [ -f "$APP_DIR/.env" ]       && cp -a "$APP_DIR/.env"       "$PERSIST_BUILD"
  [ -f "$APP_DIR/.env.local" ] && cp -a "$APP_DIR/.env.local" "$PERSIST_RUNTIME"
  chmod 600 "$PERSIST_BUILD" "$PERSIST_RUNTIME" 2>/dev/null || true
  return 0
}

restore_config_from_persist() {
  mkdir -p "$CONF_DIR"
  local restored=0
  if [ ! -f "$APP_DIR/.env" ] && [ -f "$PERSIST_BUILD" ]; then
    cp -a "$PERSIST_BUILD" "$APP_DIR/.env"; chmod 600 "$APP_DIR/.env"; restored=1
  fi
  if [ ! -f "$APP_DIR/.env.local" ] && [ -f "$PERSIST_RUNTIME" ]; then
    cp -a "$PERSIST_RUNTIME" "$APP_DIR/.env.local"; chmod 600 "$APP_DIR/.env.local"; restored=1
  fi
  [ "$restored" = 1 ] && ok "reused persisted config from $CONF_DIR"
  return 0
}

mask_file() {
  local f="$1"
  [ -f "$f" ] || { warn "$f not found"; return 0; }
  grep -vE '^\s*#|^\s*$' "$f" \
    | sed -E 's/(TOKEN=)(.{0,6}).*/\1\2***/;
              s/(API_KEY=)(.{0,5}).*/\1\2***/;
              s/(PASSWORD=)(.{0,3}).*/\1\2***/;
              s/(ACCESS_CODE=)(.{0,3}).*/\1\2***/;
              s#(postgres://[^:/@]+:)[^@]*@#\1***@#'
}

# Parse the source label from a backup filename (shown by backup list)
backup_source() {
  local b="${1##*/}"
  b="${b#pg-}"; b="${b%.sql.gz}"
  b=$(printf '%s' "$b" | sed -E 's/-[0-9]{8}-[0-9]{6}$//')
  case "$b" in
    manual)       printf 'manual' ;;
    daily)        printf 'legacy-scheduled' ;;
    prerestore)   printf 'pre-restore' ;;
    preupgrade-*) printf 'pre-upgrade' ;;
    *)            printf '%s' "$b" ;;
  esac
}

# Backup. The first argument is a source label used in the filename, so you can tell later
# where a given backup came from:
#   manual      manual openmaic backup
#   preupgrade  automatic, before upgrade (carries the target version)
#   prerestore  automatic, before restore
# Note: no scheduled backup runs on this host (covered by VM-level backups), so the pg-daily-
#       prefix is no longer used; rotation still globs pg-*.sql.gz, so old files are unaffected.
do_backup_inner() {
  require_docker backup || return $?
  ensure_dirs
  local label="${1:-manual}" stamp out total
  stamp=$(date +%Y%m%d-%H%M%S)
  out="$BACKUP_DIR/pg-${label}-$stamp.sql.gz"

  if ! pg_running; then
    if shared_pg_active; then
      err "aibox-base-postgres is not running, skipping backup (aibox base start)"
    else
      err "postgres is not running, skipping backup"
    fi
    return 1
  fi
  if [ "$DRY_RUN" = 1 ]; then
    dim "  [dry-run] would back up to $out"
    return 0
  fi
  if pg_dump_cmd 2>/dev/null | gzip >"$out"; then
    if [ -s "$out" ] && gzip -t "$out" 2>/dev/null; then
      ok "backup succeeded: $(basename "$out") ($(human_size "$(du -k "$out" | cut -f1)"))"
    else
      err "backup file is invalid, deleted"; rm -f "$out"; return 1
    fi
  else
    err "pg_dump failed"; rm -f "$out"; return 1
  fi

  total=$(ls -1 "$BACKUP_DIR"/pg-*.sql.gz 2>/dev/null | wc -l | tr -d ' ')
  if [ "${total:-0}" -gt "$BACKUP_KEEP" ]; then
    ls -1t "$BACKUP_DIR"/pg-*.sql.gz | tail -n +$((BACKUP_KEEP + 1)) | while read -r old; do
      dim "  pruning old backup $(basename "$old")"; rm -f "$old"
    done
  fi
  return 0
}

# =============================================================================
#  Commands: diagnostics & self-check
# =============================================================================
cmd_status() {
  local tag commit body
  tag=$(current_tag); commit=$(current_commit); body=$(health_body)

  if [ "$JSON_MODE" = 1 ]; then
    local healthy="false"
    health_ok && healthy="true"
    printf '{"command":"status","tag":"%s","commit":"%s","healthy":%s,"health":%s,"containers":[%s]}\n' \
      "$(json_escape "$tag")" "$(json_escape "$commit")" "$healthy" \
      "$body" \
      "$(compose ps --format json 2>/dev/null | paste -sd, - || true)"
    return 0
  fi

  info "OpenMAIC status"
  printf '  version %s  (%s)\n' "$tag" "$commit"
  printf '  url     http://%s:3000\n' "$(hostname -I 2>/dev/null | awk '{print $1}')"
  printf '  health  '
  if health_ok; then printf '%sok%s      %s\n' "$C_GRN" "$C_RST" "$body"; else printf '%sfailing%s\n' "$C_RED" "$C_RST"; fi
  printf '  render  '
  if compose ps --status running --services 2>/dev/null | grep -qx render-service; then
    printf '%srunning%s (uses ~8G memory)\n' "$C_GRN" "$C_RST"
  else
    printf '%sstopped%s (video export falls back to ZIP)\n' "$C_DIM" "$C_RST"
  fi
  echo
  info "Containers"
  compose ps 2>/dev/null
  echo
  info "Resources"
  docker stats --no-stream --format "  {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}" 2>/dev/null | head -6
  return 0
}

cmd_health() {
  local wait=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait) wait="${2:-$HEALTH_TIMEOUT}"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ "$wait" -gt 0 ]; then wait_health "$wait"; return $?; fi
  local body; body=$(health_body)
  if health_ok; then
    if [ "$JSON_MODE" = 1 ]; then
      printf '{"healthy":true,"health":%s}\n' "$body"
    else
      ok "healthy"; say "$body"
    fi
    return 0
  fi
  if [ "$JSON_MODE" = 1 ]; then printf '{"healthy":false}\n'; else err "health check failed"; fi
  return "$EXIT_NOT_READY"
}

cmd_doctor() {
  local issues=0 warns=0
  info "OpenMAIC environment self-check"
  if ! command -v docker >/dev/null 2>&1; then
    hint "no docker -- container/image checks below are expected to fail; treat as reference only"
  fi

  chk_ok()   { printf '  %s✔%s %-28s %s\n' "$C_GRN" "$C_RST" "$1" "${2:-}"; }
  chk_warn() { printf '  %s!%s %-28s %s\n' "$C_YEL" "$C_RST" "$1" "${2:-}"; warns=$((warns+1)); }
  chk_bad()  { printf '  %s✘%s %-28s %s\n' "$C_RED" "$C_RST" "$1" "${2:-}"; issues=$((issues+1)); }

  echo; info "Runtime"
  command -v docker >/dev/null 2>&1 && chk_ok "docker" "$(docker --version 2>/dev/null | cut -d, -f1)" || chk_bad "docker" "not installed"
  docker info >/dev/null 2>&1 && chk_ok "docker daemon" "running" || chk_bad "docker daemon" "not running"
  command -v curl >/dev/null 2>&1 && chk_ok "curl" || chk_bad "curl" "not installed"
  command -v git  >/dev/null 2>&1 && chk_ok "git"  || chk_warn "git" "not installed (upgrade will fail)"
  command -v flock >/dev/null 2>&1 && chk_ok "flock" || chk_warn "flock" "not installed (no concurrency guard)"

  echo; info "Directories & config"
  for d in "$APP_DIR" "$BACKUP_DIR" "$LOG_DIR"; do
    [ -d "$d" ] && chk_ok "$d" "present" || chk_warn "$d" "missing"
  done
  for d in "$STATE_DIR" "$RUN_DIR"; do
    [ -d "$d" ] && chk_ok "$d" "present" || chk_ok "$d" "created on demand"
  done
  [ -f "$APP_DIR/.env" ]       && chk_ok ".env" "present" || chk_bad ".env" "missing (build params unavailable)"
  [ -f "$APP_DIR/.env.local" ] && chk_ok ".env.local" "present" || chk_bad ".env.local" "missing (runtime config unavailable)"
  for f in "$APP_DIR/.env" "$APP_DIR/.env.local"; do
    if [ -f "$f" ]; then
      local perm; perm=$(stat -c '%a' "$f" 2>/dev/null || echo "?")
      [ "$perm" = "600" ] && chk_ok "$(basename "$f") perms" "600" || chk_warn "$(basename "$f") perms" "${perm} (recommended 600)"
    fi
  done

  echo; info "Network & sources"
  local dns_ok=1 n
  for n in dashscope.aliyuncs.com registry.npmmirror.com; do
    if getent hosts "$n" >/dev/null 2>&1 || nslookup "$n" >/dev/null 2>&1; then :; else dns_ok=0; fi
  done
  [ "$dns_ok" = 1 ] && chk_ok "DNS resolution" "domains resolvable" || chk_bad "DNS resolution" "resolution failed (check /etc/resolv.conf)"

  # Source-pull proxy. "not configured" is a normal state (direct connection and public mirrors
  # still work), so it is recorded as ok rather than a warning; otherwise every self-check would
  # spit out a false alarm and people would stop reading the output.
  if [ -n "$PROXY_URL" ]; then
    chk_ok "source-pull proxy" "${PROXY_DISPLAY}"
  else
    chk_ok "source-pull proxy" "not configured (direct + public mirrors only)"
  fi

  if [ -f /etc/docker/daemon.json ]; then
    grep -q '"dns"' /etc/docker/daemon.json \
      && chk_ok "docker daemon.json dns" "$(grep -o '"dns": *\[[^]]*\]' /etc/docker/daemon.json | head -1)" \
      || chk_warn "docker daemon.json dns" "DNS not pinned; build containers may inherit a broken resolver"
    grep -q 'registry-mirrors' /etc/docker/daemon.json \
      && chk_ok "docker registry-mirrors" "configured" \
      || chk_warn "docker registry-mirrors" "not configured (image pulls may time out)"
  else
    chk_warn "/etc/docker/daemon.json" "missing"
  fi

  # Note: do not add curl -f -- the root path may return non-2xx, which would make "network
  # reachable" look like "unreachable".
  local http_code
  http_code=$(curl -sS --max-time 6 -o /dev/null -w '%{http_code}' https://dashscope.aliyuncs.com 2>/dev/null || echo "000")
  if [ "$http_code" != "000" ]; then
    chk_ok "Bailian connectivity" "reachable (HTTP ${http_code})"
  else
    chk_bad "Bailian connectivity" "unreachable (model calls will fail)"
  fi

  if [ -f "$APP_DIR/render-service/Dockerfile" ]; then
    grep -q -- '--registry=' "$APP_DIR/render-service/Dockerfile" \
      && chk_ok "render-service npm patch" "in place" \
      || chk_bad "render-service npm patch" "missing (build will hang silently)"
  fi

  echo; info "System resources"
  # /proc/meminfo and df -k are both in kB; human_size also takes kB as input.
  local avail_k total_k swap_k disk_k
  avail_k=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  total_k=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_k=$(awk '/SwapTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  local _dfr="/"; [ -d "${BASE_DIR:-}" ] && _dfr="$BASE_DIR"; disk_k=$(df -k "$_dfr" 2>/dev/null | awk 'NR==2{print $4}' || echo 0)
  [ "$avail_k" -gt 2000000 ] && chk_ok "available memory" "$(human_size "$avail_k") / $(human_size "$total_k")" \
                             || chk_warn "available memory" "$(human_size "$avail_k") (low)"
  [ "$swap_k" -gt 1000000 ]  && chk_ok "Swap" "$(human_size "$swap_k")" \
                             || chk_warn "Swap" "$(human_size "$swap_k") (recommended >=4G)"
  [ "$disk_k" -gt 5000000 ]  && chk_ok "disk available" "$(human_size "$disk_k")" \
                             || chk_warn "disk available" "$(human_size "$disk_k") (low)"

  echo; info "Services"
  compose ps --status running --services 2>/dev/null | grep -qx "$SERVICE_APP" \
    && chk_ok "app container" "running" || chk_bad "app container" "not running"
  if shared_pg_active; then
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx aibox-base-postgres; then
      chk_ok "PostgreSQL" "shared aibox-base-postgres running"
    else
      chk_bad "PostgreSQL" "shared aibox-base-postgres not running (aibox base start)"
    fi
    [ -f "$SHARED_OVERRIDE" ] \
      && chk_ok "shared PG override" "in place" \
      || chk_bad "shared PG override" "missing (OPENMAIC_SHARED_PG=1 but not generated; rerun openmaic install/upgrade)"
  else
    compose ps --status running --services 2>/dev/null | grep -qx postgres \
      && chk_ok "PostgreSQL" "running" || chk_bad "PostgreSQL" "not running"
  fi
  health_ok && chk_ok "health check" "$HEALTH_URL" || chk_bad "health check" "no response"

  echo; info "Backups"
  # This host deliberately does not run scheduled backups (covered by VM-level backups). This
  # section only reports status, so both cases are recorded as ok -- to avoid reporting
  # "disabled by design" as a missing config.
  local bk_cnt bk_fmt
  bk_cnt=$(ls -1 "$BACKUP_DIR"/pg-*.sql.gz 2>/dev/null | wc -l | tr -d ' ')
  bk_fmt=$(ls -1t "$BACKUP_DIR"/pg-*.sql.gz 2>/dev/null | head -1 || true)
  if command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -q "openmaic.*backup"; then
    chk_ok "scheduled backup" "enabled (cron)"
  else
    chk_ok "scheduled backup" "not enabled (covered by VM-level backups; as designed)"
  fi
  chk_ok "existing backups" "${bk_cnt} file(s)${bk_fmt:+, latest $(basename "$bk_fmt")}"

  echo
  if [ "$issues" -gt 0 ]; then
    err "self-check done: $issues blocking issue(s), $warns warning(s)"
    return "$EXIT_PRECHECK"
  fi
  [ "$warns" -gt 0 ] && { warn "self-check done: $warns warning(s), no blocking issues"; return 0; }
  ok "self-check done: all passed"
  return 0
}

_boot_end_mode() {
  local id="$1"
  if [ "$id" = "0" ]; then echo "running"; return 0; fi
  if journalctl -b "$id" --no-pager 2>/dev/null \
       | grep -qE "Journal stopped|Shutting down\.|systemd-shutdown\[1\]"; then
    echo "clean"
  else
    echo "unclean"
  fi
}

cmd_powerlog() {
  local n=12 only_last=0
  case "${1:-}" in
    --last) only_last=1 ;;
    ''|*[!0-9]*) ;;
    *) n="$1" ;;
  esac

  # --last: only classify the most recent "ended" boot, for consumption by inspection scripts.
  #   Exit code 0 = clean shutdown / 1 = unclean power loss.
  if [ "$only_last" = 1 ]; then
    local lf bid sd ed mode
    lf=$(journalctl --list-boots --no-pager 2>/dev/null | grep -vE '^[[:space:]]*0[[:space:]]' | tail -1)
    if [ -z "$lf" ]; then say "no historical boot records"; return 0; fi
    bid=$(awk '{print $1}' <<<"$lf")
    sd=$(awk '{print $4" "$5}' <<<"$lf")
    ed=$(awk '{print $8" "$9}' <<<"$lf")
    mode=$(_boot_end_mode "$bid")
    if [ "$mode" = "unclean" ]; then
      printf 'unclean power loss  %s → %s\n' "$sd" "$ed"
      return 1
    fi
    printf 'clean shutdown       %s → %s\n' "$sd" "$ed"
    return 0
  fi

  info "Boot record analysis -- unclean power-loss detection"
  printf '  host %s   generated %s\n\n' "$(hostname)" "$(ts)"
  printf '  %-5s %-17s %-17s %-12s %s\n' "BOOT" "START" "END" "UPTIME" "EXIT"
  echo "  ----------------------------------------------------------------------"

  local unclean_count=0 line bid sd ed se ee dur mode label
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    bid=$(awk '{print $1}'  <<<"$line")
    sd=$(awk '{print $4" "$5}' <<<"$line")
    ed=$(awk '{print $8" "$9}' <<<"$line")
    se=$(date -d "$sd" +%s 2>/dev/null || echo 0)
    ee=$(date -d "$ed" +%s 2>/dev/null || echo 0)
    dur=$(( ee - se )); [ "$dur" -lt 0 ] && dur=0
    mode=$(_boot_end_mode "$bid")
    case "$mode" in
      running) label="${C_GRN}running${C_RST}" ;;
      clean)   label="${C_GRN}clean shutdown${C_RST}" ;;
      unclean) label="${C_RED}unclean power loss${C_RST}"; unclean_count=$((unclean_count+1)) ;;
    esac
    printf '  %-5s %-17s %-17s %-12s %b\n' "$bid" "$sd" "$ed" "$(human_dur "$dur")" "$label"
  done < <(journalctl --list-boots --no-pager 2>/dev/null | tail -n "$n")

  echo "  ----------------------------------------------------------------------"
  printf '\n  stats (last %s boots): unclean power loss %s\n' "$n" "$unclean_count"

  if [ "$unclean_count" -gt 0 ]; then
    echo
    hint "unclean power loss = no shutdown procedure ran at power-off, equivalent to pulling the plug;"
    hint "  the cause is usually on the PVE host side:"
    hint "  1. host memory exhausted; OOM killer killed the QEMU process"
    hint "  2. someone clicked 'Stop' in PVE (forced power-off) instead of 'Shutdown'"
    hint "  3. host kernel crash, reboot, or physical power loss"
    hint "investigate on the PVE host:"
    hint "  dmesg -T | grep -iE 'out of memory|oom-kill|killed process'"
    hint "  grep -iE 'qmstop|qmshutdown' /var/log/pve/tasks/index | tail -20"
  fi
  return 0
}

cmd_version() {
  local check=0
  [ "${1:-}" = "--check" ] && check=1
  local cur; cur=$(current_tag)
  if [ "$JSON_MODE" = 1 ]; then
    local latest=""
    [ "$check" = 1 ] && latest=$(latest_tag 2>/dev/null || true)
    printf '{"command":"version","cli":"%s","current":"%s","commit":"%s","latest":"%s"}\n' \
      "$OPENMAIC_CLI_VERSION" "$(json_escape "$cur")" "$(json_escape "$(current_commit)")" "$(json_escape "$latest")"
    return 0
  fi
  printf '  CLI      %s\n' "$OPENMAIC_CLI_VERSION"
  printf '  deployed %s  (%s)\n' "$cur" "$(current_commit)"
  [ "$check" = 0 ] && return 0
  printf '  upstream '
  local l; l=$(latest_tag) || { printf '%scheck failed (network unreachable)%s\n' "$C_YEL" "$C_RST"; return "$EXIT_ERR"; }
  if [ "$l" = "$cur" ]; then printf '%s%s (up to date)%s\n' "$C_GRN" "$l" "$C_RST"
  else printf '%s%s (new version available; run openmaic upgrade)%s\n' "$C_YEL" "$l" "$C_RST"; fi
  return 0
}

# =============================================================================
#  Commands: service lifecycle
# =============================================================================
cmd_up() {
  [ "${1:-}" = "--no-render" ] && RENDER_ENABLED=0
  require_cmd docker || return $?
  # The shared PG override may have been enabled by the flag only after install -- ensure it
  # matches the flag before bringing things up.
  ensure_shared_pg_override
  step "Starting containers"
  run compose up -d --remove-orphans || { err "startup failed"; return "$EXIT_ERR"; }
  if [ "$DRY_RUN" = 1 ]; then hint "skipping health check (dry-run)"; return 0; fi
  wait_health
}

cmd_down() {
  step "Stopping containers"
  confirm "Stop all OpenMAIC containers?" || return $?
  if [ "$DRY_RUN" = 1 ]; then hint "would run docker compose down"; return 0; fi
  with_lock nowait _down_body
}

_down_body() {
  compose down || { err "stop failed"; return "$EXIT_ERR"; }
  ok "stopped"
  return 0
}

cmd_restart() {
  local svc="${1:-$SERVICE_APP}"
  step "Restarting $svc"
  # Keep the shared PG override consistent with the flag (the up path uses it).
  ensure_shared_pg_override
  if ! compose ps --status running --services 2>/dev/null | grep -qx "$svc"; then
    hint "$svc is not running, starting it instead"
    run compose up -d "$svc" || return "$EXIT_ERR"
  else
    run compose restart "$svc" || return "$EXIT_ERR"
  fi
  if [ "$DRY_RUN" = 1 ]; then hint "skipping health check (dry-run)"; return 0; fi
  [ "$svc" = "$SERVICE_APP" ] && wait_health
  return 0
}

cmd_logs() {
  local follow=0 lines=200 svc="$SERVICE_APP"
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      -n) lines="$2"; shift 2 ;;
      -*) shift ;;
      *) svc="$1"; shift ;;
    esac
  done
  if [ "$follow" = 1 ]; then compose logs -f --tail="$lines" "$svc"
  else compose logs --tail="$lines" "$svc"; fi
}

cmd_render() {
  case "${1:-}" in
    on)
      step "Starting render service"
      RENDER_ENABLED=1
      run compose up -d render-service || return "$EXIT_ERR"
      ok "render service started (memory ceiling ~8G)"
      ;;
    off)
      step "Stopping render service"
      run compose stop render-service || return "$EXIT_ERR"
      ok "render service stopped (memory released; video export falls back to ZIP download)"
      ;;
    *) err "usage: openmaic render on|off"; return "$EXIT_USAGE" ;;
  esac
  return 0
}

# =============================================================================
#  Commands: upgrade & rollback
# =============================================================================
record_history() {
  ensure_dirs
  printf '%s\t%s\t%s\t%s\n' "$(ts)" "$1" "$2" "$3" >>"$HISTORY"
}

cmd_upgrade() {
  local check=0 to="" 
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      --to) to="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  local cur; cur=$(current_tag)
  if [ "$check" = 1 ]; then
    local l; l=$(latest_tag) || { err "cannot fetch upstream version (network unreachable)"; return "$EXIT_ERR"; }
    info "Version check"
    printf '  current %s\n  upstream %s\n' "$cur" "$l"
    [ "$l" = "$cur" ] && ok "up to date" || warn "a new version is available"
    return 0
  fi

  require_cmd docker git || return $?
  with_lock nowait _upgrade_body "$cur" "$to"
}

_upgrade_body() {
  local cur="$1" to="$2"
  local target="$to"
  if [ -z "$target" ]; then
    target=$(latest_tag) || { err "cannot fetch latest upstream version (network unreachable)"; return "$EXIT_ERR"; }
  fi

  step "Upgrading $cur → $target"
  if [ "$cur" = "$target" ]; then ok "already at target version, no upgrade needed"; return 0; fi

  if [ "$DRY_RUN" = 1 ]; then
    hint "will run: backup DB → fetch $target → rebuild patches → build → switch → health check → auto-rollback on failure"
    return 0
  fi

  # 1) Backup
  step "1/6 Back up database"
  do_backup_inner "preupgrade-$target" || warn "backup failed, continuing (before upgrading, verify a usable backup by hand)"

  # 2) Fetch source
  step "2/6 Fetch source $target"
  git_fetch_tag "$target" || { err "fetch failed (all channels unavailable)"; return "$EXIT_ERR"; }
  ( cd "$APP_DIR" && git checkout --force "$target" >/dev/null 2>&1 ) \
    || { err "checkout of $target failed"; return "$EXIT_ERR"; }
  ok "checked out $target"

  # 3) Rebuild patches
  step "3/6 Rebuild local patches"
  apply_local_patches || { err "patch rebuild failed, aborted (running services untouched)"; return "$EXIT_ERR"; }

  # 4) Build
  step "4/6 Build images (render image ceiling $((BUILD_TIMEOUT_RENDER/60)) min)"
  if ! run_logged "build-render" compose_timed "$BUILD_TIMEOUT_RENDER" build render-service; then
    err "render image build failed, services not switched"
    ( cd "$APP_DIR" && git checkout --force "$cur" >/dev/null 2>&1 ) && apply_local_patches >/dev/null 2>&1
    return "$EXIT_ERR"
  fi
  if ! run_logged "build-main" compose_timed "$BUILD_TIMEOUT_MAIN" build openmaic; then
    err "main image build failed, services not switched"
    ( cd "$APP_DIR" && git checkout --force "$cur" >/dev/null 2>&1 ) && apply_local_patches >/dev/null 2>&1
    return "$EXIT_ERR"
  fi

  # 5) Switch
  step "5/6 Switch containers"
  echo "$cur" >"$P_TAG"
  echo "$target" >"$C_TAG"
  compose up -d --remove-orphans || { err "container switch failed"; return "$EXIT_MANUAL"; }

  # 6) Health check (auto-rollback on failure)
  step "6/6 Health check"
  if wait_health; then
    ok "upgrade complete: $target"
    record_history "$target" "ok" "from=$cur"
    return 0
  fi

  err "health check failed, rolling back to $cur"
  record_history "$target" "rolled-back" "from=$cur"
  _rollback_body "$cur"
  return "$EXIT_ROLLED_BACK"
}

cmd_rollback() {
  local prev; prev=$(previous_tag)
  [ -n "$prev" ] || { err "no recorded version to roll back to"; return "$EXIT_ERR"; }
  with_lock nowait _rollback_body "$prev"
}

_rollback_body() {
  local target="$1"
  step "Rolling back to $target"
  if [ "$DRY_RUN" = 1 ]; then hint "would check out ${target}, rebuild patches, build, switch"; return 0; fi

  ( cd "$APP_DIR" && git checkout --force "$target" >/dev/null 2>&1 ) \
    || { err "checkout of $target failed"; return "$EXIT_MANUAL"; }
  apply_local_patches || return "$EXIT_MANUAL"
  run_logged "rollback-build-main" compose_timed "$BUILD_TIMEOUT_MAIN" build openmaic \
    || return "$EXIT_MANUAL"
  run_logged "rollback-build-render" compose_timed "$BUILD_TIMEOUT_RENDER" build render-service \
    || warn "render image build failed, only switching the main app"

  local cur; cur=$(current_tag)
  echo "$cur" >"$P_TAG"
  echo "$target" >"$C_TAG"
  compose up -d --remove-orphans || return "$EXIT_MANUAL"
  if wait_health; then
    ok "rolled back to $target"; record_history "$target" "rollback-ok" ""; return 0
  fi
  err "health check still failing after rollback; needs manual intervention"
  return "$EXIT_MANUAL"
}

cmd_upgrade_log() {
  [ "${1:-}" = "log" ] && shift
  local n=20
  [ "${1:-}" = "-n" ] && n="${2:-20}"
  if [ ! -f "$HISTORY" ]; then dim "no upgrade history yet"; return 0; fi
  info "Upgrade history (last $n entries)"
  printf '  %-20s %-14s %-12s %s\n' "TIME" "VERSION" "RESULT" "NOTE"
  tail -n "$n" "$HISTORY" | while IFS=$'\t' read -r t v r note; do
    printf '  %-20s %-14s %-12s %s\n' "$t" "$v" "$r" "$note"
  done
  return 0
}

# =============================================================================
#  Commands: data & backup
# =============================================================================
cmd_backup() {
  local sub="${1:-run}"
  case "$sub" in
    run|"")
      require_cmd docker || return $?
      step "Backing up database"
      # Skip if the lock cannot be acquired (avoid clashing with an upgrade)
      if [ "$DRY_RUN" = 1 ]; then do_backup_inner manual; return $?; fi
      with_lock try do_backup_inner manual
      return $?
      ;;
    list)
      local files; files=$(ls -1t "$BACKUP_DIR"/pg-*.sql.gz 2>/dev/null || true)
      if [ -z "$files" ]; then dim "no backups yet"; return 0; fi
      if [ "$JSON_MODE" = 1 ]; then
        printf '['
        local first=1 f
        while read -r f; do
          [ -z "$f" ] && continue
          [ "$first" = 0 ] && printf ','
          printf '{"file":"%s","source":"%s","bytes":%s,"mtime":"%s"}' \
            "$(json_escape "$(basename "$f")")" "$(json_escape "$(backup_source "$f")")" \
            "$(stat -c '%s' "$f")" "$(date -r "$f" '+%F %T')"
          first=0
        done <<<"$files"
        printf ']\n'
        return 0
      fi
      info "Backup list (keeps the latest ${BACKUP_KEEP}; no scheduled backup on this host)"
      printf '  %-46s %-10s %-8s %s\n' "FILE" "SIZE" "SOURCE" "MTIME"
      while read -r f; do
        [ -z "$f" ] && continue
        printf '  %-46s %-10s %-8s %s\n' "$(basename "$f")" \
          "$(human_size "$(du -k "$f" | cut -f1)")" "$(backup_source "$f")" \
          "$(date -r "$f" '+%F %T')"
      done <<<"$files"
      return 0
      ;;
    verify)
      local f="${2:-}"
      [ -n "$f" ] || { err "usage: openmaic backup verify <file>"; return "$EXIT_USAGE"; }
      [ -f "$f" ] || f="$BACKUP_DIR/$f"
      [ -f "$f" ] || { err "backup file not found"; return "$EXIT_ERR"; }
      gzip -t "$f" 2>/dev/null || { err "gzip verification failed, file is corrupt"; return "$EXIT_ERR"; }
      local tables; tables=$(gunzip -c "$f" 2>/dev/null | grep -c '^CREATE TABLE' || echo 0)
      ok "verification passed: gzip intact, ${tables} table definition(s) found"
      return 0
      ;;
    *)
      err "usage: openmaic backup [run|list|verify <file>]"; return "$EXIT_USAGE" ;;
  esac
}

cmd_restore() {
  local f="${1:-}"
  [ -n "$f" ] || { err "usage: openmaic restore <backup-file>"; return "$EXIT_USAGE"; }
  [ -f "$f" ] || f="$BACKUP_DIR/$f"
  [ -f "$f" ] || { err "backup file not found: $f"; return "$EXIT_ERR"; }
  gzip -t "$f" 2>/dev/null || { err "backup file is corrupt"; return "$EXIT_ERR"; }

  warn "this will overwrite the current database (${DB_NAME}) and cannot be undone"
  confirm "Restore the database from $(basename "$f")?" || return $?

  step "Restoring database"
  if [ "$DRY_RUN" = 1 ]; then hint "would run gunzip -c $f | psql to import into the current PG"; return 0; fi

  with_lock nowait _restore_body "$f"
}

_restore_body() {
  local f="$1"
  step "1/2 Back up current database (safety net)"
  do_backup_inner prerestore || warn "current database backup failed, continuing"
  step "2/2 Import"
  if gunzip -c "$f" | pg_psql pipe >/dev/null 2>&1; then
    ok "restore complete"
    return 0
  fi
  err "restore failed, please inspect manually"
  return "$EXIT_MANUAL"
}

cmd_db() {
  case "${1:-}" in
    shell)
      pg_psql tty ;;
    dump)
      local table=""
      [ "${2:-}" = "--table" ] && table="${3:-}"
      if [ -n "$table" ]; then pg_dump_cmd -t "$table"
      else pg_dump_cmd; fi
      ;;
    *) err "usage: openmaic db shell|dump [--table <name>]"; return "$EXIT_USAGE" ;;
  esac
}

# =============================================================================
#  Commands: config management
# =============================================================================
config_file_for() {
  case "${1:-local}" in
    env|build) echo "$APP_DIR/.env" ;;
    local|runtime) echo "$APP_DIR/.env.local" ;;
    *) echo "" ;;
  esac
}

cmd_config() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show)
      local raw=0
      [ "${1:-}" = "--raw" ] && raw=1
      if [ "$raw" = 1 ]; then
        confirm "Show the full, unmasked config (includes secrets)?" || return $?
        echo "=== .env ==="; cat "$APP_DIR/.env" 2>/dev/null
        echo; echo "=== .env.local ==="; cat "$APP_DIR/.env.local" 2>/dev/null
        return 0
      fi
      info "Build params (.env, masked)"; mask_file "$APP_DIR/.env"
      echo; info "Runtime config (.env.local, masked)"; mask_file "$APP_DIR/.env.local"
      echo; hint "full values: openmaic config show --raw"
      return 0
      ;;
    get)
      local key="${1:-}"
      [ -n "$key" ] || { err "usage: openmaic config get <key>"; return "$EXIT_USAGE"; }
      local v
      v=$(grep -hE "^${key}=" "$APP_DIR/.env" "$APP_DIR/.env.local" 2>/dev/null | tail -1 | cut -d= -f2-)
      [ -n "$v" ] && say "$v" || { err "config key not found: $key"; return "$EXIT_ERR"; }
      return 0
      ;;
    set)
      local key="${1:-}" val="${2:-}" file="local" apply=0
      shift 2 2>/dev/null || true
      while [ $# -gt 0 ]; do
        case "$1" in
          --file) file="${2:-local}"; shift 2 ;;
          --apply) apply=1; shift ;;
          *) shift ;;
        esac
      done
      [ -n "$key" ] && [ -n "$val" ] || { err "usage: openmaic config set <key> <value> [--file env|local] [--apply]"; return "$EXIT_USAGE"; }
      local f; f=$(config_file_for "$file")
      [ -n "$f" ] || { err "--file must be env or local"; return "$EXIT_USAGE"; }
      [ -f "$f" ] || { err "$f not found"; return "$EXIT_ERR"; }

      confirm "Write $key into $(basename "$f")?" || return $?
      if [ "$DRY_RUN" = 1 ]; then hint "would set $key=$val in $f"; return 0; fi

      cp -a "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
      awk -v k="$key" -v v="$val" '
        $0 ~ "^"k"=" { print k"="v; found=1; next }
        { print }
        END { if (!found) print k"="v }
      ' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
      ok "wrote $key"
      sync_config_to_persist

      if [ "$apply" = 1 ]; then
        warn "note: NEXT_PUBLIC_* are build-time params; changes only take effect after a rebuild"
        step "Rebuild and restart to apply"
        cmd_upgrade_apply_restart
        return $?
      fi
      hint "to apply: openmaic restart (runtime params) or openmaic upgrade --to $(current_tag) (build-time params)"
      return 0
      ;;
    diff)
      local ex="$APP_DIR/.env.example"
      [ -f "$ex" ] || { err ".env.example not found"; return "$EXIT_ERR"; }
      info "Diff against .env.example (lists only unset keys)"
      local key missing=0
      while IFS= read -r key; do
        grep -qE "^${key}=" "$APP_DIR/.env" "$APP_DIR/.env.local" 2>/dev/null || { say "  $key"; missing=$((missing+1)); }
      done < <(grep -oE '^[A-Z_][A-Z0-9_]*=' "$ex" | tr -d '=' | sort -u)
      [ "$missing" = 0 ] && ok "no missing keys found" || hint "$missing key(s) unset (most are optional)"
      return 0
      ;;
    save)
      sync_config_to_persist
      ok "config persisted to $CONF_DIR"
      return 0
      ;;
    *)
      err "usage: openmaic config show|get|set|diff|save"; return "$EXIT_USAGE" ;;
  esac
}

cmd_upgrade_apply_restart() {
  compose up -d --remove-orphans >/dev/null 2>&1 || { err "restart failed"; return "$EXIT_ERR"; }
  wait_health
}

cmd_models() {
  local api_key base models model
  api_key=$(grep -hE '^QWEN_API_KEY=' "$APP_DIR/.env.local" 2>/dev/null | tail -1 | cut -d= -f2-)
  base=$(grep -hE '^QWEN_BASE_URL=' "$APP_DIR/.env.local" 2>/dev/null | tail -1 | cut -d= -f2-)
  models=$(grep -hE '^QWEN_MODELS=' "$APP_DIR/.env.local" 2>/dev/null | tail -1 | cut -d= -f2-)
  [ -n "$api_key" ] || { err "QWEN_API_KEY not found in .env.local"; return "$EXIT_ERR"; }
  [ -n "$base" ] || base="https://dashscope.aliyuncs.com/compatible-mode/v1"
  [ -n "$models" ] || { err "QWEN_MODELS not found in .env.local"; return "$EXIT_ERR"; }

  info "Model connectivity probe"
  printf '  endpoint %s\n\n' "$base"
  printf '  %-28s %-8s %-10s %s\n' "MODEL" "STATUS" "LATENCY" "RESPONSE"
  echo "  ----------------------------------------------------------------------"

  local okc=0 badc=0
  local -a model_list=()
  IFS=',' read -r -a model_list <<<"$models"
  for model in "${model_list[@]+"${model_list[@]}"}"; do
    model=$(printf '%s' "$model" | xargs)
    [ -z "$model" ] && continue
    local t0 t1 ms resp code
    t0=$(date +%s%N)
    resp=$(curl -sS --max-time 30 -o /tmp/.om_resp -w '%{http_code}' \
      -X POST "$base/chat/completions" \
      -H "Authorization: Bearer $api_key" \
      -H 'Content-Type: application/json' \
      -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":16}" 2>/dev/null) || resp="000"
    t1=$(date +%s%N)
    ms=$(( (t1 - t0) / 1000000 ))
    code="$resp"
    if [ "$code" = "200" ]; then
      printf '  %-28s %s%-8s%s %-10s %s\n' "$model" "$C_GRN" "ok" "$C_RST" "${ms}ms" "OK"
      okc=$((okc+1))
    else
      local msg; msg=$(head -c 120 /tmp/.om_resp 2>/dev/null | tr -d '\n')
      printf '  %-28s %s%-8s%s %-10s %s\n' "$model" "$C_RED" "fail" "$C_RST" "-" "HTTP $code ${msg:0:60}"
      badc=$((badc+1))
    fi
  done
  rm -f /tmp/.om_resp
  echo "  ----------------------------------------------------------------------"
  printf '\n  available %s, failed %s\n' "$okc" "$badc"
  [ "$badc" -eq 0 ] || return "$EXIT_ERR"
  return 0
}

# =============================================================================
#  Commands: deploy & onboarding
# =============================================================================
cmd_install() {
  local tag="" clean=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag) tag="${2:-}"; shift 2 ;;
      --clean) clean=1; shift ;;
      *) shift ;;
    esac
  done

  require_cmd docker git curl || return $?
  step "OpenMAIC deploy"
  [ -z "$tag" ] && tag=$(latest_tag 2>/dev/null || echo "")

  if [ "$clean" = 1 ]; then
    warn "will wipe ${BASE_DIR} (config is persisted in ${CONF_DIR} and will not be lost)"
    confirm "Wipe existing deploy artifacts?" || return $?
    [ "$DRY_RUN" = 1 ] || cmd_clean_inner
  fi

  ensure_dirs

  # 1) Source
  step "1/6 Prepare source"
  if [ -z "$tag" ]; then
    err "cannot determine target version (network unreachable; specify --tag vX.Y.Z explicitly)"
    return "$EXIT_ERR"
  fi
  if [ "$DRY_RUN" = 1 ]; then
    dim "  [dry-run] would init the repo and check out $tag"
  else
    if [ ! -d "$APP_DIR/.git" ]; then
      mkdir -p "$APP_DIR"
      ( cd "$APP_DIR" && git init -q && git remote add origin "https://github.com/$REPO.git" ) \
        || { err "repo init failed"; return "$EXIT_ERR"; }
    fi
    git_fetch_tag "$tag" >/dev/null 2>&1 \
      || { err "source fetch failed (all channels unavailable)"; \
           [ -n "$PROXY_URL" ] && hint "a proxy is configured (${PROXY_DISPLAY}); confirm it is reachable" \
             || hint "if the deploy host cannot reach GitHub directly, set OPENMAIC_PROXY_URL=<url> and retry"; \
           return "$EXIT_ERR"; }
    ( cd "$APP_DIR" && git checkout --force "$tag" >/dev/null 2>&1 ) \
      || { err "checkout of $tag failed"; return "$EXIT_ERR"; }
    echo "$tag" >"$C_TAG"
    ok "source ready: $tag"
  fi

  # 2) Config
  step "2/6 Deploy config"
  restore_config_from_persist
  if [ ! -f "$APP_DIR/.env" ] || [ ! -f "$APP_DIR/.env.local" ]; then
    warn "config files missing; place env.build / env.runtime in $CONF_DIR and rerun"
    hint "or create $APP_DIR/.env and .env.local by hand, referencing $APP_DIR/.env.example"
    [ "$SHARED_PG" = 1 ] && hint "(shared PG mode is on: DATABASE_URL is overridden by the override file; .env.local only needs PERSISTENCE_DEV_TOKEN/API Key/ACCESS_CODE, etc.)"
    return "$EXIT_PRECHECK"
  fi
  chmod 600 "$APP_DIR/.env" "$APP_DIR/.env.local" 2>/dev/null || true
  ok "config ready"

  # 3) Patches
  step "3/6 Apply local patches"
  apply_local_patches || return "$EXIT_ERR"

  # 4) Build
  step "4/6 Build images (render ceiling $((BUILD_TIMEOUT_RENDER/60)) min, main ceiling $((BUILD_TIMEOUT_MAIN/60)) min)"
  run_logged "install-build-render" compose_timed "$BUILD_TIMEOUT_RENDER" build render-service || return "$EXIT_ERR"
  run_logged "install-build-main" compose_timed "$BUILD_TIMEOUT_MAIN" build openmaic || return "$EXIT_ERR"

  # 5) Start
  step "5/6 Start containers"
  if [ "$SHARED_PG" = 1 ]; then
    ensure_shared_db || return "$EXIT_PRECHECK"
  fi
  if [ "$DRY_RUN" = 1 ]; then hint "would run docker compose up -d --remove-orphans"; return 0; fi
  compose up -d --remove-orphans || { err "startup failed"; return "$EXIT_ERR"; }

  # 6) Verify
  step "6/6 Health check"
  if wait_health; then
    sync_config_to_persist
    ok "deploy complete → http://$(hostname -I | awk '{print $1}'):3000"
    return 0
  fi
  err "deploy complete but the health check did not pass; see openmaic logs"
  return "$EXIT_NOT_READY"
}

cmd_clean_inner() {
  step "Cleaning deploy artifacts"
  hint "kept: ${CONF_DIR} (config), BuildKit cache (speeds up rebuilds)"
  # shellcheck disable=SC2046
  ( cd "$APP_DIR" 2>/dev/null && docker compose $(compose_profiles) down --volumes --remove-orphans ) >/dev/null 2>&1 || true
  docker rm -f app-openmaic-1 app-postgres-1 app-render-service-1 >/dev/null 2>&1 || true
  docker volume rm app_openmaic-data app_openmaic-postgres >/dev/null 2>&1 || true
  docker rmi -f app-openmaic:latest app-render-service:latest >/dev/null 2>&1 || true
  rm -rf "${BASE_DIR:?}/app" "$BACKUP_DIR" "$LOG_DIR" "$STATE_DIR" "$RUN_DIR" 2>/dev/null || true
  ok "cleaned (config and build cache kept)"
  return 0
}

cmd_clean() {
  warn "this will delete: containers, data volumes, project images, and everything under $BASE_DIR"
  warn "kept: $CONF_DIR config, system images, BuildKit cache"
  confirm "Run cleanup?" || return $?
  if [ "$DRY_RUN" = 1 ]; then hint "would run cmd_clean_inner"; return 0; fi
  with_lock nowait cmd_clean_inner
}

cmd_shell() { compose exec "$SERVICE_APP" sh; }

cmd_url() {
  local ip; ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  if [ -z "$ip" ]; then
    # hostname -I is Linux-specific; if it returns nothing, fall back to the host part of the health URL to avoid printing http://:3000
    ip=$(printf '%s' "$HEALTH_URL" | sed -E 's#^https?://([^/:]+).*#\1#')
    [ -n "$ip" ] || ip="127.0.0.1"
    hint "could not detect this host's external IP (hostname -I unavailable); using ${ip} below"
  fi
  say "http://${ip}:3000"
  hint "access password: openmaic config get ACCESS_CODE"
  return 0
}

cmd_completion() {
  case "${1:-bash}" in
    bash)
      cat <<'EOF'
_openmaic() {
  local cur prev cmds
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmds="status health doctor powerlog version up down restart logs render upgrade rollback backup restore db config models install clean shell url completion help"
  case "$prev" in
    render) COMPREPLY=( $(compgen -W "on off" -- "$cur") ); return ;;
    backup) COMPREPLY=( $(compgen -W "run list verify" -- "$cur") ); return ;;
    db)     COMPREPLY=( $(compgen -W "shell dump" -- "$cur") ); return ;;
    config) COMPREPLY=( $(compgen -W "show get set diff save" -- "$cur") ); return ;;
    completion) COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ); return ;;
  esac
  COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
}
complete -F _openmaic openmaic
EOF
      ;;
    zsh)
      cat <<'EOF'
#compdef openmaic
_openmaic() {
  local -a cmds
  cmds=(status health doctor powerlog version up down restart logs render
        upgrade rollback backup restore db config models install clean shell url completion help)
  _describe 'command' cmds
}
compdef _openmaic openmaic
EOF
      ;;
    *) err "usage: openmaic completion bash|zsh"; return "$EXIT_USAGE" ;;
  esac
}

# =============================================================================
#  Help & dispatch
# =============================================================================
usage() {
  cat <<'EOF'
openmaic — OpenMAIC unified ops CLI

Usage: openmaic <command> [subcommand] [options]

Diagnostics & self-check
  status                     overview: version / health / containers / resources
  health [--wait SECONDS]    health check (exit code is probe-friendly)
  doctor                     environment self-check (DNS / network / disk / patches / ports)
  powerlog [N] [--last]      boot records and unclean power-loss detection
  version [--check]          version info / check for an upstream release

Service lifecycle
  up [--no-render]           start containers
  down                       stop containers
  restart [SERVICE]          restart (default: openmaic)
  logs [SERVICE] [-f] [-n N]  view logs
  render on|off              start/stop the render container (frees ~8G memory)

Upgrade & rollback
  upgrade [--check]          upgrade (backup -> fetch -> build -> switch -> health check)
          [--dry-run] [--to TAG]
  rollback [--dry-run]       roll back to the previous version
  upgrade log [-n N]         upgrade history

Data & backup
  backup                     back up the database now (no scheduled backup on this host)
  backup list                list backups (with source: manual / pre-upgrade / pre-restore)
  backup verify <FILE>       verify backup integrity
  restore <FILE>             restore the database from a backup
  db shell                   drop into psql
  db dump [--table NAME]     dump SQL

Config management
  config show [--raw]        show config (masked)
  config get <KEY>           read a config key
  config set <KEY> <VALUE>   set a config key (optional: --file env|local --apply)
  config diff                diff against .env.example
  config save                persist config to /etc/openmaic
  models                     list models and probe connectivity

Deploy & onboarding
  install [--tag TAG]        deploy from scratch / reinstall (--clean wipes first)
  clean                      clean deploy artifacts (keeps config and build cache)
  shell                      enter the app container
  url                        print the access URL
  completion bash|zsh        print a completion script

Global options
  --json          machine-readable output   --quiet, -q    only print errors
  --yes, -y       skip interactive prompts   --dry-run      print only, do not run
  --no-color      disable color              --timeout SEC  override the health-check timeout
  -h, --help      help                       -V, --version  show the CLI version

Exit codes
  0 success   1 runtime error   2 usage error   3 missing dependency   4 pre-check failed
  10 upgrade failed, rolled back   20 needs manual intervention   30 service not ready
  40 concurrency conflict   50 cancelled by user
EOF
}

parse_global() {
  local -a rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)      JSON_MODE=1; shift ;;
      --quiet|-q)  QUIET=1; shift ;;
      --yes|-y)    ASSUME_YES=1; shift ;;
      --dry-run)   DRY_RUN=1; shift ;;
      --no-color)  NO_COLOR=1; C_BOLD=''; C_RED=''; C_GRN=''; C_YEL=''; C_BLU=''; C_DIM=''; C_RST=''; shift ;;
      --timeout)   HEALTH_TIMEOUT="${2:-300}"; shift 2 ;;
      -h|--help)   usage; exit "$EXIT_OK" ;;
      -V|--version) say "openmaic CLI $OPENMAIC_CLI_VERSION"; exit "$EXIT_OK" ;;
      *)           rest+=("$1"); shift ;;
    esac
  done
  GLOBAL_REST=("${rest[@]+"${rest[@]}"}")
}

main() {
  parse_global "$@"
  local -a args=("${GLOBAL_REST[@]+"${GLOBAL_REST[@]}"}")
  local cmd="${args[0]:-help}"
  local -a sub=()
  [ "${#args[@]}" -gt 1 ] && sub=("${args[@]:1}")

  # On non-Linux hosts, intercept commands that need a deploy host and give a clear message
  # rather than dumping a pile of docker errors.
  local _c
  for _c in $NEEDS_HOST_CMDS; do
    if [ "$cmd" = "$_c" ]; then
      require_docker "$cmd" || exit $?
      break
    fi
  done

  case "$cmd" in
    status)     cmd_status ;;
    health)     cmd_health "${sub[@]+"${sub[@]}"}" ;;
    doctor)     cmd_doctor "${sub[@]+"${sub[@]}"}" ;;
    powerlog)   cmd_powerlog "${sub[@]+"${sub[@]}"}" ;;
    version)    cmd_version "${sub[@]+"${sub[@]}"}" ;;

    up)         cmd_up "${sub[@]+"${sub[@]}"}" ;;
    down)       cmd_down ;;
    restart)    cmd_restart "${sub[@]+"${sub[@]}"}" ;;
    logs)       cmd_logs "${sub[@]+"${sub[@]}"}" ;;
    render)     cmd_render "${sub[@]+"${sub[@]}"}" ;;

    upgrade)
      if [ "${sub[0]:-}" = "log" ]; then cmd_upgrade_log "${sub[@]+"${sub[@]}"}"
      else cmd_upgrade "${sub[@]+"${sub[@]}"}"; fi
      ;;
    rollback)   cmd_rollback "${sub[@]+"${sub[@]}"}" ;;

    backup)
      # list / verify are read-only and cross-platform; run needs a deploy host (and must be
      # intercepted before with_lock, otherwise it would hit a vaguer "$RUN_DIR cannot be
      # created" error first)
      if [ "${sub[0]:-}" = "list" ] || [ "${sub[0]:-}" = "verify" ]; then
        cmd_backup "${sub[@]+"${sub[@]}"}"
      else
        require_docker backup || exit $?
        cmd_backup run "${sub[@]+"${sub[@]}"}"
      fi
      ;;
    restore)    cmd_restore "${sub[@]+"${sub[@]}"}" ;;
    db)         cmd_db "${sub[@]+"${sub[@]}"}" ;;

    config)     cmd_config "${sub[@]+"${sub[@]}"}" ;;
    models)     cmd_models ;;

    install)    cmd_install "${sub[@]+"${sub[@]}"}" ;;
    clean)      cmd_clean ;;
    shell)      cmd_shell ;;
    url)        cmd_url ;;
    completion) cmd_completion "${sub[@]+"${sub[@]}"}" ;;

    help|-h|--help|"") usage ;;
    *) err "unknown command: $cmd"; echo; usage; exit "$EXIT_USAGE" ;;
  esac
  exit $?
}

main "$@"
