${C_BOLD}Artifacts${C_RESET}
  $WM_DIR/docker-compose.yml   7 local modifications (see the file header comment)
  $WM_DIR/Caddyfile            :25 layer4 block removed (host exim4 occupies it)
  $WM_DIR/.env                 version pinned + random DB password + ghcr mirror (chmod 600)
  $WM_DIR/CREDENTIALS.txt      admin and DB credentials (chmod 600)
HELP
}

