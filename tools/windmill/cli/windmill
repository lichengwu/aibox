cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    ""|main)     help_main ;;
    init)        help_init ;;
    deploy)      help_deploy ;;
    destroy)     help_destroy ;;
    up)          help_up ;;
    down)        help_down ;;
    upgrade)     help_upgrade ;;
    rollback)    help_rollback ;;
    backup)      help_backup ;;
    drill)       help_drill ;;
