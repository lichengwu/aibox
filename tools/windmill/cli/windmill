EOF
      ;;
    *) die "Unknown launchd label: $label" ;;
  esac
}

# macOS launchd scheduled tasks (mirror systemd timers). User-level LaunchAgent; no root needed.
cmd_launchd() {
  local action="${1:-status}"
  local agents_dir="$HOME/Library/LaunchAgents"
  local uid; uid="$(id -u)"
  local backup_label="com.windmill.backup"
  local check_label="com.windmill.update-check"
  case "$action" in
    install)
      require_ready
      mkdir -p "$agents_dir" "$LOG_DIR"
      gen_launchd_plist "$backup_label" > "$agents_dir/${backup_label}.plist"
      gen_launchd_plist "$check_label" > "$agents_dir/${check_label}.plist"
      chmod 0644 "$agents_dir"/com.windmill.*.plist
      launchctl bootout "gui/${uid}/${backup_label}" 2>/dev/null || true
      launchctl bootout "gui/${uid}/${check_label}" 2>/dev/null || true
      launchctl bootstrap "gui/${uid}" "$agents_dir/${backup_label}.plist" 2>/dev/null \
        || launchctl load "$agents_dir/${backup_label}.plist" 2>/dev/null || warn "backup timer load failed"
      launchctl bootstrap "gui/${uid}" "$agents_dir/${check_label}.plist" 2>/dev/null \
        || launchctl load "$agents_dir/${check_label}.plist" 2>/dev/null || warn "update-check timer load failed"
      hr; ok "launchd scheduled tasks installed"; hr
      log "  backup       daily 03:30  (${backup_label})"
      log "  update-check Mon 09:00 (${check_label})"
      log "  Logs: $LOG_DIR/{backup,update-check}.{log,err.log}"
      log "  Trigger manually: launchctl kickstart -k gui/${uid}/${backup_label}"
      hr
      ;;
    uninstall)
      launchctl bootout "gui/${uid}/${backup_label}" 2>/dev/null || launchctl unload "$agents_dir/${backup_label}.plist" 2>/dev/null || true
      launchctl bootout "gui/${uid}/${check_label}" 2>/dev/null || launchctl unload "$agents_dir/${check_label}.plist" 2>/dev/null || true
      rm -f "$agents_dir/${backup_label}.plist" "$agents_dir/${check_label}.plist"
      ok "launchd scheduled tasks uninstalled"
      ;;
    status)
      if [ ! -f "$agents_dir/${backup_label}.plist" ]; then
        warn "launchd scheduled tasks not installed. Run: $CLI_NAME systemd install"
        exit 3
      fi
      hr; log "${C_BOLD}launchd scheduled tasks${C_RESET}"; hr
      local lbl
      for lbl in "$backup_label" "$check_label"; do
        local state; state="$(launchctl print "gui/${uid}/${lbl}" 2>/dev/null | grep -E '^\s*state\s*=' | head -1 | sed 's/.*= //')"
        printf '  %-30s %s\n' "$lbl" "${state:-not loaded}"
      done
      hr
      log "${C_DIM}Logs: $LOG_DIR/{backup,update-check}.{log,err.log}${C_RESET}"
      log "${C_DIM}Trigger manually: launchctl kickstart -k gui/${uid}/${backup_label}${C_RESET}"
      hr
      ;;
    *) usage_die "systemd: unknown action ${action} (install|status|uninstall)" ;;
  esac
}

cmd_systemd() {
  local action="${1:-status}"
  case "$action" in -h|--help) help_systemd; exit 0 ;; esac
  wm_paths
  # macOS uses launchd (LaunchAgent), a different unit system from systemd; goes via cmd_launchd
  if [ "$OS_KIND" = "Darwin" ]; then
    cmd_launchd "$action"
    return $?
  fi
  if ! systemd_ok; then die "systemctl not found (systemd unavailable)"; fi
  local dst=/etc/systemd/system

  case "$action" in
    install)
      require_ready
      [ "$(id -u)" = 0 ] || die "root required"
      mkdir -p "$LOG_DIR"
      for u in "${SYSTEMD_UNITS[@]}"; do
        systemd_unit "$u" > "$dst/$u" || die "Generating $u failed"
        chmod 0644 "$dst/$u"
        info "  Installed $dst/$u"
      done
      systemctl daemon-reload
      crun systemctl enable --now windmill-backup.timer windmill-update-check.timer || warn "Enabling timers failed"
      crun systemctl enable windmill-stack.service >/dev/null 2>&1 || true
      crun systemctl start windmill-stack.service >/dev/null 2>&1 || warn "Stack alignment service returned non-zero; see $CLI_NAME logs systemd"
      hr
      ok "systemd units installed"
      systemctl --no-pager list-timers 'windmill-*' 2>/dev/null | head -5 | sed 's/^/  /' || true
      log "  Stack boot alignment: $(systemctl is-enabled windmill-stack.service 2>/dev/null)/$(systemctl is-active windmill-stack.service 2>/dev/null)"
      log "  Logs: journalctl -u 'windmill-*' or $CLI_NAME logs systemd"
      hr
      ;;
    uninstall)
      require_ready
      [ "$(id -u)" = 0 ] || die "root required"
      for u in "${SYSTEMD_UNITS[@]}"; do
        if [ -f "$dst/$u" ]; then
          crun systemctl disable --now "$u" >/dev/null 2>&1 || true
          crun rm -f "$dst/$u"
          info "  Removed $u"
        fi
      done
      crun systemctl daemon-reload >/dev/null 2>&1 || true
      crun systemctl reset-failed 'windmill-*' >/dev/null 2>&1 || true
      ok "systemd units uninstalled"
      ;;
    status)
      if [ ! -f "$dst/windmill-backup.timer" ]; then
        warn "systemd units not installed. Run: $CLI_NAME systemd install"
        exit 3
      fi
      hr; log "${C_BOLD}Scheduled tasks${C_RESET}"; hr
      systemctl --no-pager list-timers 'windmill-*' 2>/dev/null | sed 's/^/  /' || true
      hr
      log "${C_BOLD}Service status${C_RESET}"
      for s in windmill-stack.service windmill-backup.service windmill-update-check.service; do
        printf '  %-34s enabled=%s active=%s\n' "$s" \
          "$(systemctl is-enabled "$s" 2>/dev/null || echo -)" "$(systemctl is-active "$s" 2>/dev/null || echo -)"
      done
      hr
      log "${C_DIM}Logs: $CLI_NAME logs systemd${C_RESET}"
      hr
      ;;
    *) usage_die "systemd: unknown action ${action} (install|status|uninstall)" ;;
  esac
}

