help_upgrade() {
  cat <<HELP
${C_BOLD}${CLI_NAME} upgrade${C_RESET} — lossless upgrade

${C_BOLD}Usage${C_RESET}
  ${CLI_NAME} upgrade              # upgrade to the upstream latest release
  ${CLI_NAME} upgrade 1.812.0      # upgrade to a specific version
  ${CLI_NAME} upgrade --check      # check only, no upgrade

${C_BOLD}Options${C_RESET}
  --ghcr-mirror URL  Temporarily set the ghcr registry mirror (defaults to WM_GHCR_MIRROR in .env)
  --hub-mirror URL   Temporarily set the docker.io registry mirror (same as above)

${C_BOLD}Flow${C_RESET}
  Pre-flight check -> full snapshot -> pin the old image as a rollback-<version> tag -> drain workers
  -> switch version and pull -> staged startup -> health check -> auto-rollback on failure

${C_BOLD}On the bounds of "lossless"${C_RESET}
  Achievable: no data loss, in-flight tasks not interrupted, auto-rollback on failure.
  Not achievable: zero UI interruption — server rebuild + migration run causes 20-60s of 502.
  True zero-interruption needs two load-balanced servers; overkill for home use.

${C_BOLD}Important${C_RESET}
  Windmill's DB migrations are one-way and irreversible; there is no down migration.
  So rollback != swap back to the old image; rollback = swap back to the old image + restore the DB snapshot.
HELP
}

help_rollback() {
  cat <<HELP
${C_BOLD}${CLI_NAME} rollback${C_RESET} — rollback

${C_BOLD}Usage${C_RESET}
  ${CLI_NAME} rollback                     # roll back to the version recorded in the latest snapshot
  ${CLI_NAME} rollback 1.809.0             # specific version (uses the latest snapshot)
  ${CLI_NAME} rollback 1.809.0 20260914-174209   # specific version + specific snapshot
  ${CLI_NAME} rollback --list              # list available snapshots
  ${CLI_NAME} rollback --images-only       # roll back the image only; do not touch the DB

${C_BOLD}Note${C_RESET}
  The default behavior is destructive: it deletes the db data volume and rebuilds it from the snapshot.
  This is required — migrations are one-way and irreversible, so swapping the image alone cannot go back.
  Snapshot integrity is verified before execution and a yes confirmation is required.
HELP
}

