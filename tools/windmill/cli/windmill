# =============================================================================
# Command dispatch
# =============================================================================
CLI_SET_DIR=0; CLI_SET_PORT=0; CLI_SET_PROXY=0; CLI_SET_MIRROR=0; CLI_SET_HUB=0

main() {
  # --- Global options -------------------------------------------------------
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--dir)    WM_DIR="${2:-}"; CLI_SET_DIR=1; shift 2 ;;
      --port)      HTTP_PORT="${2:-}"; CLI_SET_PORT=1; shift 2 ;;
      --proxy)     PROXY_URL="${2:-}"; CLI_SET_PROXY=1; shift 2 ;;
      --ghcr-mirror) WM_GHCR_MIRROR="${2:-}"; CLI_SET_MIRROR=1; shift 2 ;;
      --hub-mirror)  WM_HUB_MIRROR="${2:-}"; CLI_SET_HUB=1; shift 2 ;;
      -y|--yes)    ASSUME_YES=1; shift ;;
      -q|--quiet)  QUIET=1; shift ;;
      --dry-run)   DRY_RUN=1; shift ;;
      -h|--help)   help_main; exit 0 ;;
      -V|--version) printf '%s %s\n' "$CLI_NAME" "$WINDMILL_CLI_VERSION"; exit 0 ;;
      --)          shift; break ;;
      -*)          usage_die "unknown global option: $1" ;;
      *)           break ;;
    esac
  done

  wm_paths
  # Inherit from .env (when not explicitly set on the command line)
  if [ -f "$ENV_FILE" ]; then
    if [ "$CLI_SET_PORT" = 0 ]; then
      local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"
    fi
    if [ "$CLI_SET_PROXY" = 0 ]; then
      local px; px=$(get_env WM_PROXY); PROXY_URL="${px:-$PROXY_URL}"
    fi
    if [ "$CLI_SET_MIRROR" = 0 ]; then
      local mm; mm=$(get_env WM_GHCR_MIRROR); WM_GHCR_MIRROR="${mm:-$WM_GHCR_MIRROR}"
    fi
    if [ "$CLI_SET_HUB" = 0 ]; then
      local hm; hm=$(get_env WM_HUB_MIRROR); WM_HUB_MIRROR="${hm:-$WM_HUB_MIRROR}"
    fi
  fi

  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  # Allow **global switches** to appear after the subcommand (-y/--yes, -q/--quiet, --dry-run).
  # Background: the systemd units generated by this CLI put the options after the
  # subcommand, e.g.
  #   ExecStart=... windmill up --quiet
  #   ExecStart=... windmill backup --daily --quiet --yes
  #   ExecStart=... windmill check --quiet
  # But the global-option scan only happens **before** the subcommand, so these calls
  # would hit "unknown argument" and mark the unit failed (measured: windmill-stack.service
  # would not come up; the backup command stalled on --yes).
  # Here, before dispatch, we strip any global switches appearing anywhere, so both
  # forms work.
  if [ $# -gt 0 ]; then
    local _kept=() _a
    for _a in "$@"; do
      case "$_a" in
        -q|--quiet)  QUIET=1 ;;
        -y|--yes)    ASSUME_YES=1 ;;
        --dry-run)   DRY_RUN=1 ;;
        *)           _kept+=("$_a") ;;
      esac
    done
    set -- "${_kept[@]+"${_kept[@]}"}"
  fi

  case "$cmd" in
    init)        cmd_init "$@" ;;
    deploy)      cmd_deploy "$@" ;;
    destroy)     cmd_destroy "$@" ;;
    up)          cmd_up "$@" ;;
    down)        cmd_down "$@" ;;
    status|st)   cmd_status "$@" ;;
    doctor|dr)   cmd_doctor "$@" ;;
    check)       cmd_check "$@" ;;
    upgrade)     cmd_upgrade "$@" ;;
    rollback|rb) cmd_rollback "$@" ;;
    backup|bk)   cmd_backup "$@" ;;
    snapshots)   cmd_snapshots "$@" ;;
    restore)     cmd_restore "$@" ;;
    drill)       cmd_drill "$@" ;;
    logs|log)    cmd_logs "$@" ;;
    shell|sh)    cmd_shell "$@" ;;
    exec)        cmd_exec "$@" ;;
    psql)        cmd_psql "$@" ;;
    credentials|cred) cmd_credentials "$@" ;;
    migrate-to-shared-pg|migrate) cmd_migrate_to_shared_pg "$@" ;;
    systemd)     cmd_systemd "$@" ;;
    version|ver) cmd_version "$@" ;;
    help)        cmd_help "$@" ;;
    *)           usage_die "unknown command: $cmd" ;;
  esac
}

main "$@"
