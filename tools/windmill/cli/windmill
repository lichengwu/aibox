  local label="$1"
  case "$label" in
    com.windmill.backup)
      cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.windmill.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>${CLI_BIN}</string><string>--quiet</string><string>--yes</string>
    <string>backup</string><string>--daily</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WM_DIR</key><string>${WM_DIR}</string>
    <key>WM_CONF_FILE</key><string>${WM_CONF_FILE}</string>
    <key>HOME</key><string>${HOME}</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
