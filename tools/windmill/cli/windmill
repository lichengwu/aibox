#!/usr/bin/env bash
# =============================================================================
# windmill — Windmill self-hosted ops CLI
#
# Single-file, self-contained: all config templates are embedded and do not
# depend on any file inside the deploy directory. So after `windmill destroy`
# removes the deploy directory, the CLI itself remains intact and can rebuild
# immediately with `windmill init`.
#
# Deploy root (aibox convention, see docs/module-spec.md): $AIBOX_HOME/apps/windmill
#   Resolution chain: WM_DIR env var → AIBOX_APPS_ROOT/<name> → $AIBOX_HOME/apps/<name>
#   (AIBOX_HOME defaults to $HOME/.aibox; if HOME is also empty, fail-closed exit)
# Config location: /etc/windmill/windmill.conf (seeded by install.sh, read-only for the CLI)
#
# Install: install -m 0755 windmill /usr/local/bin/windmill
# Docs: windmill help
# =============================================================================
set -Eeuo pipefail

CLI_NAME="windmill"
WINDMILL_CLI_VERSION="1.1.0"
CLI_UPDATED="2026-09-15"
# Absolute path of this script (written into the systemd unit ExecStart; resolved when $0 is relative)
CLI_BIN="$0"
case "$CLI_BIN" in /*) ;; *) CLI_BIN="$(pwd)/$CLI_BIN" ;; esac

# --- Deploy root resolution (takes precedence over built-in defaults; both env vars can override) ---
WM_DIR="${WM_DIR:-}"
if [ -z "$WM_DIR" ]; then
  _wm_apps_root="${AIBOX_APPS_ROOT:-}"
  if [ -z "$_wm_apps_root" ]; then
    # Note it is ${AIBOX_HOME:-$HOME/.aibox}, NOT ${AIBOX_HOME:-$HOME} —
    # the latter would drop the .aibox segment and resolve to $HOME/apps/windmill.
    _wm_apps_base="${AIBOX_HOME:-${HOME:+$HOME/.aibox}}"
    if [ -z "$_wm_apps_base" ]; then
      printf '[windmill] cannot determine deploy root: HOME and AIBOX_HOME are both empty\n' >&2
      printf '[windmill] please specify explicitly, e.g.: WM_DIR=/root/.aibox/apps/windmill windmill status\n' >&2
      exit 3
    fi
    _wm_apps_root="$_wm_apps_base/apps"
  fi
  WM_DIR="$_wm_apps_root/windmill"
fi
unset _wm_apps_root _wm_apps_base 2>/dev/null || true

# --- Host-level config (/etc/windmill/windmill.conf, seeded by install.sh; additive, never overwrites) ----
# Precedence: CLI args > env vars > .env (deploy instance) > conf (host-level) > built-in defaults
WM_CONF_FILE="${WM_CONF_FILE:-/etc/windmill/windmill.conf}"
wm_conf_load() {
  [ -r "$WM_CONF_FILE" ] || return 0
  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      ''|'#'*) continue ;;
      PROXY_URL)      : "${PROXY_URL:=$v}" ;;
      WM_GHCR_MIRROR) : "${WM_GHCR_MIRROR:=$v}" ;;
      WM_HUB_MIRROR)  : "${WM_HUB_MIRROR:=$v}" ;;
      HTTP_PORT)
        case "$v" in ''|*[!0-9]*) ;; *) : "${HTTP_PORT:=$v}" ;; esac
        ;;
      *) ;; # unknown keys ignored (conf holds a whitelist only; credentials belong to the deploy instance in .env)
    esac
  done < "$WM_CONF_FILE"
}
wm_conf_load

# --- Defaults ----------------------------------------------------------------
HTTP_PORT="${HTTP_PORT:-80}"
MIN_FREE_GB="${MIN_FREE_GB:-12}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-180}"
# Egress proxy: no built-in address anymore. Source chain = --proxy arg > PROXY_URL env var
# (with HTTPS_PROXY/HTTP_PROXY fallback, where the aibox global proxy is injected) > conf > .env WM_PROXY.
PROXY_URL="${PROXY_URL:-${HTTPS_PROXY:-${HTTP_PROXY:-}}}"
WM_REPO="ghcr.io/windmill-labs/windmill"
WM_EXTRA_REPO="ghcr.io/windmill-labs/windmill-extra"
PG_IMAGE="postgres:18"
CADDY_IMAGE="ghcr.io/windmill-labs/caddy-l4:2.11.4-1"
# Shared base PG: compose sets the db service to replicas:0, and DATABASE_URL points to the base PG.
# DB operations use a fixed container name + business user aibox (standalone mode uses the compose db / postgres).
# Profile-aware (aibox --profile <name>): named profiles use aibox-base-<name>-postgres and the
# matching network; default profile "base" keeps the unsuffixed names. Standalone → base.
_AIBOX_PROF="${AIBOX_PROFILE:-base}"
_BASE_SUFFIX=""
[ "$_AIBOX_PROF" != "base" ] && _BASE_SUFFIX="-${_AIBOX_PROF}"
SHARED_PG_CONTAINER="aibox-base${_BASE_SUFFIX}-postgres"
# Exported so docker compose interpolates ${AIBOX_BASE_NETWORK} in the generated compose
# (the quoted heredoc writes it literally; compose resolves it from this process env at up-time).
export AIBOX_BASE_NETWORK="aibox-base${_BASE_SUFFIX}"
SHARED_PG_USER="aibox"
# ghcr registry mirror (acceleration in China). Empty = direct ghcr.io.
# Direct connection measures ~0.5 MB/s, while windmill-extra alone is 1.99 GiB compressed,
# so a fresh pull takes ~1 hour; switching to ghcr.nju.edu.cn measures ~62 MB/s.
# Usage: windmill --ghcr-mirror https://ghcr.nju.edu.cn init
# or set WM_GHCR_MIRROR in .env, after which upgrade/up reuse it automatically.
WM_GHCR_MIRROR="${WM_GHCR_MIRROR:-}"
# docker.io registry mirror (the repo postgres uses). **Note**: this is a separate mechanism from
# the daemon's registry-mirrors — if the latter contains black-hole entries, `docker pull`
# hangs silently; this CLI takes over pulling itself, so it is unaffected.
# Example: WM_HUB_MIRROR=https://docker.1ms.run
WM_HUB_MIRROR="${WM_HUB_MIRROR:-}"
# Pull stall threshold (seconds): if /var/lib/docker shows zero size growth for this long,
# the pull is deemed hung and is killed. Stall detection is used instead of a fixed timeout;
# see the _run_pull comment for the rationale.
PULL_STALL_S="${PULL_STALL_S:-90}"
# Hard total cap for a single docker pull (seconds). Pure fallback; normally the stall check exits first.
PULL_TIMEOUT="${PULL_TIMEOUT:-3600}"
# Per-image pull retry count. Chinese mirrors often "reset the connection halfway through";
# docker caches completed layers by digest, so a retry resumes rather than restarts, usually
# completing on the 2nd attempt.
WM_PULL_RETRY="${WM_PULL_RETRY:-3}"
# Per-stage retry count for staged startup. When docker creates sibling containers sharing the
# same named volume, there is a volume init race that returns 500 file exists (see compose_up_stage comment).
WM_UP_RETRY="${WM_UP_RETRY:-3}"
DRILL_CT="wm-restore-drill"
DRILL_VOL="wm_restore_drill_data"

# --- Runtime state ----------------------------------------------------------
ASSUME_YES=0
QUIET=0
DRY_RUN=0
C_ALLOW_ROTATE=0

# Make compose process containers serially.
# Background: on 2026-09-14 rebuilding 8 containers at once caused a host I/O spike and
# the VM hard-froze for 13 minutes.
export COMPOSE_PARALLEL_LIMIT="${COMPOSE_PARALLEL_LIMIT:-1}"

# --- Paths ------------------------------------------------------------------
wm_paths() {
  ENV_FILE="$WM_DIR/.env"
  COMPOSE_FILE="$WM_DIR/docker-compose.yml"
  CADDY_FILE="$WM_DIR/Caddyfile"
  VERSION_FILE="$WM_DIR/VERSION"
  BACKUP_DIR="$WM_DIR/backups"
  LOG_DIR="$WM_DIR/logs"
  LOCK_FILE="$WM_DIR/.lock"
}
ENV_FILE=""; COMPOSE_FILE=""; CADDY_FILE=""; VERSION_FILE=""
BACKUP_DIR=""; LOG_DIR=""; LOCK_FILE=""

# =============================================================================
# Output
# =============================================================================
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""
fi

# Generate a strong random password.
# Note: in `tr -dc ... < /dev/urandom | head -c N`, head exits and closes the pipe after
# reading N bytes, so tr receives SIGPIPE (exit code 141); under pipefail the whole
# pipeline returns 141 and the assignment fails. An infinite producer with a finite
# consumer inevitably raises SIGPIPE, so we guard explicitly.
gen_password() {
  local n="${1:-32}"
  LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c "$n" || true
}

ts()   { date '+%Y-%m-%d %H:%M:%S'; }
log()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
info() { [ "$QUIET" = 1 ] || printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
ok()   { printf '%s✔%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()  { printf '%s✘%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
hr()   { [ "$QUIET" = 1 ] || printf '%s\n' "────────────────────────────────────────────────────────"; }
step() { printf '%s▸ %s%s\n' "$C_BLUE" "$*" "$C_RESET"; }
die()  { err "$1"; exit "${2:-1}"; }
# Usage errors use exit code 2 uniformly
usage_die() { err "$1"; printf '  Run `%s help` for usage.\n' "$CLI_NAME" >&2; exit 2; }

# dry-run wrapper for destructive actions
crun() {
  if [ "$DRY_RUN" = 1 ]; then printf '%s[dry-run]%s %s\n' "$C_DIM" "$C_RESET" "$*"; return 0; fi
  "$@"
}

# Append to an ops log (leaves a trail under systemd; silently skips if the dir is missing)
append_log() {
  local f="$LOG_DIR/$1"; shift
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  printf '[%s] %s\n' "$(ts)" "$*" >> "$f" 2>/dev/null || true
}

# =============================================================================
# Prerequisites
# =============================================================================
require_root() {
  [ "$(id -u)" = "0" ] || die "root privileges required (read/write $WM_DIR and Docker). Run with sudo." 3
}
require_docker() {
  command -v docker >/dev/null 2>&1 || die "docker command not found." 3
  docker info >/dev/null 2>&1 || die "docker daemon is not running or not accessible." 3
  docker compose version >/dev/null 2>&1 || die "docker compose plugin (v2) is missing." 3
}
# Unified entry-point check for anything other than read-only commands
require_ready() { require_root; require_docker; }

# =============================================================================
# compose wrapper
# =============================================================================
_has_env_file() { [ -f "$ENV_FILE" ]; }
_compose() {
  if _has_env_file; then
    docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  else
    docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" "$@"
  fi
}
compose() { _compose "$@"; }
# stdin must be redirected: exec inherits the caller's stdin, which under a pipe/heredoc
# would consume the rest of the script.
dexec() { _compose exec -T "$@" < /dev/null; }

# =============================================================================
# Platform abstraction layer (Linux is the main impl; macOS best-effort)
# Linux paths match the original impl exactly; the macOS branch currently covers
# lock/port/IP/memory/backup evacuation.
# =============================================================================
OS_KIND="$(uname -s 2>/dev/null || echo unknown)"

# Get this host's primary IP (used to set base_url / hint at the entry point)
# Linux: hostname -I;macOS: ipconfig getifaddr en0
primary_ip() {
  local ip=""
  case "$OS_KIND" in
    Darwin)
      ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true) ;;
    *)
      ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true) ;;
  esac
  printf '%s' "$ip"
}

# Whether a TCP port is listening (ss -> lsof -> netstat, three-level fallback)
port_listening() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | grep -q LISTEN
  else
    netstat -an 2>/dev/null | grep -E "[:.]${port}[[:space:]]" | grep -qi listen
  fi
}

# Memory overview (shown by status; returns a placeholder if it cannot be read)
mem_used_h() {
  case "$OS_KIND" in
    Darwin)
      vm_stat 2>/dev/null | awk '
        /Pages free/ {free=$3} /Pages active/ {a=$3} /Pages inactive/ {i=$3}
        END {gsub(/\./,"",free); gsub(/\./,"",a); gsub(/\./,"",i);
             ps=16384; printf "%.1fG used (active)", a*ps/1073741824}' ;;
    *)
      free -h 2>/dev/null | awk 'NR==2{print $3" used / "$2" total"}' ;;
  esac
}

# Backup evacuation directory (backups are moved here before destroy; a safe location
# outside the aibox deploy root)
backup_evac_dir() {
  local base="${AIBOX_HOME:-${HOME:+$HOME/.aibox}}"
  if [ -n "$base" ]; then printf '%s/backups' "$base"
  else printf '/var/backups'; fi
}

# systemd availability (macOS uses launchd, not adapted in this version)
systemd_ok() { command -v systemctl >/dev/null 2>&1; }

# =============================================================================
# .env read/write
# =============================================================================
get_env() {
  local k="$1" line=""
  [ -f "$ENV_FILE" ] || return 0
  line=$(grep -E "^${k}=" "$ENV_FILE" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then printf '%s' "${line#*=}"; fi
  return 0
}
set_env() {
  local k="$1" v="$2"
  [ -f "$ENV_FILE" ] || die ".env missing: $ENV_FILE"
  if grep -qE "^${k}=" "$ENV_FILE"; then
    # Avoid sed -i (GNU/BSD flag incompatibility); rewrite the line with awk instead.
    # Pass the value via ENVIRON so backslashes are not re-interpreted by awk -v.
    WM_SET_K="$k" WM_SET_V="$v" awk '
      BEGIN { kv = ENVIRON["WM_SET_K"] "=" }
      index($0, kv) == 1 { print ENVIRON["WM_SET_K"] "=" ENVIRON["WM_SET_V"]; next }
      { print }
    ' "$ENV_FILE" > "${ENV_FILE}.tmp.$$" && cat "${ENV_FILE}.tmp.$$" > "$ENV_FILE" && rm -f "${ENV_FILE}.tmp.$$"
  else
    printf '%s=%s\n' "$k" "$v" >> "$ENV_FILE"
  fi
}

# =============================================================================
# Versions
# =============================================================================
current_version() {
  if [ -f "$VERSION_FILE" ]; then tr -d '[:space:]' < "$VERSION_FILE"; else echo "unknown"; fi
}
write_version() { printf '%s\n' "$1" > "$VERSION_FILE"; }

# Extract "1.809.0" from "CE v1.809.0-2-gb156778da2"
parse_version() { printf '%s' "${1:-}" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1 | tr -d 'v' || true; }

# Exact version boundary: both CE v1.811.1 and CE v1.811.1-2-gbxxxx match 1.811.1,
# but v1.811.10 does not match 1.811.1
version_matches() {
  local probe="${1:-}" want="$2"
  if [ -z "$probe" ]; then return 1; fi
  case "$probe" in *"v${want}-"*) return 0 ;; esac
  if [ "${probe##* }" = "v${want}" ]; then return 0; fi
  return 1
}

proxy_env() { printf '%s' "${PROXY_URL:-}"; }

# Query the upstream latest release (api.github.com is not directly reachable from
# the target host, so a proxy is required)
latest_version() {
  local px v=""
  px=$(proxy_env)
  v=$(https_proxy="$px" http_proxy="$px" \
      curl -fsS --max-time 25 -H 'Accept: application/vnd.github+json' \
      https://api.github.com/repos/windmill-labs/windmill/releases/latest 2>/dev/null \
      | python3 -c 'import sys,json;print(json.load(sys.stdin)["tag_name"].lstrip("v"))' 2>/dev/null || true)
  printf '%s' "$v"
}

image_version() { printf '%s' "${1:-}" | sed -n 's/.*:\([0-9][0-9.]*\)$/\1/p'; }

# =============================================================================
# Disk / images
# =============================================================================
free_gb() { df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9' || true; }

require_free_space() {
  local need="${1:-$MIN_FREE_GB}" have
  have=$(free_gb); have="${have:-0}"
  if [ "$have" -lt "$need" ]; then
    die "Insufficient free disk space: need >= ${need}G, have ${have}G. Prune old images (docker image prune -a) or expand the disk."
  fi
  info "  Disk free ${have}G (threshold ${need}G)"
}

# Whether an image can be pulled (tag exists + network reachable)
require_image() {
  local img="$1"
  docker manifest inspect "$img" >/dev/null 2>&1 || die "Cannot fetch image (tag missing or network unreachable): $img"
  info "  Image available: $img"
}

# --- ghcr registry mirror ---------------------------------------------------
# Background: the host pulling ghcr.io directly measures ~0.5 MB/s, so a fresh deploy
#       has to pull ~6 GiB (windmill 3.98G + windmill-extra 1.99G + caddy-l4), and a
#       direct pull takes over an hour; whereas ghcr.nju.edu.cn on the same link
#       measures ~62 MB/s. A 100x+ difference makes it worth a configurable capability.
#
# Approach: the mirror transparently proxies the same content (digests match), so first
#       `docker pull <mirror>/<path>` then `docker tag` it as the official ghcr.io/<path>
#       reference. compose still references image: by the official name, and
#       pull_policy: missing hits the local image directly without going back to ghcr.io.
#       This way the mirror only provides "accelerated download" without polluting the
#       compose file; turning the mirror off needs no config change either.
# Normalize a mirror host: strip the scheme prefix and trailing slash.
# docker image references [must not carry an http(s):// prefix]; doing so is an
# `invalid reference format`. But people tend to type a full URL, so we strip it
# uniformly here, leaving only host/path form.
mirror_host() {
  local m="$1"
  m="${m%/}"
  m="${m#https://}"
  m="${m#http://}"
  printf '%s' "${m%/}"
}

# Reverse: the full URL for curl probing (prepend https if no scheme was given)
mirror_url() {
  local m="$1"
  case "${m:-}" in
    http://*|https://*) printf '%s' "${m%/}" ;;
    "")                 printf '%s' "" ;;
    *)                  printf 'https://%s' "${m%/}" ;;
  esac
}

ghcr_mirror_ref() {
  local img="$1" mirror
  mirror=$(mirror_host "$2")
  [ -n "$mirror" ] || { printf '%s' ""; return 0; }
  case "$img" in
    ghcr.io/*) printf '%s/%s' "$mirror" "${img#ghcr.io/}" ;;
    *)         printf '%s' "" ;;
  esac
}

# docker.io registry mirror. Docker Hub official images live under the library/
# namespace in the registry, so `postgres:18` maps to `<mirror>/library/postgres:18`.
hub_mirror_ref() {
  local img="$1" mirror
  mirror=$(mirror_host "$2")
  [ -n "$mirror" ] || { printf '%s' ""; return 0; }
  # Branch order matters: `docker.io/*` must come before the wildcard `*.*/*`,
  # otherwise it never matches.
  case "$img" in
    docker.io/*)     printf '%s/%s' "$mirror" "${img#docker.io/}" ;;
    ghcr.io/*|*.*/*) printf '%s' "" ;;      # other registries: leave untouched
    */*)             printf '%s/%s' "$mirror" "$img" ;;
    *)               printf '%s/library/%s' "$mirror" "$img" ;;
  esac
}

# Unified docker pull entry point — uses "stall detection" instead of a fixed timeout.
#
# Why not a fixed timeout: both ends are wrong.
#   - Too small: it cuts off a large image mid-download while still progressing.
#     Measured with PULL_TIMEOUT=300: the ghcr mirror pulling the 3.98GB windmill
#     image was cut off mid-way three times in a row, and then erroneously fell
#     back to direct ghcr.io (0.5MB/s) — slower than having no timeout at all.
#   - Too large: a black-hole mirror (dockerproxy.net) makes docker pull hang for
#     12+ minutes with zero throughput, dragging the whole deploy down.
#
# So instead we monitor /var/lib/docker size changes:
#   keep waiting as long as it keeps growing; only when there is zero growth for
#   PULL_STALL_S seconds do we deem it hung and cut it off.
# This separates "slow but moving" from "completely stuck" while keeping live
# progress output.
_docker_usage_mb() {
  # macOS / Docker Desktop: image layers live inside a VM, the host cannot see
  # /var/lib/docker. Return -1 to signal "no progress signal", and _run_pull falls
  # back to a total-timeout-only check.
  if [ ! -d /var/lib/docker ]; then
    printf '%s' "-1"; return 0
  fi
  local v
  v=$(du -sm /var/lib/docker 2>/dev/null | awk '{print $1}')
  printf '%s' "${v:-0}"
}

_run_pull() {
  local img="$1"
  local stall="${PULL_STALL_S:-90}" max="${PULL_TIMEOUT:-3600}"
  local pid rc=0 last idle=0 elapsed=0 now

  # Run in the background but [do not redirect output], so the user keeps seeing
  # docker's live progress.
  docker pull "$img" &
  pid=$!

  last=$(_docker_usage_mb)
  while kill -0 "$pid" 2>/dev/null; do
    sleep 10
    elapsed=$((elapsed + 10))
    now=$(_docker_usage_mb)

    if [ "$now" = "-1" ] || [ "$last" = "-1" ]; then
      : # no progress signal (Docker Desktop): skip stall detection, only the total cap applies
    elif [ "$now" -gt "$last" ]; then
      last="$now"; idle=0
    else
      idle=$((idle + 10))
    fi

    if [ "$idle" -ge "$stall" ]; then
      warn "  Pull stalled for ${idle}s (suspected black-hole mirror); aborting this attempt"
      kill -TERM "$pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 1
    fi
    if [ "$elapsed" -ge "$max" ]; then
      warn "  Pull exceeded total cap of ${max}s; aborting this attempt"
      kill -TERM "$pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 1
    fi
  done

  wait "$pid" || rc=$?
  return "$rc"
}

# Pull the official reference directly (with timeout + retries). Returns 0 if ready.
#
# Why retry: free Chinese mirrors commonly "reset the connection halfway through".
# docker caches completed layers by layer digest, so a retry **resumes** rather than
# restarts — measured with postgres:18, the first attempt downloaded ~129MB then
# got reset, and one retry completed it. Without a retry you just watch the deploy fail.
direct_pull() {
  local img="$1" tries="${WM_PULL_RETRY:-3}" i=1
  if [ "$DRY_RUN" = 1 ]; then
    printf '%s[dry-run]%s docker pull %s\n' "$C_DIM" "$C_RESET" "$img"
    return 0
  fi
  if docker image inspect "$img" >/dev/null 2>&1; then
    info "  Already local: $img"
    return 0
  fi
  while [ "$i" -le "$tries" ]; do
    if _run_pull "$img"; then
      ok "  $img"
      return 0
    fi
    if [ "$i" -lt "$tries" ]; then
      warn "  Attempt ${i}/${tries} did not finish (mirror may have reset the connection); retrying to resume…"
    fi
    i=$((i + 1))
    sleep 3
  done
  err "  Pull failed (retried ${tries} times; stall threshold ${PULL_STALL_S:-90}s, total cap ${PULL_TIMEOUT:-3600}s): $img"
  return 1
}

# Pull a single image: prefer the mirror, fall back to direct. Returns 0 if finally ready.
# $1 = ghcr|hub   $2 = mirror   $3 = official reference
mirror_pull_one() {
  local kind="$1" mirror="$2" img="$3" mref tries i=1
  case "$kind" in
    hub)  mref=$(hub_mirror_ref  "$img" "$mirror") ;;
    *)    mref=$(ghcr_mirror_ref "$img" "$mirror") ;;
  esac

  if [ "$DRY_RUN" = 1 ]; then
    printf '%s[dry-run]%s docker pull %s\n' "$C_DIM" "$C_RESET" "${mref:-$img}"
    return 0
  fi

  if docker image inspect "$img" >/dev/null 2>&1; then
    info "  Already local: $img"
    return 0
  fi

  if [ -n "$mref" ]; then
    log "  Pulling via mirror: $mref"
    tries="${WM_PULL_RETRY:-3}"
    while [ "$i" -le "$tries" ]; do
      if _run_pull "$mref" && docker tag "$mref" "$img"; then
        ok "  $img"
        docker rmi "$mref" >/dev/null 2>&1 || true
        return 0
      fi
      if [ "$i" -lt "$tries" ]; then
        warn "  Attempt ${i}/${tries} did not finish; retrying to resume…"
      fi
      i=$((i + 1))
      sleep 3
    done
    warn "  Mirror failed repeatedly; falling back to direct: $img"
  fi

  direct_pull "$img"
}

# Pull all images required by the deploy.
#  - Both mirrors empty: a plain `compose pull` (behavior matches the old version)
#  - Either mirror set:    managed images are always "pulled via the mirror first +
#                          re-tagged as the official tag", and at the end there is
#                          no further `compose pull`, to avoid re-fetching freshly
#                          pulled images from upstream. compose uses pull_policy:
#                          missing, so startup hits the local image directly.
pull_images() {
  local ver="${1:-}" gm="${WM_GHCR_MIRROR:-}" hm="${WM_HUB_MIRROR:-}"
  local img missing=0

  if [ -z "$gm" ] && [ -z "$hm" ]; then
    crun compose pull || return 1
    return 0
  fi

  if [ -n "$gm" ]; then
    log "  ghcr mirror: $gm"
    for img in "${WM_REPO}:${ver}" "${WM_EXTRA_REPO}:${ver}" "$CADDY_IMAGE"; do
      mirror_pull_one ghcr "$gm" "$img" || missing=1
    done
  else
    for img in "${WM_REPO}:${ver}" "${WM_EXTRA_REPO}:${ver}" "$CADDY_IMAGE"; do
      direct_pull "$img" || missing=1
    done
  fi

  if [ -n "$hm" ]; then
    log "  docker.io mirror: $hm"
    mirror_pull_one hub "$hm" "$PG_IMAGE" || missing=1
  else
    direct_pull "$PG_IMAGE" || missing=1
  fi

  [ "$missing" = 0 ] || warn "Some images are not ready; compose will retry the pull automatically on startup"
  return 0
}

# =============================================================================
# Database / health
# =============================================================================
# Shared-mode check: when .env's DATABASE_URL points to aibox-base-postgres, the
# compose db service (set to replicas:0) is not running, and all DB operations go
# through the shared base PG container.
shared_pg_active() {
  case "$(get_env DATABASE_URL)" in
    *${SHARED_PG_CONTAINER}*) return 0 ;;
    *)                        return 1 ;;
  esac
}

# DB-operation container routing: shared -> docker exec aibox-base-postgres; standalone ->
# dexec db (compose exec). This only picks the container; the connection user
# (-U aibox / -U postgres) is decided by the caller via pg_user().
pg_exec() {
  if shared_pg_active; then
    docker exec -i "$SHARED_PG_CONTAINER" "$@"
  else
    dexec db "$@"
  fi
}

# Current DB connection user: shared mode = aibox, standalone mode = postgres.
pg_user() {
  if shared_pg_active; then printf '%s' "$SHARED_PG_USER"
  else printf '%s' 'postgres'; fi
}

db_cid() {
  if shared_pg_active; then
    # Shared mode: the db service is not running; always point at the base PG
    # container (return its name only if the container is running)
    if docker inspect "$SHARED_PG_CONTAINER" >/dev/null 2>&1; then
      printf '%s' "$SHARED_PG_CONTAINER"
    fi
  else
    compose ps -q db 2>/dev/null | head -1
  fi
}
server_cid()  { compose ps -q windmill_server 2>/dev/null | head -1; }
extra_cid()   { compose ps -q windmill_extra 2>/dev/null | head -1; }

db_healthy() {
  local cid h
  cid=$(db_cid); [ -n "$cid" ] || return 1
  if shared_pg_active; then
    # The shared PG is managed by the base deploy and its healthcheck may not align
    # with this stack, so probing with pg_isready is more reliable (this check is
    # shared by doctor/status/upgrade/backup).
    docker exec "$cid" pg_isready -U "$SHARED_PG_USER" >/dev/null 2>&1
    return $?
  fi
  h=$(docker inspect "$cid" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || echo none)
  [ "$h" = "healthy" ]
}

wait_db() {
  local deadline=$(( $(date +%s) + 180 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    db_healthy && return 0
    sleep 3
  done
  return 1
}

migration_count() {
  pg_exec psql -U "$(pg_user)" -d windmill -tAc 'select count(*) from _sqlx_migrations' 2>/dev/null | tr -d '[:space:]'
}
migration_max() {
  pg_exec psql -U "$(pg_user)" -d windmill -tAc 'select max(version) from _sqlx_migrations' 2>/dev/null | tr -d '[:space:]'
}
# Generic single-value query
qval() {
  pg_exec psql -U "$(pg_user)" -d "${2:-windmill}" -tAc "$1" 2>/dev/null | tr -d '[:space:]'
}

# Prefer asking "this instance's" server container.
# Do not prefer the host port: when a second instance runs on the same host (drill
# env), it would answer someone else's version.
probe_version() {
  local v="" cid
  cid=$(server_cid)
  if [ -n "$cid" ]; then
    v=$(docker exec "$cid" curl -fsS --max-time 5 http://localhost:8000/api/version 2>/dev/null || true)
  fi
  if [ -z "$v" ]; then
    v=$(curl -fsS --max-time 5 "http://127.0.0.1:${HTTP_PORT}/api/version" 2>/dev/null || true)
  fi
  printf '%s' "$v"
}

wait_version() {
  local want="$1" deadline=$(( $(date +%s) + HEALTH_TIMEOUT )) v=""
  while [ "$(date +%s)" -lt "$deadline" ]; do
    v=$(probe_version)
    version_matches "$v" "$want" && return 0
    sleep 3
  done
  warn "Timed out waiting for version v${want} (${HEALTH_TIMEOUT}s); last probe: '${v:-<empty>}'"
  return 1
}

# Note: must be two separate `local` statements. Writing
#       `local secs=... deadline=$(( ... + secs ))` would have `local` declare both
#       names unset first, and under set -u computing deadline raises unbound variable.
wait_server_healthy() {
  local _secs="${1:-$HEALTH_TIMEOUT}"
  local deadline=$(( $(date +%s) + _secs ))
  local cid h
  while [ "$(date +%s)" -lt "$deadline" ]; do
    cid=$(server_cid)
    if [ -n "$cid" ]; then
      h=$(docker inspect "$cid" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || echo none)
      if [ "$h" = "healthy" ]; then return 0; fi
    fi
    sleep 4
  done
  warn "windmill_server did not become healthy within ${_secs}s"
  return 1
}

all_running() {
  local want=(db windmill_server windmill_worker windmill_worker_native windmill_extra caddy)
  local s n bad
  # Shared-PG mode: the db service is replicas:0 by design (never has a container).
  # Requiring it made every health gate fail on an otherwise-healthy shared-mode deploy
  # (found via live prod-profile init: UI 200 + server healthy, but init died with
  # "Service db has no running container" → "Deploy did not pass the health check").
  if shared_pg_active; then
    local _want2=()
    for s in "${want[@]}"; do [ "$s" = "db" ] || _want2+=("$s"); done
    want=("${_want2[@]}")
  fi
  for s in "${want[@]}"; do
    n=$( { compose ps -q "$s" 2>/dev/null || true; } | wc -l )
    if [ "$n" -lt 1 ]; then warn "Service $s has no running container"; return 1; fi
  done
  bad=$(compose ps -a --format '{{.Service}}={{.State}}' 2>/dev/null | grep -v '=running' || true)
  if [ -n "$bad" ]; then warn "Found non-running containers: $(echo "$bad" | tr '\n' ' ')"; return 1; fi
  return 0
}

wm_port_listening() { port_listening "$HTTP_PORT"; }

# Strip ANSI color escape codes. windmill server logs are **colored output**; without
# stripping, the level field never parses (the level field is a color escape like
# `\e[32m` rather than INFO/ERROR), so any level-based check silently fails.
# Only after stripping can the level be read reliably.
_strip_ansi() { sed -E $'s/\x1b\\[[0-9;]*[a-zA-Z]//g'; }

# Fatal errors: used to **judge deploy failure**.
# Only collects signatures of "the deploy is really broken": panic, FATAL, cannot
# connect to the DB, migration tampered, port in use, etc.
log_fatal() {
  local cid; cid=$(server_cid)
  [ -n "$cid" ] || return 0
  docker logs --tail 400 "$cid" 2>&1 | _strip_ansi \
    | grep -E 'panicked|(^|[[:space:]])FATAL([[:space:]]|$)|could ?n.t connect to (the )?database|cannot connect to database|was previously applied but has been modified|error returned from database|address already in use|EADDRINUSE' || true
}

# Non-fatal ERRORs: used only for **hints**, not to judge failure.
#
# Two pitfalls were hit here, recorded so we don't repeat them:
# 1) 'migration .*fail|migration .*error' was once used as a signature -> a fresh
#    deploy that is 100% healthy would be falsely flagged. Because the migration
#    **name** itself contains failure/error (measured two:
#    "v2 job completed failure index", "error handler fallback to instance alerts"),
#    and they are INFO-level normal progress logs. -> Conclusion: migration names
#    must not be used as error signatures.
# 2) Measured locally: while a fresh deploy runs healthy, the server still logs
#    ERROR periodically:
#      ERROR windmill-api-embeddings/src/lib.rs: Failed to create embeddings db:
#      error decoding response body for url (https://bucket.windmillhub.com/...)
#    This is a failed external embeddings fetch (environment/network noise), not
#    service-affecting. Judging failure on it would permanently stall a healthy
#    deploy at the health check.
# -> Conclusion: ERROR level != deploy failure; failure judgment is left to
#   log_fatal + objective checks (version probe / container running / port
#   listening / container healthcheck).
log_errors() {
  local cid; cid=$(server_cid)
  [ -n "$cid" ] || return 0
  docker logs --tail 400 "$cid" 2>&1 | _strip_ansi \
    | grep -E '(^|[[:space:]])ERROR([[:space:]]|$)' \
    | grep -vE 'Started applying migration|Finished applying migration' || true
}

# Staged startup. Don't do `compose up -d` all at once: rebuilding 8 containers
# simultaneously causes an I/O spike. Start one stage; retry on failure.
#
# Why retry: docker has a volume init race when creating sibling containers that
# mount the same named volume, returning 500 directly:
#   failed to mkdir /var/lib/docker/volumes/<vol>/_data/<subdir>: file exists
#   POST /containers/create ... status=500
# Measured with windmill_worker (replicas=3) and windmill_worker_native sharing
# the windmill_worker_dependency_cache volume, a fresh deploy's first startup
# always hits this race — containers sit in Created and the whole init is wasted.
# It is transient; one retry succeeds.
# COMPOSE_PARALLEL_LIMIT=1 serializes things but cannot block this daemon-side
# async init race.
compose_up_stage() {
  local desc="$1"; shift
  local tries="${WM_UP_RETRY:-3}" i=1
  while [ "$i" -le "$tries" ]; do
    if compose up -d --no-deps "$@"; then return 0; fi
    if [ "$i" -lt "$tries" ]; then
      warn "  Starting ${desc} failed (attempt ${i}/${tries}); retrying in 3s…"
      sleep 3
    fi
    i=$((i + 1))
  done
  warn "Starting ${desc} failed ${tries} times in a row"
  return 1
}

stack_up_staged() {
  local services="${1:-}"
  if [ -n "$services" ]; then
    # Subset mode (for drills): don't touch caddy, to avoid grabbing host port 80
    step "Stage 1/2: db"
    compose_up_stage "db" db || return 1
    wait_db || { warn "db did not become healthy"; return 1; }
    step "Stage 2/2: $services"
    # shellcheck disable=SC2086
    compose_up_stage "$services" $services || return 1
    return 0
  fi
  step "Stage 1/4: db"
  compose_up_stage "db" db || return 1
  wait_db || { warn "db did not become healthy"; return 1; }

  step "Stage 2/4: windmill_server (runs DB migrations)"
  compose_up_stage "windmill_server" windmill_server || return 1
  wait_server_healthy || true   # timeout does not fail immediately; the final health verdict decides

  step "Stage 3/4: workers"
  compose_up_stage "workers" windmill_worker windmill_worker_native || return 1

  step "Stage 4/4: windmill_extra + caddy"
  compose_up_stage "windmill_extra + caddy" windmill_extra caddy || return 1
  return 0
}

# =============================================================================
# Lock
# =============================================================================
acquire_lock() {
  mkdir -p "$WM_DIR" 2>/dev/null || true
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Another deploy task is running (lock: ${LOCK_FILE}). Confirm none is running, then delete that file and retry."
  else
    # macOS has no flock: mkdir-based atomic lock; a stale lock whose holding process
    # is gone is reclaimed automatically
    local d="${LOCK_FILE}.d" pid
    if [ -d "$d" ]; then
      pid=$(cat "$d/pid" 2>/dev/null || true)
      if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        rm -rf "$d"
        warn "Reclaimed stale lock ${d} (holding process ${pid:-?} no longer exists)"
      fi
    fi
    mkdir "$d" 2>/dev/null \
      || die "Another deploy task is running (lock: ${d}). Confirm none is running, then delete that directory and retry."
    printf '%s\n' "$$" > "$d/pid"
  fi
}

# =============================================================================
# Confirm
# =============================================================================
confirm() {
  local prompt="$1"
  if [ "$ASSUME_YES" = 1 ]; then return 0; fi
  if [ "$DRY_RUN" = 1 ]; then return 0; fi
  printf '%s%s%s\nType yes and press Enter to continue: ' "$C_YELLOW" "$prompt" "$C_RESET"
  local ans=""
  read -r ans || true
  [ "$ans" = "yes" ] || { log "Cancelled; nothing was changed."; return 1; }
  return 0
}

# =============================================================================
# Deploy state probing
# =============================================================================
config_missing() {
  local m=""
  [ -f "$COMPOSE_FILE" ] || m="$m docker-compose.yml"
  [ -f "$CADDY_FILE" ]   || m="$m Caddyfile"
  [ -f "$ENV_FILE" ]     || m="$m .env"
  printf '%s' "${m# }"
}

project_name() {
  local p=""
  if [ -f "$COMPOSE_FILE" ]; then
    p=$(docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" \
          config --format json 2>/dev/null \
        | python3 -c 'import sys,json;print(json.load(sys.stdin).get("name",""))' 2>/dev/null || true)
  fi
  [ -n "$p" ] || p=$(basename "$WM_DIR")
  printf '%s' "$p"
}

# This project's db data volume.
# It must be scoped by project: if a second compose project exists on the same host
# (drill env), a global `*_db_data` glob taking the first match would hit someone
# else's volume, while the caller might be about to delete it.
db_volume() {
  local proj vol
  proj=$(project_name)
  vol=$(docker volume ls --filter "label=com.docker.compose.project=${proj}" \
          --format '{{.Name}}' 2>/dev/null | grep -E '(^|_)db_data$' | head -1 || true)
  [ -n "$vol" ] || vol=$(docker volume ls --format '{{.Name}}' 2>/dev/null \
          | grep -E "^${proj}[_-]db_data$" | head -1 || true)
  printf '%s' "$vol"
}

project_volumes() {
  local proj; proj=$(project_name)
  docker volume ls --filter "label=com.docker.compose.project=${proj}" --format '{{.Name}}' 2>/dev/null || true
}

volume_has_cluster() {
  local vol="${1:-}" mp
  [ -n "$vol" ] || return 1
  docker volume inspect "$vol" >/dev/null 2>&1 || return 1
  mp=$(docker volume inspect "$vol" --format '{{.Mountpoint}}' 2>/dev/null || true)
  [ -n "$mp" ] || return 1
  find "$mp" -maxdepth 4 -name PG_VERSION -print -quit 2>/dev/null | grep -q .
}

# Count files matching a glob. ls returns non-zero when nothing matches, which under
# pipefail would take down the whole pipeline, so guard explicitly and normalize to 0.
count_files() {
  local out; out=$(ls -1 "$@" 2>/dev/null || true)
  if [ -z "$out" ]; then printf '0'; return 0; fi
  printf '%s\n' "$out" | wc -l | tr -d ' '
}

latest_snapshot()     { ls -1dt "$BACKUP_DIR"/[0-9]* 2>/dev/null | head -1 || true; }
latest_daily_backup() { ls -1t "$BACKUP_DIR"/daily/cluster-*.sql.gz 2>/dev/null | head -1 || true; }
snapshot_list()       { ls -1dt "$BACKUP_DIR"/[0-9]* 2>/dev/null || true; }

env_version() { image_version "$(get_env WM_IMAGE)"; }

# The instance's external address, used for display and setting the Base URL
instance_url() {
  local host port
  host=$(primary_ip)
  [ -n "$host" ] || host="127.0.0.1"
  port=$(get_env HTTP_PORT)
  if [ -z "$port" ]; then port="${HTTP_PORT:-80}"; fi
  if [ "$port" = "80" ]; then printf 'http://%s' "$host"
  else printf 'http://%s:%s' "$host" "$port"; fi
}

# =============================================================================
# Backup primitives
# =============================================================================
new_backup_dir() {
  local d="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$d"
  printf '%s' "$d"
}

verify_dump_file() {
  local f="$1"
  [ -s "$f" ] || { warn "dump missing or empty: $f"; return 1; }
  grep -q '^CREATE DATABASE windmill' "$f" || { warn "dump lacks 'CREATE DATABASE windmill', unusable: $f"; return 1; }
  tail -3 "$f" | grep -q 'dump complete'   || { warn "dump incomplete (missing 'dump complete' marker): $f"; return 1; }
  return 0
}

# Generate and verify a full snapshot (DB + config + meta)
make_backup() {
  local d="$1" pol
  step "Full snapshot -> $d"
  pg_exec pg_dumpall -U "$(pg_user)" > "$d/cluster.sql" 2>"$d/dump.err" || {
    warn "pg_dumpall failed, stderr:"; cat "$d/dump.err" >&2; return 1; }
  [ -s "$d/cluster.sql" ] || { warn "backup file is empty"; return 1; }
  grep -q '^CREATE DATABASE windmill' "$d/cluster.sql" \
    || { warn "backup lacks 'CREATE DATABASE windmill', likely incomplete"; return 1; }
  tail -3 "$d/cluster.sql" | grep -q 'dump complete' \
    || { warn "backup lacks 'dump complete' marker, likely truncated"; return 1; }

  cp -a "$COMPOSE_FILE" "$CADDY_FILE" "$ENV_FILE" "$d/" 2>/dev/null || true
  sha256sum "$d/cluster.sql" > "$d/cluster.sql.sha256"
  {
    echo "BACKUP_TS=$(basename "$d")"
    echo "WM_VERSION=$(current_version)"
    echo "WM_IMAGE=$(get_env WM_IMAGE)"
    echo "WM_EXTRA_IMAGE=$(get_env WM_EXTRA_IMAGE)"
    echo "MIGRATION_COUNT=$(migration_count || echo 0)"
    echo "PG_VERSION=$(qval 'show server_version' postgres)"
  } > "$d/meta.env"

  pol=$(grep -c 'CREATE POLICY' "$d/cluster.sql" || true)
  ok "Snapshot complete and verified: $(du -h "$d/cluster.sql" | cut -f1), ${pol} RLS policies"
  info "  sha256 $(cut -d' ' -f1 < "$d/cluster.sql.sha256")"
  return 0
}

prune_backups() {
  local keep="${1:-5}" all olds
  all=$(ls -1dt "$BACKUP_DIR"/[0-9]* 2>/dev/null || true)
  [ -n "$all" ] || return 0
  olds=$(printf '%s\n' "$all" | tail -n +$((keep+1)))
  [ -n "$olds" ] || return 0
  while read -r f; do
    [ -n "$f" ] || continue
    log "  Prune expired snapshot: $f"; rm -rf "$f"
  done <<< "$olds"
}

# Restore a pg_dumpall text dump into the production DB. Precondition: db is running
# and healthy.
restore_cluster_from() {
  local sql="$1" log_dst="${2:-$LOG_DIR/restore.log}" cid errs u
  verify_dump_file "$sql" || return 1
  cid=$(db_cid); [ -n "$cid" ] || { warn "db container not running; cannot restore"; return 1; }
  u=$(pg_user)

  # POSTGRES_DB already created an empty windmill; DROP it first, otherwise the
  # dump's CREATE DATABASE will inevitably fail
  pg_exec psql -U "$u" -d postgres -c 'DROP DATABASE IF EXISTS windmill' >/dev/null 2>&1 || true
  docker cp "$sql" "$cid":/tmp/restore.sql >/dev/null 2>&1 || { warn "Cannot copy the dump into the db container"; return 1; }
  pg_exec psql -U "$u" -d postgres -f /tmp/restore.sql > "$log_dst" 2>&1 || true
  pg_exec sh -c 'rm -f /tmp/restore.sql' >/dev/null 2>&1 || true

  errs=$(grep -ci '^ERROR' "$log_dst" 2>/dev/null || true); errs="${errs:-0}"
  info "  Restore log ERROR line count = ${errs} (expect 0 or 1; >1 means the restore is incomplete)"
  [ "$errs" -le 1 ]
}

# The dump records role passwords "at snapshot time"; .env holds the currently
# effective password. If they differ, the DB cannot be connected to.
sync_db_password() {
  local pw u
  pw=$(get_env POSTGRES_PASSWORD)
  [ -n "$pw" ] || { warn ".env has no POSTGRES_PASSWORD set"; return 1; }
  u=$(pg_user)
  pg_exec psql -U "$u" -d postgres -c "ALTER USER ${u} WITH PASSWORD '${pw}'" >/dev/null 2>&1 \
    || { warn "ALTER USER ${u} failed"; return 1; }
  info "  Synced the .env DB password to the ${u} role"
}

refresh_planner_stats() {
  pg_exec vacuumdb -U "$(pg_user)" --all --analyze-in-stages >/dev/null 2>&1 \
    && info "  Rebuilt planner stats" || warn "  vacuumdb skipped (does not affect availability)"
}

# Standalone -> shared PG migration: load the local compose db's full dump into the
# aibox base PG's windmill database. Idempotent: exits directly if already in shared
# mode; success is judged by the target migration count matching the source.
cmd_migrate_to_shared_pg() {
  require_ready; wm_paths
  [ -f "$ENV_FILE" ] || die "No deploy found (${ENV_FILE})"

  hr; log "${C_BOLD}Migrate to shared base PG${C_RESET}  $(ts)"; hr

  if shared_pg_active; then
    ok "DATABASE_URL already points to ${SHARED_PG_CONTAINER}; no migration needed"
    return 0
  fi

  # Source: the local standalone db must be running and healthy
  db_healthy || die "Local db is not healthy; cannot be used as the migration source. Run ${CLI_NAME} up first"
  # Target: the shared PG container must be running
  docker inspect "$SHARED_PG_CONTAINER" >/dev/null 2>&1 \
    || die "Shared PG container ${SHARED_PG_CONTAINER} is not running; start aibox base first"

  log "  Source: local compose db (standalone mode)"
  log "  Target: ${SHARED_PG_CONTAINER} / windmill (user ${SHARED_PG_USER})"
  warn "Migration loads the full windmill database into the shared PG; if the target DB already has data of the same name, clean it up first."
  confirm "Confirm migrating the local db to ${SHARED_PG_CONTAINER}?" || return 0

  local tmp="/tmp/windmill-migrate-$$.sql" log_dst="$LOG_DIR/migrate-shared.log" errs=0
  mkdir -p "$LOG_DIR"
  trap "rm -f -- '${tmp}'" EXIT

  step "1/4 Export the local full dump"
  if ! dexec db pg_dumpall -U postgres > "$tmp" 2>"$log_dst"; then
    warn "pg_dumpall failed:"; cat "$log_dst" >&2; rm -f -- "$tmp"; return 1
  fi
  [ -s "$tmp" ] || { warn "dump is empty"; rm -f -- "$tmp"; return 1; }
  grep -q '^CREATE DATABASE windmill' "$tmp" \
    || { warn "dump lacks 'CREATE DATABASE windmill'"; rm -f -- "$tmp"; return 1; }
  info "  dump $(du -h "$tmp" | cut -f1)"

  step "2/4 Ensure the target windmill DB exists"
  # If the target already exists, stay quiet; when loading the data below, the
  # dump's CREATE DATABASE will report already-exists, which is expected.
  docker exec -i "$SHARED_PG_CONTAINER" psql -U "$SHARED_PG_USER" -d postgres \
    -c 'CREATE DATABASE windmill' >>"$log_dst" 2>&1 || true

  step "3/4 Load into the shared PG"
  # A pg_dumpall dump contains roles + each DB; loading into an existing cluster
  # produces several 'already exists' errors, which is normal.
  if ! docker exec -i "$SHARED_PG_CONTAINER" psql -U "$SHARED_PG_USER" -d windmill \
        < "$tmp" >>"$log_dst" 2>&1; then
    warn "Load command returned non-zero ('already exists'-style errors are normal; see the log)"
  fi

  step "4/4 Verify the migration result"
  local src_mc dst_mc
  src_mc=$(dexec db psql -U postgres -d windmill -tAc 'select count(*) from _sqlx_migrations' 2>/dev/null | tr -d '[:space:]' || true)
  dst_mc=$(docker exec "$SHARED_PG_CONTAINER" psql -U "$SHARED_PG_USER" -d windmill -tAc 'select count(*) from _sqlx_migrations' 2>/dev/null | tr -d '[:space:]' || true)
  errs=$(grep -ci '^ERROR' "$log_dst" 2>/dev/null || true); errs="${errs:-0}"
  info "  Migrations source=${src_mc:-0} target=${dst_mc:-0}; log ERROR lines=${errs}"
  rm -f -- "$tmp"

  if [ -n "$dst_mc" ] && [ "${src_mc:-0}" = "$dst_mc" ]; then
    ok "Migration complete: windmill migration count matches (${dst_mc})"
    hr
    log "  Next: change ${ENV_FILE}'s DATABASE_URL to"
    log "    DATABASE_URL=postgres://${SHARED_PG_USER}:\${POSTGRES_PASSWORD}@${SHARED_PG_CONTAINER}:5432/windmill"
    log "  Then run ${CLI_NAME} deploy to rebuild (the compose db will exit as replicas:0)."
    hr
  else
    warn "Migration count mismatch or target empty; check ${log_dst}"
    return 1
  fi
}

# Move the backup dir outside the deploy dir, so it is not wiped along with the deploy
# Destination: $AIBOX_HOME/backups/ (aibox unified namespace, consistent across platforms);
# falls back to /var/backups when there is no HOME
evacuate_backups() {
  local dst
  dst="$(backup_evac_dir)/windmill-pre-destroy-$(date +%Y%m%d-%H%M%S)"
  [ -d "$BACKUP_DIR" ] || return 0
  [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ] || return 0
  mkdir -p "$dst" || { warn "Cannot create $dst"; return 1; }
  cp -a "$BACKUP_DIR"/. "$dst"/ && ok "Backups evacuated to $dst"
}

# =============================================================================
# Embedded templates
# Use quoted heredocs (<<'WMEOF') so ${VAR} / ${VAR} are written verbatim.
# =============================================================================

render_compose() {
  cat > "$COMPOSE_FILE" <<'WMEOF'
## ============================================================================
## Windmill self-hosted compose — generated by `windmill init`
##
## Compared to the upstream https://github.com/windmill-labs/windmill
## docker-compose.yml, this file has 8 local modifications. Keep them when syncing
## against upstream:
##
##  1. Drop the obsolete `version: "3.7"` top-level field (silences a compose warning)
##  2. `pull_policy: always` -> `missing`
##     The version is pinned in .env. `always` would re-pull on every `up -d`, and
##     a network blip would make startup fail outright; `missing` lets `windmill
##     upgrade` control when pulls happen.
##  3. `windmill_extra.image` changed from a hardcoded `:latest` to `${WM_EXTRA_IMAGE}`
##     Upstream this is not controlled by .env, so the version cannot be pinned or rolled back.
##  4. `windmill_server` gains a healthcheck probing /api/version
##     The official docs' /api/health returns 404 on CE v1.809/v1.811 (measured).
##  5. caddy removes the `- 25:25` port mapping
##     The host's exim4 occupies 127.0.0.1:25, which would make caddy fail to bind,
##     the container fail to start, port 80 not listen, and the whole UI be
##     unreachable. The email trigger is not needed for home use.
##  6. db's POSTGRES_PASSWORD is changed to ${POSTGRES_PASSWORD}
##  7. worker/native memory caps tightened from 2048M (4 exec containers x2G exceeds the 7.8G physical RAM)
##  8. Connect to the shared aibox base PG (no local standalone db):
##     db becomes `deploy.replicas: 0`; windmill_server/worker/worker_native/indexer
##     drop depends_on and join the external network `aibox-base`.
##     Precondition: aibox base start + aibox base createdb windmill,
##     .env DATABASE_URL=postgres://aibox:aibox@aibox-base-postgres:5432/windmill.
##
## Note: postgres:18's mount point must be /var/lib/postgresql (the parent dir);
##       it cannot be reverted to the pre-18 /var/lib/postgresql/data, or an empty
##       cluster is silently created.
## ============================================================================

x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "${LOG_MAX_SIZE:-20m}"
    max-file: "${LOG_MAX_FILE:-10}"
    compress: "true"

services:
  ## UPGRADING FROM POSTGRES 16: db_data holds a cluster 18 cannot read, so the
  ## container exits with an explanatory error rather than coming up blank. Migrating
  ## means dumping the WHOLE cluster (pg_dumpall), never just the windmill database:
  ## Windmill keeps datatable, DuckLake and wm_fork_* databases beside it and grants
  ## its RLS policies to cluster-level roles, and a single-database dump loses both
  ## silently. Full procedure, and why 16 is still a valid choice until Nov 2028:
  ## https://www.windmill.dev/docs/advanced/self_host#upgrade-postgresql-to-18
  db:
    deploy:
      # Connect to the shared aibox base PG (no local standalone db):
      #   aibox base start + aibox base createdb windmill
      #   .env DATABASE_URL=postgres://aibox:aibox@aibox-base-postgres:5432/windmill
      replicas: 0
    image: postgres:18
    shm_size: 1g
    restart: unless-stopped
    volumes:
      # From 18 on the official image keeps the cluster in a major-version
      # subdirectory (/var/lib/postgresql/18/docker), so the mount has to be the
      # parent directory: that is what lets pg_upgrade see an old and a new
      # cluster inside a single mount point. Mounting the pre-18 .../data path
      # instead makes the image exit rather than start, which is what turns a
      # stale 16 cluster into a loud failure instead of an empty instance.
      - db_data:/var/lib/postgresql
    expose:
      - 5432
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: windmill
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging: *default-logging

  windmill_server:
    image: ${WM_IMAGE}
    pull_policy: missing
    deploy:
      replicas: 1
    restart: unless-stopped
    expose:
      - 8000
      - 2525
    healthcheck:
      # The official docs' /api/health returns 404 on CE v1.809/v1.811 (measured), so /api/version is used.
      test: ["CMD-SHELL", "curl -fsS --max-time 5 http://localhost:8000/api/version | grep -q 'v1\\.'"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 90s
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - MODE=server
    depends_on: []
    networks: [default, aiboxbasenet]
    volumes:
      - worker_logs:/tmp/windmill/logs

    logging: *default-logging

  windmill_worker:
    image: ${WM_IMAGE}
    pull_policy: missing
    deploy:
      replicas: 3
      resources:
        limits:
          memory: 1536M
          # for GB, use syntax '2Gi'
    restart: unless-stopped
    # Uncomment to enable PID namespace isolation (recommended for security)
    # Requires privileged mode for --mount-proc flag
    # See: https://www.windmill.dev/docs/advanced/security_isolation
    privileged: true
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - MODE=worker
      - WORKER_GROUP=default
      # If running with non-root/non-windmill UID (e.g., user: "1001:1001"),
      # add: - HOME=/tmp
      - FAVOR_UNSHARE_PID=true
    depends_on: []
    networks: [default, aiboxbasenet]
    # to mount the worker folder to debug, KEEP_JOB_DIR=true and mount /tmp/windmill
    volumes:
      - worker_dependency_cache:/tmp/windmill/cache
      - worker_logs:/tmp/windmill/logs
      ## Sandboxed containers (`# sandbox <image>`) run daemonless via crane + nsjail
      ## inside the worker itself — no Docker socket or dind sidecar required.
      ## For the legacy full-compat docker (a bare `# docker`, trusted users only),
      ## mount the host Docker socket by uncommenting the line below. WARNING: this
      ## grants user scripts full access to the host Docker daemon (host filesystem
      ## access and privilege escalation) — only use it if you fully trust all users.
      # - /var/run/docker.sock:/var/run/docker.sock

    logging: *default-logging

  ## This worker is specialized for "native" jobs. Native jobs run in-process and thus are much more lightweight than other jobs
  windmill_worker_native:
    # Use ghcr.io/windmill-labs/windmill-ee:main for the ee
    image: ${WM_IMAGE}
    pull_policy: missing
    deploy:
      replicas: 1
      resources:
        limits:
          memory: 1024M
          # for GB, use syntax '2Gi'
    restart: unless-stopped
    # Uncomment to enable PID namespace isolation (recommended for security)
    # Requires privileged mode for --mount-proc flag
    # See: https://www.windmill.dev/docs/advanced/security_isolation
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - MODE=worker
      - WORKER_GROUP=native
      - NATIVE_MODE=true
      - SLEEP_QUEUE=200
    depends_on: []
    networks: [default, aiboxbasenet]
    volumes:
      - worker_logs:/tmp/windmill/logs
    logging: *default-logging

  # The indexer powers full-text job and log search, an EE feature.
  windmill_indexer:
    image: ${WM_IMAGE}
    pull_policy: missing
    deploy:
      replicas: 0 # set to 1 to enable full-text job and log search
    restart: unless-stopped
    expose:
      - 8002
    environment:
      - PORT=8002
      - DATABASE_URL=${DATABASE_URL}
      - MODE=indexer
    depends_on: []
    networks: [default, aiboxbasenet]
    volumes:
      - windmill_index:/tmp/windmill/search
      - worker_logs:/tmp/windmill/logs
    logging: *default-logging

  # Combined extra services: LSP, Multiplayer, and Debugger
  # Each service can be enabled/disabled via environment variables:
  #   - ENABLE_LSP=true (default) - Language Server Protocol for code intelligence
  #   - ENABLE_MULTIPLAYER=false - Real-time collaboration (Enterprise Edition)
  #   - ENABLE_DEBUGGER=false - Interactive debugging via DAP WebSocket
  windmill_extra:
    image: ${WM_EXTRA_IMAGE}
    pull_policy: missing
    restart: unless-stopped
    expose:
      - 3001 # LSP
      - 3002 # Multiplayer
      - 3003 # Debugger
    environment:
      - ENABLE_LSP=true
      - ENABLE_MULTIPLAYER=false # Set to true to enable multiplayer (Enterprise Edition)
      - ENABLE_DEBUGGER=true # Set to true to enable debugger
      - DEBUGGER_PORT=3003 # Debugger service port
      - ENABLE_NSJAIL=false # Set to true for nsjail sandboxing (requires privileged: true)
      - REQUIRE_SIGNED_DEBUG_REQUESTS=true # Require backend-signed JWT tokens for debug sessions. Do NOT set to false on any internet-reachable deployment: it exposes an unauthenticated code-execution debugger.
      - WINDMILL_BASE_URL=http://windmill_server:8000
    volumes:
      - lsp_cache:/pyls/.cache
    logging: *default-logging

  caddy:
    # Pinned: this image and the ./Caddyfile next to it are version-coupled, so
    # they have to move together. Bump docker/caddy-l4.version in the same
    # commit as any Caddyfile change.
    image: ghcr.io/windmill-labs/caddy-l4:2.11.4-1
    restart: unless-stopped
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
    ports:
      # Port controlled by .env's HTTP_PORT (default 80)
      - "${HTTP_PORT:-80}:80"
      # `- 25:25` removed: the host's exim4 occupies 127.0.0.1:25, which would make caddy fail to bind.
      # If you need the email trigger later, change this to `- 2525:25` and restore the layer4 :25 block in Caddyfile.
      # - 443:443 # Uncomment to enable HTTPS handling by Caddy
    environment:
      - BASE_URL=":80"
    logging: *default-logging

volumes:
  db_data: null
  worker_dependency_cache: null
  worker_logs: null
  worker_memory: null
  windmill_index: null
  lsp_cache: null
  caddy_data: null

networks:
  default:
  aiboxbasenet:
    name: ${AIBOX_BASE_NETWORK:-aibox-base}
    external: true
WMEOF
  chmod 0644 "$COMPOSE_FILE"
}

render_caddy() {
  cat > "$CADDY_FILE" <<'WMEOF'
# ============================================================================
# Caddyfile — generated by `windmill init`
#
# Based on the upstream https://github.com/windmill-labs/windmill Caddyfile, with
# one local change: the top-level `layer4 { :25 { route { proxy { upstream
# windmill_server:2525 } } } }` block is removed.
#
# Reason: that block is for the "email trigger" (TCP forward to
# windmill_server:2525). The matching `- 25:25` port mapping was removed from
# docker-compose.yml — the host's exim4 occupies 127.0.0.1:25, which makes caddy
# fail to bind, the container fail to start, and port 80 not listen.
#
# If you need the email trigger later: restore that block and add `- 2525:25`
# back to caddy.ports in docker-compose.yml (use 2525 to avoid the host's exim4).
#
# Note: this file is version-coupled with the caddy-l4 image (currently 2.11.4-1).
# ============================================================================

{$BASE_URL} {
        # Default to all interfaces (IPv4 + IPv6) when ADDRESS is unset. A bare
        # `bind {$ADDRESS}` with an empty value makes Caddy >= 2.9 drop this whole
        # site, silently disabling the HTTP proxy while the :25 layer4 listener stays up.
        bind {$ADDRESS:0.0.0.0 ::}

        # Extra services: LSP, Multiplayer, Debugger (windmill_extra gateway).
        # reverse_proxy only reads its first argument as a matcher, so listing
        # several paths inline turns the rest into upstream addresses. The paths
        # have to go through a named matcher.
        @extra path /ws/* /ws_mp/* /ws_debug/*
        reverse_proxy @extra http://windmill_extra:3000

        # Search indexer, Enterprise Edition (windmill_indexer:8002)
        # reverse_proxy /api/srch/* http://windmill_indexer:8002

        # Default: Windmill server
        reverse_proxy /* http://windmill_server:8000

        # TLS with custom certificates
        # tls /certs/cert.pem /certs/key.pem
}
WMEOF
  chmod 0644 "$CADDY_FILE"
}

render_env() {
  local ver="$1" dbpass="$2" port="$3"
  umask 077
  cat > "$ENV_FILE" <<WMEOF
# ============================================================================
# Windmill deploy config — generated by \`windmill init\` at $(ts)
#
# Version pinning policy: no drifting \`:main\` / \`:latest\` tags; use a fixed version number.
# Do not edit this file by hand for upgrades; run \`windmill upgrade\` (it auto-edits
# the two lines below and leaves a snapshot). The current deploy version is recorded
# in ${VERSION_FILE}.
# ============================================================================

# --- Database (connects to the shared aibox base PG; db replicas:0, no local PG) ---
# Precondition: aibox base start && aibox base createdb windmill
# Credentials: AIBOX_BASE_POSTGRES_USER/AIBOX_BASE_POSTGRES_PASSWORD (default aibox/aibox)
DATABASE_URL=postgres://${AIBOX_BASE_POSTGRES_USER:-aibox}:${AIBOX_BASE_POSTGRES_PASSWORD:-aibox}@${SHARED_PG_CONTAINER}:5432/windmill
# POSTGRES_PASSWORD is kept for standalone-mode db volume init (shared mode db replicas:0, no local PG)
POSTGRES_PASSWORD=${dbpass}

# --- Image versions (pinned; do not use :main / :latest) -------------------
WM_IMAGE=${WM_REPO}:${ver}
WM_EXTRA_IMAGE=${WM_EXTRA_REPO}:${ver}

# --- Entry port --------------------------------------------------------------
HTTP_PORT=${port}

# --- Log rotation (prevent long-running instances from filling the disk) ---
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10

# --- Egress proxy (only needed when \`windmill check\` queries upstream releases) ---
# Does not change the system global env; only takes effect inside the subprocess.
# Value is the proxy the CLI resolved at init time (--proxy > env var > conf).
WM_PROXY=${PROXY_URL:-}

# --- ghcr registry mirror (acceleration in China) ---------------------------
# Empty = direct ghcr.io (measures ~0.5MB/s in China; a fresh deploy takes 1+ hour).
# When set, init/upgrade first pull the ghcr images via the mirror and re-tag them
# as the official tag before starting.
# Example: WM_GHCR_MIRROR=https://ghcr.nju.edu.cn
WM_GHCR_MIRROR=${WM_GHCR_MIRROR:-}

# --- docker.io registry mirror (postgres uses it) ---------------------------
# Empty = leave it to the daemon's registry-mirrors. If the daemon has black-hole
# mirror entries, pulls will hang; explicitly set a working one here to bypass it
# (the CLI has its own timeout protection).
# Example: WM_HUB_MIRROR=https://docker.1ms.run
WM_HUB_MIRROR=${WM_HUB_MIRROR:-}
WMEOF
  chmod 0600 "$ENV_FILE"
}

# --- systemd units ----------------------------------------------------------
systemd_unit() {
  local name="$1"
  case "$name" in
    windmill-stack.service) cat <<WMEOF
[Unit]
Description=Windmill stack startup alignment (staged startup / reconcile created containers)
Documentation=man:$CLI_NAME(1)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=$COMPOSE_FILE

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
# Bake in the resolved path: systemd system services have no HOME (measured),
# so derived paths would resolve to empty
Environment="WM_DIR=$WM_DIR"
Environment="WM_CONF_FILE=$WM_CONF_FILE"
ExecStart=$CLI_BIN --quiet up
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
WMEOF
    ;;
    windmill-backup.service) cat <<WMEOF
[Unit]
Description=Windmill PostgreSQL daily backup (pg_dumpall of the whole cluster)
Documentation=man:$CLI_NAME(1)
After=docker.service
Requires=docker.service
ConditionPathExists=$COMPOSE_FILE

[Service]
Type=oneshot
User=root
Environment="WM_DIR=$WM_DIR"
Environment="WM_CONF_FILE=$WM_CONF_FILE"
ExecStart=$CLI_BIN --quiet --yes backup --daily
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
WMEOF
    ;;
    windmill-backup.timer) cat <<'WMEOF'
[Unit]
Description=Every day at 03:30 run the Windmill database backup

[Timer]
# Every day at 03:30, plus up to 5 minutes of random jitter to avoid colliding
# with other scheduled tasks
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=300
# A missed run while the machine was off is caught up after boot
Persistent=true
Unit=windmill-backup.service

[Install]
WantedBy=timers.target
WMEOF
    ;;
    windmill-update-check.service) cat <<WMEOF
[Unit]
Description=Windmill upstream new-version check (query only, no upgrade)
Documentation=man:$CLI_NAME(1)
After=docker.service
Requires=docker.service
ConditionPathExists=$COMPOSE_FILE

[Service]
Type=oneshot
User=root
Environment="WM_DIR=$WM_DIR"
Environment="WM_CONF_FILE=$WM_CONF_FILE"
ExecStart=$CLI_BIN --quiet check
TimeoutStartSec=300
# Script convention: 0=up to date, 10=new version available, 2=query failed.
# Treat 10 as success too, to avoid a noisy "failed" unit state every week.
SuccessExitStatus=0 10

[Install]
WantedBy=multi-user.target
WMEOF
    ;;
    windmill-update-check.timer) cat <<'WMEOF'
[Unit]
Description=Every Monday at 09:00 check the Windmill upstream for new versions

[Timer]
OnCalendar=Mon *-*-* 09:00:00
RandomizedDelaySec=600
Persistent=true
Unit=windmill-update-check.service

[Install]
WantedBy=timers.target
WMEOF
    ;;
    *) die "Unknown systemd unit: $name" ;;
  esac
}

SYSTEMD_UNITS=(
  windmill-stack.service
  windmill-backup.service
  windmill-backup.timer
  windmill-update-check.service
  windmill-update-check.timer
)

# =============================================================================
# Command: init — fresh deploy of an empty instance
# =============================================================================
cmd_init() {
  local ver="" port="$HTTP_PORT" do_harden=1 do_systemd=1 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --version)   ver="${2:-}"; shift 2 ;;
      --port)      port="${2:-}"; shift 2 ;;
      --ghcr-mirror) WM_GHCR_MIRROR="${2:-}"; shift 2 ;;
      --hub-mirror)  WM_HUB_MIRROR="${2:-}"; shift 2 ;;
      --no-harden) do_harden=0; shift ;;
      --no-systemd) do_systemd=0; shift ;;
      --force)     force=1; shift ;;
      -h|--help)   help_init; exit 0 ;;
      *)           usage_die "init: unknown argument $1" ;;
    esac
  done

  require_ready
  HTTP_PORT="$port"
  wm_paths

  hr
  log "${C_BOLD}Windmill fresh deploy${C_RESET}   dir $WM_DIR   port $HTTP_PORT"
  hr

  if [ -f "$COMPOSE_FILE" ] && [ "$force" != 1 ]; then
    die "Target already has a deploy (${COMPOSE_FILE}). Use \`$CLI_NAME deploy\` to rebuild, or add --force to overwrite the config."
  fi

  # --- 1. Directory and config -------------------------------------------
  step "1/7 Generate config files"
  mkdir -p "$WM_DIR" "$BACKUP_DIR" "$LOG_DIR"
  render_compose; info "  docker-compose.yml"
  render_caddy;   info "  Caddyfile"

  # --- 2. Target version --------------------------------------------------
  step "2/7 Determine the target version"
  if [ -z "$ver" ]; then
    log "  --version not given; querying the upstream latest release ..."
    ver=$(latest_version)
    [ -n "$ver" ] || die "Cannot query the upstream latest version. Specify explicitly: $CLI_NAME init --version 1.811.1"
  fi
  ver="${ver#v}"
  log "  Target version: $ver"

  # --- 3. Generate .env (with a random DB password) ----------------------
  step "3/7 Generate .env (random DB password)"
  local dbpass
  dbpass=$(gen_password 32)
  render_env "$ver" "$dbpass" "$port"
  ok "  .env generated (chmod 600)"

  # Config must be validated before any work, to avoid deleting a volume only
  # to find the config is wrong afterwards
  if docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" \
       config >/dev/null 2>/tmp/wm-init-cfg.err; then
    info "  compose config parses"
  else
    cat /tmp/wm-init-cfg.err >&2
    die "compose config parse failed; aborted (no containers were touched)"
  fi
  if docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" config 2>/dev/null \
       | grep -qE '\$\{'; then
    die "compose still has unresolved variables; check $ENV_FILE"
  fi

  # --- 4. Pre-flight checks ----------------------------------------------
  step "4/7 Pre-flight checks"
  require_free_space
  require_image "${WM_REPO}:${ver}"
  require_image "${WM_EXTRA_REPO}:${ver}"

  # --- 5. Pull images ----------------------------------------------------
  step "5/7 Pull images (~6-7G on first run)"
  pull_images "$ver" || die "Image pull failed (prefer configuring an HTTP proxy for the docker daemon; or add --ghcr-mirror / --hub-mirror)"

  # --- 6. Startup --------------------------------------------------------
  step "6/7 Start the database"
  crun compose up -d --no-deps db || { compose logs --tail 30 db >&2; die "Database failed to start"; }
  wait_db || warn "db healthcheck did not become healthy in time; continuing"

  step "7/7 Start the whole stack in stages (server creates tables and runs migrations on first start)"
  crun stack_up_staged || die "Staged startup failed"

  # --- Health check -----------------------------------------------------
  log ""
  step "Health check (up to ${HEALTH_TIMEOUT}s)"
  local okall=1
  wait_version "$ver" || okall=0
  all_running || okall=0
  wm_port_listening || { warn "Entry port $HTTP_PORT is not listening (caddy may not be up)"; okall=0; }
  # The log only judges "fatal errors"; ordinary ERRORs are just a hint (a failed
  # external embeddings fetch shows up periodically even in a healthy deploy and
  # must not be judged as failure — see the log_errors comment).
  local fatals; fatals=$(log_fatal)
  if [ -n "$fatals" ]; then warn "server log has fatal errors:"; printf '%s\n' "$fatals" >&2; okall=0; fi
  local errs; errs=$(log_errors)
  if [ -n "$errs" ]; then
    warn "server has $(printf '%s\n' "$errs" | grep -c .) non-fatal ERRORs (mostly external-dependency failures; does not affect the deploy):"
    printf '%s\n' "$errs" | head -3 >&2
  fi

  [ "$okall" = 1 ] || die "Deploy did not pass the health check. Diagnose: $CLI_NAME status / $CLI_NAME logs windmill_server"

  write_version "$ver"

  # --- Harden -------------------------------------------------------------
  local adminpass=""
  if [ "$do_harden" = 1 ]; then
    log ""
    step "Harden: set Base URL and admin password"
    adminpass=$(gen_password 28)
    harden_instance "$ver" "$adminpass" || warn "Hardening did not fully succeed; you can run $CLI_NAME credentials later"
  fi

  if [ "$do_systemd" = 1 ]; then
    log ""
    step "Install systemd timers"
    cmd_systemd install || warn "systemd install did not succeed (can retry later)"
  fi

  # --- Report -------------------------------------------------------------
  hr
  ok "Deploy complete"
  log "  Version      : $ver"
  log "  Entry        : $(instance_url)"
  log "  Migrations   : $(migration_count || echo '?')"
  log "  Probed version: $(probe_version)"
  log "  Directory    : $WM_DIR"
  hr
  log "${C_BOLD}Login credentials${C_RESET}"
  log "  URL     : $(instance_url)"
  log "  Account : admin@windmill.dev"
  if [ -n "$adminpass" ]; then
    log "  Password: ${C_BOLD}${adminpass}${C_RESET}"
  else
    log "  Password: ${C_BOLD}changeme${C_RESET}  ${C_YELLOW}(default password, not hardened; change it ASAP)${C_RESET}"
  fi
  log "  Database: postgres / $(get_env POSTGRES_PASSWORD)"
  log "  ${C_DIM}Credentials also written to $WM_DIR/CREDENTIALS.txt (chmod 600)${C_RESET}"
  hr
  log "Common commands: $CLI_NAME status | $CLI_NAME backup --full | $CLI_NAME check"
  hr

  if [ "$do_harden" = 1 ] && [ -n "$adminpass" ]; then
    {
      echo "# Windmill credentials  $(ts)"
      echo "URL=$(instance_url)"
      echo "ADMIN_USER=admin@windmill.dev"
      echo "ADMIN_PASSWORD=$adminpass"
      echo "DB_USER=postgres"
      echo "DB_PASSWORD=$(get_env POSTGRES_PASSWORD)"
      echo "VERSION=$ver"
    } > "$WM_DIR/CREDENTIALS.txt"
    chmod 0600 "$WM_DIR/CREDENTIALS.txt"
  fi
}

# Set Base URL + rotate the admin password
# API pitfalls: /api/auth/login returns a [bare token] (text/plain), not JSON;
#              the change-password endpoint is setpassword (set_password is 404);
#              the base_url body must be {"value":"..."}; a bare string returns 422.
harden_instance() {
  local ver="$1" newpass="$2"
  local host base token code

  host=$(primary_ip)
  [ -n "$host" ] || { warn "Cannot determine the local IP; skipping Base URL setup"; return 1; }
  base=$(instance_url)

  token=$(wm_login changeme)
  [ -n "$token" ] || token=$(wm_login "")
  [ -n "$token" ] || { warn "Cannot log in (the password may no longer be default); skipping hardening"; return 1; }

  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
    -X POST "http://127.0.0.1/api/settings/global/base_url" \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "{\"value\":\"${base}\"}" 2>/dev/null || echo 000)
  local got; got=$(qval "select value::text from global_settings where name='base_url'" || true)
  if [ "$code" = "200" ] && [ -n "$got" ]; then
    ok "  Base URL = $got"
  else
    warn "  Base URL setup returned HTTP ${code}; value in DB='${got:-<empty>}'"
  fi

  # Change the password last; once changed, the old token is invalidated
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
    -X POST "http://127.0.0.1/api/users/setpassword" \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "{\"password\":\"${newpass}\"}" 2>/dev/null || echo 000)
  if [ "$code" = "200" ]; then
    if [ -n "$(wm_login "$newpass")" ]; then
      ok "  admin password rotated (the new password works)"
    else
      warn "  Password API returned 200 but the new password login failed; please check manually"
      return 1
    fi
    local oldcode
    oldcode=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
      -X POST "http://127.0.0.1/api/auth/login" -H 'Content-Type: application/json' \
      -d '{"email":"admin@windmill.dev","password":"changeme"}' 2>/dev/null || echo 000)
    [ "$oldcode" = "200" ] && warn "  Default password 'changeme' is still usable (unexpected)" || ok "  Default password no longer works"
  else
    warn "  Password change failed (HTTP ${code}); admin password is still changeme"
    return 1
  fi
  return 0
}

# Log in and return the bare token (the response body itself is the token; do not parse as JSON)
wm_login() {
  local pw="$1" t=""
  t=$(curl -s --max-time 12 -X POST "http://127.0.0.1/api/auth/login" \
        -H 'Content-Type: application/json' \
        -d "{\"email\":\"admin@windmill.dev\",\"password\":\"${pw}\"}" 2>/dev/null \
      | tr -d '\r\n' || true)
  case "$t" in *'{'*|*'error'*|*'Unauthorized'*) t="" ;; esac
  printf '%s' "$t"
}

# =============================================================================
# Command: deploy — rebuild the deploy (containers / snapshot restore)
# =============================================================================
cmd_deploy() {
  local mode="auto" src="" core=0 sql_raw=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)       mode="restore"; src="${2:-}"; shift 2 ;;
      --from-daily) mode="daily";   shift; if [ -n "${1:-}" ] && [ "${1#--}" = "$1" ]; then src="$1"; shift; fi ;;   # optionally takes a specific backup file path
      --recreate)   mode="recreate"; shift ;;
      --core-only)  core=1; shift ;;
      -y|--yes)     ASSUME_YES=1; shift ;;   # restore internally calls this command with --yes
      -h|--help)    help_deploy; exit 0 ;;
      *)            usage_die "deploy: unknown argument $1" ;;
    esac
  done

  require_ready
  wm_paths

  local miss; miss=$(config_missing)
  local vol; vol=$(db_volume 2>/dev/null || true)
  local vol_ok=0; volume_has_cluster "$vol" && vol_ok=1
  local snap; snap=$(latest_snapshot)
  local daily; daily=$(latest_daily_backup)

  [ -n "$src" ] || true
  case "$mode" in
    restore) [ -n "$src" ] || src="$snap" ;;
    daily)   [ -n "$src" ] || src="$daily" ;;
  esac

  if [ "$mode" = "auto" ]; then
    if [ -n "$miss" ]; then
      # Config incomplete: backfill from a snapshot
      if [ -n "$snap" ]; then mode="restore"; src="$snap"
      else die "Config missing (${miss}) and no usable snapshot. Use $CLI_NAME init for a fresh deploy."; fi
    elif [ "$vol_ok" = 1 ]; then mode="recreate"
    elif [ -n "$snap" ]; then mode="restore"; src="$snap"
    elif [ -n "$daily" ]; then mode="daily"; src="$daily"
    else die "No data volume, no snapshot, no daily backup. Use $CLI_NAME init for a fresh deploy."
    fi
  fi

  hr
  log "${C_BOLD}Windmill rebuild${C_RESET}"
  log "  Directory     : $WM_DIR"
  log "  Mode          : $mode"
  log "  Data volume   : ${vol:-<none>}$( [ "$vol_ok" = 1 ] && echo "  (has a postgres cluster)" || echo "" )"
  log "  Config complete: $( [ -z "$miss" ] && echo 'complete' || echo "missing:$miss" )"
  if [ -n "$src" ]; then log "  Restore source: $src"; fi
  log "  Startup scope : $( [ "$core" = 1 ] && echo 'db + server only (drill)' || echo 'all services' )"
  hr

  acquire_lock
  mkdir -p "$BACKUP_DIR" "$LOG_DIR"

  # --- Config backfill -----------------------------------------------------
  if [ -n "$miss" ]; then
    [ -n "$snap" ] || die "Config missing and no snapshot to backfill from"
    step "Backfill config from snapshot ($snap)"
    for f in docker-compose.yml Caddyfile .env; do
      case " $miss " in *" $f "*)
        [ -f "$snap/$f" ] || die "Snapshot is also missing ${f}; cannot backfill"
        cp -a "$snap/$f" "$WM_DIR/$f"
        info "  <- $f"
        ;;
      esac
    done
    chmod 0600 "$ENV_FILE"
  fi
  if [ -f "$ENV_FILE" ]; then
    local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"
  fi
  docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" config >/dev/null 2>&1 \
    || die "compose config parse failed"

  local target; target=$(env_version)

  case "$mode" in
    recreate)
      step "Rebuild containers (keeping the data volume)"
      crun stack_up_staged "$( [ "$core" = 1 ] && echo 'windmill_server' || echo '' )" || die "Startup failed"
      ;;
    restore|daily)
      [ -n "$src" ] && [ -d "$src" ] || [ -f "$src" ] || die "Restore source does not exist: $src"

      if [ "$mode" = "daily" ]; then
        [ -f "$src" ] || die "Daily backup not found: $src"
        step "Decompress the daily backup"
        sql_raw="/tmp/wm-deploy-restore-$$.sql"
        gunzip -c "$src" > "$sql_raw" || die "Decompress failed: $src"
      else
        sql_raw="$src/cluster.sql"
        if [ -f "$src/cluster.sql.sha256" ]; then
          ( cd "$src" && sha256sum -c cluster.sql.sha256 >/dev/null ) || die "Snapshot sha256 verification failed"
          info "  Snapshot sha256 verified"
        fi
      fi
      verify_dump_file "$sql_raw" || die "dump is incomplete; refusing to restore"

      step "Stop the current stack (keep volumes)"
      crun compose down --remove-orphans >/dev/null 2>&1 || true

      step "Remove the database volume"
      local v; v=$(db_volume)
      if [ -n "$v" ]; then
        crun docker volume rm -f "$v" >/dev/null 2>&1 || true
        if [ "$DRY_RUN" != 1 ] && docker volume inspect "$v" >/dev/null 2>&1; then
          die "Volume $v still exists (may be in use). Run \`$CLI_NAME down\` first, then retry."
        fi
        info "  Volume ${v} removed"
      fi

      step "Start the database"
      crun compose up -d --no-deps db || die "Database failed to start"
      wait_db || warn "db did not become healthy; continuing"

      step "Restore the data"
      restore_cluster_from "$sql_raw" "$LOG_DIR/deploy-restore-$(date +%Y%m%d-%H%M%S).log" \
        || die "Restore failed; see $LOG_DIR/"
      sync_db_password || true
      refresh_planner_stats

      step "Start the stack in stages"
      crun stack_up_staged "$( [ "$core" = 1 ] && echo 'windmill_server' || echo '' )" || die "Startup failed"

      if [ "$mode" = "daily" ]; then rm -f "${sql_raw:-}"; fi
      ;;
  esac

  # --- Health check -----------------------------------------------------
  local okall=1
  if [ -n "$target" ]; then wait_version "$target" || okall=0; fi
  if [ "$core" != 1 ]; then
    all_running || okall=0
    wm_port_listening || { warn "Entry port $HTTP_PORT is not listening"; okall=0; }
  fi

  [ "$okall" = 1 ] || die "Rebuild did not pass the health check. Diagnose: $CLI_NAME status"
  if [ -n "$target" ]; then
    write_version "$target"
    hr; ok "Rebuild complete, version $target"; hr
  else
    hr; ok "Rebuild complete"; hr
  fi
}

# =============================================================================
# Command: destroy — tear down the deploy
# =============================================================================
cmd_destroy() {
  local all=0 purge_images=0 keep_backups=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)          all=1; purge_images=1; shift ;;
      --purge-images) purge_images=1; shift ;;
      --keep-backups) keep_backups=1; shift ;;
      -h|--help)      help_destroy; exit 0 ;;
      *)              usage_die "destroy: unknown argument $1" ;;
    esac
  done

  require_ready
  wm_paths

  local proj; proj=$(project_name)
  local vols; vols=$(project_volumes)
  local nsnap ndaily
  nsnap=$(snapshot_list | wc -l)
  ndaily=$(count_files "$BACKUP_DIR"/daily/cluster-*.sql.gz)

  hr
  warn "About to tear down the Windmill deploy"
  hr
  log "  Deploy dir     : $WM_DIR"
  log "  compose project : $proj"
  log "  Containers      : $( { compose ps -a -q 2>/dev/null || true; } | wc -l )"
  log "  Data volumes    :"
  [ -n "$vols" ] && printf '%s\n' "$vols" | sed 's/^/      /' || log "      <none>"
  log "  Full snapshots  : $nsnap"
  log "  Daily backups   : $ndaily"
  log "  systemd         : $( [ -f /etc/systemd/system/windmill-stack.service ] && echo 'installed (will be stopped and removed)' || echo '<not installed>' )"
  log "  Images          : $( [ "$purge_images" = 1 ] && echo 'will remove windmill/postgres/caddy related' || echo 'kept' )"
  log "  Backups         : $( [ "$all" = 1 ] && echo 'will be deleted entirely, unrecoverable' || { [ "$keep_backups" = 1 ] && echo 'moved to $AIBOX_HOME/backups/ (or /var/backups if no HOME)' || echo 'moved to $AIBOX_HOME/backups/ (or /var/backups if no HOME)'; } )"
  hr
  warn "Once the database volume is deleted, all workflows, scripts, and run records in it are permanently lost."
  hr

  confirm "Confirm teardown?" || exit 0

  # --- systemd --------------------------------------------------------------
  step "1/5 Stop systemd units"
  for u in "${SYSTEMD_UNITS[@]}"; do
    if [ -f "/etc/systemd/system/$u" ]; then
      crun systemctl disable --now "$u" >/dev/null 2>&1 || true
      crun rm -f "/etc/systemd/system/$u"
      info "  Removed $u"
    fi
  done
  crun systemctl daemon-reload >/dev/null 2>&1 || true
  crun systemctl reset-failed 'windmill-*' >/dev/null 2>&1 || true

  # --- Backups --------------------------------------------------------------
  if [ "$all" = 1 ]; then
    step "2/5 Delete all backups"
    crun rm -rf "$BACKUP_DIR"
    info "  $BACKUP_DIR deleted"
  else
    step "2/5 Move backups outside the deploy dir"
    evacuate_backups || warn "Backup evacuation failed; continuing to delete the deploy dir"
  fi

  # --- Containers and volumes ----------------------------------------------
  step "3/5 Stop and remove containers (including data volumes)"
  if [ -f "$COMPOSE_FILE" ]; then
    crun compose down --volumes --remove-orphans || warn "compose down returned non-zero; continuing"
  fi
  # Fallback when the compose file is gone: clean up by label
  if [ "$DRY_RUN" != 1 ]; then
    local leftover
    leftover=$(docker ps -aq --filter "label=com.docker.compose.project=${proj}" 2>/dev/null || true)
    [ -n "$leftover" ] && docker rm -f $leftover >/dev/null 2>&1 || true
    for v in $(docker volume ls --filter "label=com.docker.compose.project=${proj}" --format '{{.Name}}' 2>/dev/null); do
      docker volume rm -f "$v" >/dev/null 2>&1 || true
    done
  fi
  info "  Leftover containers: $( { docker ps -a --filter "label=com.docker.compose.project=${proj}" -q 2>/dev/null || true; } | wc -l )"

  # --- Images ---------------------------------------------------------------
  if [ "$purge_images" = 1 ]; then
    step "4/5 Remove images"
    local imgs
    imgs=$(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null \
      | grep -E 'windmill-labs/(windmill|windmill-extra|caddy-l4)|^postgres:' || true)
    if [ -n "$imgs" ]; then
      if [ "$DRY_RUN" = 1 ]; then
        printf '%s\n' "$imgs" | sed 's/^/  Would remove /'
      else
        # shellcheck disable=SC2086
        docker rmi -f $imgs >/dev/null 2>&1 || true
        printf '%s\n' "$imgs" | sed 's/^/  Removed /'
      fi
    else
      info "  No matching images"
    fi
  else
    step "4/5 Images kept (add --purge-images to remove them)"
  fi

  # --- Directory ------------------------------------------------------------
  step "5/5 Remove the deploy dir"
  crun rm -rf "$WM_DIR"
  info "  $WM_DIR deleted"

  # --- Report ---------------------------------------------------------------
  hr
  ok "Teardown complete"
  log "  Leftover containers: $( { docker ps -a --filter "label=com.docker.compose.project=${proj}" -q 2>/dev/null || true; } | wc -l )"
  log "  Leftover volumes    : $( { docker volume ls --filter "label=com.docker.compose.project=${proj}" -q 2>/dev/null || true; } | wc -l )"
  log "  Directory           : $( [ -d "$WM_DIR" ] && echo 'still present' || echo 'removed' )"
  log ""
  log "  Re-deploy: $CLI_NAME init"
  hr
}

# =============================================================================
# Command: up / down
# =============================================================================
cmd_up() {
  local core=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --core-only) core=1; shift ;;
      -h|--help)   help_up; exit 0 ;;
      *)           usage_die "up: unknown argument $1" ;;
    esac
  done
  require_ready
  wm_paths
  [ -f "$COMPOSE_FILE" ] || die "${COMPOSE_FILE} not found. Run $CLI_NAME init or $CLI_NAME deploy first."

  acquire_lock
  local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"

  hr; log "${C_BOLD}Start / reconcile stack${C_RESET}  $(ts)"; hr
  crun stack_up_staged "$( [ "$core" = 1 ] && echo 'windmill_server' || echo '' )" \
    || { warn "Startup failed"; compose ps -a --format '{{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null | sort; exit 1; }

  compose ps --format '{{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null | sort | sed 's/^/  /' || true
  if [ "$core" = 1 ]; then
    ok "core services started (db + server)"; exit 0
  fi
  if all_running && wm_port_listening; then
    ok "stack is fully ready   version $(probe_version)"
    append_log stack-boot.log "stack is fully ready, version $(probe_version)"
    exit 0
  fi
  warn "Some services are not ready; see the list above"
  exit 1
}

cmd_down() {
  local keep_caddy=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help_down; exit 0 ;;
      *)         usage_die "down: unknown argument $1" ;;
    esac
  done
  require_ready
  wm_paths
  [ -f "$COMPOSE_FILE" ] || die "$COMPOSE_FILE not found"

  hr; warn "Stop the stack (data volumes are kept)"; hr
  confirm "Confirm stop?" || exit 0
  crun compose down --remove-orphans || die "compose down failed"
  ok "Stopped. Data volumes are kept; restart with: $CLI_NAME up"
}

# =============================================================================
# Command: status — service and resource overview
# =============================================================================
cmd_status() {
  require_docker
  wm_paths

  if [ ! -f "$COMPOSE_FILE" ]; then
    warn "No deploy found ($COMPOSE_FILE does not exist)"
    log "  Fresh deploy: $CLI_NAME init"
    exit 3
  fi
  local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"

  hr
  log "${C_BOLD}Windmill status${C_RESET}   $WM_DIR   $(ts)"
  hr

  log "${C_BOLD}Containers${C_RESET}"
  local running total
  running=$( { compose ps -q 2>/dev/null || true; } | wc -l )
  total=$( { compose ps -a -q 2>/dev/null || true; } | wc -l )
  compose ps -a --format '{{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null \
    | sort | awk -F'\t' '{printf "  %-22s %-10s %s\n", $1, $2, $3}' || true
  log "  -- running ${running} / total ${total}"

  log ""
  log "${C_BOLD}Services${C_RESET}"
  printf '  %-14s %s\n' "Deploy version" "$(current_version)  ${C_DIM}(.env: $(env_version))${C_RESET}"
  printf '  %-14s %s\n' "Self-reported" "$(probe_version)"
  printf '  %-14s %s\n' "Entry(:${HTTP_PORT})" "$(wm_port_listening && echo "${C_GREEN}listening${C_RESET}" || echo "${C_RED}not listening${C_RESET}")"
  printf '  %-14s HTTP %s\n' "UI" "$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://127.0.0.1:${HTTP_PORT}/" 2>/dev/null || echo 000)"
  printf '  %-14s %s\n' "Database" "$(db_healthy && echo "${C_GREEN}healthy${C_RESET}" || echo "${C_YELLOW}not healthy${C_RESET}")"
  printf '  %-14s %s\n' "Base URL" "$(qval "select value::text from global_settings where name='base_url'")"

  if db_healthy; then
    log ""
    log "${C_BOLD}Data${C_RESET}"
    printf '  %-14s %s\n' "Migrations" "$(migration_count)"
    printf '  %-14s %s\n' "Users" "$(qval 'select count(*) from password')"
    printf '  %-14s %s\n' "Workspaces" "$(qval 'select count(*) from workspace')"
    printf '  %-14s %s\n' "Scripts" "$(qval 'select count(*) from script')"
    printf '  %-14s %s\n' "RLS policies" "$(qval 'select count(*) from pg_policies')"
  fi

  log ""
  log "${C_BOLD}Backups${C_RESET}"
  local nsnap ndaily sz
  nsnap=$(snapshot_list | wc -l)
  ndaily=$(count_files "$BACKUP_DIR"/daily/cluster-*.sql.gz)
  sz=$(du -sh "$BACKUP_DIR" 2>/dev/null | cut -f1 || true)
  printf '  %-14s %s\n' "Full snapshots" "$nsnap"
  printf '  %-14s %s\n' "Daily backups" "$ndaily"
  printf '  %-14s %s\n' "Footprint" "${sz:-0}"
  local lastsnap; lastsnap=$(latest_snapshot)
  if [ -n "$lastsnap" ]; then printf '  %-14s %s\n' "Latest snapshot" "$(basename "$lastsnap")  ${C_DIM}(version $(sed -n 's/^WM_VERSION=//p' "$lastsnap/meta.env" 2>/dev/null | head -1))${C_RESET}"; fi

  log ""
  log "${C_BOLD}Resources${C_RESET}"
  printf '  %-14s %s\n' "Disk" "$(df -h / | tail -1 | awk '{print $3" used / "$2" total, "$4" free ("$5")"}')"
  printf '  %-14s %s\n' "Memory" "$(mem_used_h)"
  printf '  %-14s %s\n' "Images" "$(docker system df --format '{{.Type}} {{.Size}}' 2>/dev/null | awk '$1=="Images"{print $2}')"

  log ""
  log "${C_BOLD}Scheduled tasks${C_RESET}"
  if [ "$OS_KIND" = "Darwin" ]; then
    log "  ${C_DIM}<macOS uses launchd; this CLI's launchd adapter is not yet implemented>${C_RESET}"
  elif [ -f /etc/systemd/system/windmill-backup.timer ]; then
    systemctl --no-pager list-timers 'windmill-*' --no-legend 2>/dev/null \
      | awk '{printf "  %-18s next %s %s %s\n", $NF, $1, $2, $3}' || true
    printf '  %-18s %s\n' "stack boot alignment" "$(systemctl is-enabled windmill-stack.service 2>/dev/null)/$(systemctl is-active windmill-stack.service 2>/dev/null)"
  else
    log "  ${C_DIM}<not installed; run $CLI_NAME systemd install>${C_RESET}"
  fi
  hr
}

# =============================================================================
# Command: doctor — environment self-check
# =============================================================================
cmd_doctor() {
  wm_paths
  local fail=0
  hr
  log "${C_BOLD}Environment self-check${C_RESET}  $(ts)"
  hr

  chk() {  # chk <description> <0/1 pass> [hint]
    if [ "$2" = 1 ]; then printf '  %s✔%s %-30s %s\n' "$C_GREEN" "$C_RESET" "$1" "${3:-}"
    else printf '  %s✘%s %-30s %s\n' "$C_RED" "$C_RESET" "$1" "${3:-}"; fail=$((fail+1)); fi
  }

  [ "$(id -u)" = 0 ] && chk "root privileges" 1 || chk "root privileges" 0 "sudo required"
  command -v docker >/dev/null 2>&1 && chk "docker command" 1 "$(docker --version 2>/dev/null | cut -d, -f1)" || chk "docker command" 0 "not installed"
  docker info >/dev/null 2>&1 && chk "docker daemon" 1 || chk "docker daemon" 0 "not running or no access"
  docker compose version >/dev/null 2>&1 && chk "docker compose v2" 1 "$(docker compose version --short 2>/dev/null)" || chk "docker compose v2" 0 "plugin missing"
  if command -v flock >/dev/null 2>&1; then
    chk "concurrency lock" 1 "flock"
  elif [ "$OS_KIND" = "Darwin" ]; then
    chk "concurrency lock" 1 "mkdir atomic lock (macOS fallback)"
  else
    chk "concurrency lock" 0 "flock missing (util-linux)"
  fi
  if [ -r "$WM_CONF_FILE" ]; then
    chk "host-level config" 1 "$WM_CONF_FILE"
  else
    chk "host-level config" 1 "not configured (${WM_CONF_FILE} does not exist; built-in defaults apply)"
  fi
  command -v python3 >/dev/null 2>&1 && chk "python3" 1 "$(python3 --version 2>&1 | cut -d' ' -f2)" || chk "python3" 0 "needed to parse the compose config"

  local fg; fg=$(free_gb); fg="${fg:-0}"
  [ "$fg" -ge "$MIN_FREE_GB" ] && chk "Free disk >= ${MIN_FREE_GB}G" 1 "${fg}G" \
    || chk "Free disk >= ${MIN_FREE_GB}G" 0 "only ${fg}G; an upgrade needs room for both the old and new images"

  # Entry port: only count non-docker process usage
  if wm_port_listening; then
    chk "Entry port ${HTTP_PORT}" 1 "already listening (service running)"
  else
    chk "Entry port ${HTTP_PORT}" 1 "free"
  fi

  # Host port 25: exim4 and similar occupying it would make caddy's email-trigger
  # mapping fail. The compose generated by this CLI has already removed the 25
  # mapping; this is an informational hint only.
  local p25=""
  if port_listening 25; then
    chk "Host port 25" 1 "already in use (compose has removed the 25 mapping; no action needed)"
  fi

  local px; px=$(proxy_env)
  if https_proxy="$px" http_proxy="$px" curl -fsS -o /dev/null --max-time 12 https://api.github.com/ 2>/dev/null; then
    chk "Proxy reachable ${px}" 1
  else
    chk "Proxy reachable ${px}" 0 "check/upgrade version queries will fail (use --proxy to specify)"
  fi

  # ghcr registry mirror: direct ghcr.io from China measures ~0.5MB/s, and a fresh
  # deploy has to pull ~6GiB.
  # Note: do not use `docker manifest inspect` to probe a third-party mirror — its
  # auth handshake differs from the registry v2 spec, so docker falsely reports
  # "not found", but `docker pull` actually works. Here we only probe the /v2/
  # endpoint: both 200 (public) and 401 (auth required) count as reachable.
  mirror_probe() {
    local label="$1" m="$2" hint="$3" murl mcode
    if [ -z "$m" ]; then chk "$label" 1 "$hint"; return 0; fi
    murl=$(mirror_url "$m")
    mcode=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${murl}/v2/" 2>/dev/null || echo 000)
    case "$mcode" in
      200|401) chk "$label" 1 "$m" ;;
      *)       chk "$label" 0 "${m} -> ${mcode}; will fall back to direct (slow; a black-hole mirror also hangs)" ;;
    esac
    return 0
  }
  mirror_probe "ghcr registry mirror"     "${WM_GHCR_MIRROR:-}" "not set (not required); prefer configuring an HTTP proxy for the docker daemon, then --ghcr-mirror"
  mirror_probe "docker.io registry mirror" "${WM_HUB_MIRROR:-}"  "not set; left to the daemon's registry-mirrors (risk of black-hole mirrors)"

  # docker daemon's HTTP proxy — the most effective speedup measured in this env.
  # After configuring a host proxy for the daemon, direct ghcr.io went from 2.4KB/s
  # to 66MB/s (a 3.98GB image pulled in 50s). Mirrors are a fallback; the proxy is
  # the primary choice.
  local dpx
  dpx=$(docker info 2>/dev/null | awk -F': ' '/HTTP Proxy/{print $2; exit}')
  if [ -n "$dpx" ]; then
    chk "daemon HTTP proxy" 1 "$dpx"
  else
    chk "daemon HTTP proxy" 1 "not set; direct ghcr.io from China is ~0.5MB/s; consider configuring a proxy or a mirror for the daemon"
  fi

  if docker manifest inspect "${WM_REPO}:latest" >/dev/null 2>&1; then
    chk "ghcr.io image pullable" 1
  else
    chk "ghcr.io image pullable" 0 "direct unreachable; if a mirror is configured this can be ignored"
  fi

  if [ -f "$COMPOSE_FILE" ]; then
    if docker compose --project-directory "$WM_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" config >/dev/null 2>&1; then
      chk "compose config parses" 1
    else
      chk "compose config parses" 0 "run $CLI_NAME deploy to rebuild, or check $ENV_FILE"
    fi
    chk "Deploy directory" 1 "${WM_DIR} (version $(current_version))"
  else
    chk "Deploy directory" 1 "${WM_DIR} (not yet deployed)"
  fi

  # Database: shared mode probes aibox-base-postgres's pg_isready; standalone mode
  # probes the local db healthcheck. Both converge on db_healthy(); doctor/status/
  # upgrade/backup share this judgment.
  if db_healthy; then
    chk "Database" 1 "$(shared_pg_active && printf 'shared %s' "${SHARED_PG_CONTAINER}" || printf 'local db healthy')"
  else
    chk "Database" 0 "$(shared_pg_active && printf '%s unreachable' "${SHARED_PG_CONTAINER}" || printf 'local db not healthy')"
  fi

  if [ -f /etc/systemd/system/windmill-backup.timer ]; then
    local en; en=$(systemctl is-enabled windmill-backup.timer 2>/dev/null || echo unknown)
    chk "systemd scheduled tasks" 1 "$en"
  else
    chk "systemd scheduled tasks" 1 "not installed (${CLI_NAME} systemd install)"
  fi

  hr
  if [ "$fail" = 0 ]; then ok "Self-check passed; environment ready"; else err "$fail item(s) did not pass; see above"; fi
  hr
  [ "$fail" = 0 ] || exit 3
}

# =============================================================================
# Command: check — check the upstream for a new version
# =============================================================================
cmd_check() {
  wm_paths
  [ -f "$ENV_FILE" ] || { warn "No deploy found"; exit 2; }
  local px; px=$(get_env WM_PROXY); PROXY_URL="${px:-$PROXY_URL}"

  local cur latest scope
  cur=$(current_version)
  log "Current deploy version: ${cur:-unknown}"

  latest=$(latest_version)
  if [ -z "$latest" ]; then
    warn "Cannot fetch the upstream latest version (proxy: $(proxy_env))"
    warn "  Verify manually: https_proxy=$(proxy_env) curl -sS https://api.github.com/repos/windmill-labs/windmill/releases/latest"
    append_log update-check.log "Query failed (proxy $(proxy_env) unreachable)"
    exit 2
  fi
  log "Upstream latest version: ${latest}"

  if [ "$latest" = "$cur" ]; then
    ok "Already on the latest version"
    append_log update-check.log "already latest ($cur)"
    exit 0
  fi

  if [ "${cur%.*}" = "${latest%.*}" ]; then
    scope="patch-level (within ${cur%.*}.x)"
  else
    scope="feature-level (cross minor/major) — review the release notes first"
  fi

  hr
  ok "New version available: ${cur} -> ${latest}   [${scope}]"
  log ""
  log "Upgrade command (requires manual confirmation):"
  log "    $CLI_NAME upgrade ${latest}"
  log ""
  log "Before upgrading, confirm no long tasks are running (the worker's 30s hard-kill limit will interrupt timed-out tasks)."
  hr
  append_log update-check.log "New version found ${cur} -> ${latest} [${scope}]"
  exit 10
}

# =============================================================================
# Command: upgrade — lossless upgrade (with automatic rollback)
# =============================================================================
U_OLD_VER=""; U_OLD_IMG=""; U_OLD_EXTRA=""; U_ROLLED_BACK=0; U_BK=""; U_TARGET=""

cmd_upgrade() {
  local target="" do_check=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check|-c) do_check=1; shift ;;
      --ghcr-mirror) WM_GHCR_MIRROR="${2:-}"; shift 2 ;;
      --hub-mirror)  WM_HUB_MIRROR="${2:-}"; shift 2 ;;
      -h|--help)  help_upgrade; exit 0 ;;
      -*)         usage_die "upgrade: unknown argument $1" ;;
      *)          target="${1#v}"; shift ;;
    esac
  done
  if [ "$do_check" = 1 ]; then cmd_check; exit $?; fi

  require_ready
  wm_paths
  [ -f "$COMPOSE_FILE" ] || die "No deploy found. Use $CLI_NAME init to create one."
  local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"
  local px; px=$(get_env WM_PROXY); PROXY_URL="${px:-$PROXY_URL}"
  local mm; mm=$(get_env WM_GHCR_MIRROR); WM_GHCR_MIRROR="${mm:-$WM_GHCR_MIRROR}"
  local hmm; hmm=$(get_env WM_HUB_MIRROR); WM_HUB_MIRROR="${hmm:-$WM_HUB_MIRROR}"

  mkdir -p "$LOG_DIR" "$BACKUP_DIR"
  acquire_lock

  # --- Infer the current version from "the running container" -------------------
  # Do not read .env: it may already be preset to the target version, which would
  # mis-tag the [new] image as rollback-<old-version>.
  local c_cid e_cid
  c_cid=$(server_cid || true)
  if [ -n "$c_cid" ]; then
    U_OLD_IMG=$(docker inspect "$c_cid" --format '{{.Config.Image}}' 2>/dev/null || true)
    U_OLD_VER=$(parse_version "$(probe_version)")
    if [ -z "$U_OLD_VER" ]; then
      U_OLD_VER=$(parse_version "$(docker exec "$c_cid" /usr/local/bin/windmill --version 2>/dev/null | tail -1 || true)")
    fi
  fi
  e_cid=$(extra_cid || true)
  [ -n "$e_cid" ] && U_OLD_EXTRA=$(docker inspect "$e_cid" --format '{{.Config.Image}}' 2>/dev/null || true)

  U_OLD_VER="${U_OLD_VER:-$(current_version)}"
  U_OLD_IMG="${U_OLD_IMG:-$(get_env WM_IMAGE)}"
  U_OLD_EXTRA="${U_OLD_EXTRA:-$(get_env WM_EXTRA_IMAGE)}"

  hr
  log "${C_BOLD}Lossless upgrade${C_RESET}  $(ts)"
  log "  Running version : ${U_OLD_VER}  $( [ -n "$c_cid" ] && echo "${C_DIM}(probed from the running container)${C_RESET}" || echo "${C_YELLOW}(container not running; using the VERSION file)${C_RESET}" )"
  log "  Running image   : ${U_OLD_IMG}"
  log "  extra image     : ${U_OLD_EXTRA}"
  hr

  if [ -z "$target" ]; then
    log "No version specified; querying the upstream latest release ..."
    target=$(latest_version)
    [ -n "$target" ] || die "Cannot query the upstream latest version. Specify: $CLI_NAME upgrade 1.812.0"
  fi
  U_TARGET="${target#v}"
  local new_img="${WM_REPO}:${U_TARGET}"
  local new_extra="${WM_EXTRA_REPO}:${U_TARGET}"
  log "  Target version  : ${U_TARGET}"
  if [ "$U_TARGET" = "$U_OLD_VER" ]; then log "  ${C_DIM}(same as the current version; will run one rebuild/reconcile)${C_RESET}"; fi

  # --- 1. Pre-flight checks ------------------------------------------------
  step "[1/6] Pre-flight checks"
  require_free_space
  require_image "$new_img"
  require_image "$new_extra"
  db_healthy || die "The database is not healthy; fix it before upgrading"
  info "  Database healthy"

  # --- 2. Full snapshot ----------------------------------------------------
  step "[2/6] Full snapshot (cannot be skipped)"
  U_BK=$(new_backup_dir)
  make_backup "$U_BK" || die "Backup failed; upgrade aborted (no changes made)"

  # --- 3. Pin the old image as a rollback-able tag -----------------------
  step "[3/6] Pin the old image"
  if [ "$U_OLD_VER" != "unknown" ] && [ -n "$U_OLD_IMG" ]; then
    docker tag "$U_OLD_IMG" "${WM_REPO}:rollback-${U_OLD_VER}" 2>/dev/null \
      && info "  -> ${WM_REPO}:rollback-${U_OLD_VER}" || warn "  Tagging $U_OLD_IMG failed"
    if [ -n "$U_OLD_EXTRA" ]; then
      docker tag "$U_OLD_EXTRA" "${WM_EXTRA_REPO}:rollback-${U_OLD_VER}" 2>/dev/null \
        && info "  -> ${WM_EXTRA_REPO}:rollback-${U_OLD_VER}" || warn "  Tagging $U_OLD_EXTRA failed"
    fi
  fi

  # --- 4. Drain workers ---------------------------------------------------
  step "[4/6] Drain workers (in-flight tasks continue; upstream hard-kill limit 30s)"
  crun compose stop windmill_worker windmill_worker_native || warn "Stopping workers returned non-zero; continuing"

  # --- 5. Switch version + pull + start -----------------------------------
  step "[5/6] Switch version and pull images (the UI stays up during this phase)"
  crun set_env WM_IMAGE "$new_img"
  crun set_env WM_EXTRA_IMAGE "$new_extra"
  # Under mirror mode the exact version number is needed to assemble the image
  # address; if it cannot be obtained, fall back to compose's native pull
  local tver; tver=$(image_version "$new_img"); tver="${tver:-}"
  pull_images "$tver" || { upgrade_rollback "Image pull failed"; exit 1; }
  crun stack_up_staged || { upgrade_rollback "Staged startup failed"; exit 1; }

  # --- 6. Health check ----------------------------------------------------
  step "[6/6] Health check (up to ${HEALTH_TIMEOUT}s)"
  local hok=1 errs=""
  wait_version "$U_TARGET" || hok=0
  [ "$hok" = 1 ] && { all_running || hok=0; }
  if [ "$hok" = 1 ] && ! wm_port_listening; then
    warn "Entry port ${HTTP_PORT} is not listening (caddy may not be up)"; hok=0
  fi
  if [ "$hok" = 1 ]; then
    errs=$(log_fatal)
    if [ -n "$errs" ]; then warn "server log has fatal errors:"; printf '%s\n' "$errs" >&2; hok=0; fi
  fi
  if [ "$hok" != 1 ]; then
    upgrade_rollback "Health check did not pass"
    exit 1
  fi

  # --- Success wrap-up ---------------------------------------------------
  local new_mig; new_mig=$(migration_count 2>/dev/null || echo "?")
  write_version "$U_TARGET"
  prune_backups 5
  case "$U_OLD_IMG" in
    *:main|*:latest)
      docker rmi "$U_OLD_IMG" >/dev/null 2>&1 \
        && info "  Removed the drifting old tag ${U_OLD_IMG} (image retained by rollback-${U_OLD_VER})" || true ;;
  esac

  hr
  ok "Upgrade succeeded"
  log "  ${U_OLD_VER}  ->  ${U_TARGET}"
  log "  Image          : $new_img"
  log "  Migrations     : $new_mig"
  log "  Probed version : $(probe_version)"
  log "  Rollback snapshot: $U_BK"
  log "  Rollback command: $CLI_NAME rollback"
  hr
}

# Automatic rollback on upgrade failure.
# Windmill's DB migrations are one-way and irreversible — once a new version
# has run its migrations, the old image cannot start on the migrated DB. So a
# rollback = swap back to the old image + restore the DB snapshot; both are required.
upgrade_rollback() {
  local reason="$1"
  if [ "$U_ROLLED_BACK" = 1 ]; then return 0; fi
  U_ROLLED_BACK=1
  hr >&2
  warn "============ Upgrade failed; starting automatic rollback ============"
  warn "Reason: $reason"
  warn "Snapshot: ${U_BK:-<none>}"
  hr >&2

  local rb_img="${WM_REPO}:rollback-${U_OLD_VER}" rb_extra="${WM_EXTRA_REPO}:rollback-${U_OLD_VER}"
  docker image inspect "$rb_img"   >/dev/null 2>&1 || rb_img="$U_OLD_IMG"
  docker image inspect "$rb_extra" >/dev/null 2>&1 || rb_extra="$U_OLD_EXTRA"
  warn "Rollback image: ${rb_img}"
  set_env WM_IMAGE "$rb_img"
  set_env WM_EXTRA_IMAGE "$rb_extra"

  local new_mig old_mig
  new_mig=$(migration_count 2>/dev/null || echo 0); new_mig="${new_mig:-0}"
  old_mig=$(sed -n 's/^MIGRATION_COUNT=//p' "$U_BK/meta.env" 2>/dev/null | tr -d '[:space:]' || true); old_mig="${old_mig:-0}"
  warn "Migration count: before upgrade ${old_mig} -> now ${new_mig}"

  if [ "$new_mig" != "$old_mig" ]; then
    warn "DB migrations have moved forward and are irreversible; the snapshot must be restored to return to the old version."
    if [ -z "$U_BK" ] || [ ! -s "$U_BK/cluster.sql" ]; then
      warn "❌ No usable snapshot; refusing to auto-restore the database! Manual intervention required."; return 1
    fi

    warn "Rollback 1/6: stop the whole stack (keep volumes)"
    compose down --remove-orphans || true

    warn "Rollback 2/6: remove the db data volume (original data backed up at ${U_BK}/cluster.sql)"
    local vol; vol=$(db_volume)
    if [ -n "$vol" ]; then
      docker volume rm -f "$vol" >/dev/null 2>&1 || true
      if docker volume inspect "$vol" >/dev/null 2>&1; then
        warn "❌ Volume ${vol} still exists (may be in use); aborting auto-restore to avoid restoring into the old DB."
        warn "   Run manually: docker compose down --remove-orphans && docker volume rm ${vol}"
        return 1
      fi
      info "  Volume $vol removed"
    fi

    warn "Rollback 3/6: rebuild the database with the old image"
    compose up -d --wait db || { warn "Database failed to start; manual intervention required! Snapshot: ${U_BK}"; return 1; }
    wait_db || warn "db did not become healthy; continuing the restore attempt"

    warn "Rollback 4/6: restore cluster.sql"
    restore_cluster_from "$U_BK/cluster.sql" "$U_BK/restore.log" \
      || warn "⚠️ The restore had issues; check $U_BK/restore.log"
    sync_db_password || warn "Cannot reset the postgres password; confirm DATABASE_URL matches the DB"

    warn "Rollback 5/6: rebuild planner stats"
    refresh_planner_stats
  else
    warn "DB migrations did not move forward (only the image layer changed); no DB restore needed."
  fi

  warn "Rollback 6/6: restart in stages with the old image"
  stack_up_staged || warn "Staged startup did not fully succeed; continuing to a final probe verdict"

  if wait_version "$U_OLD_VER"; then
    warn "✅ Rolled back to ${U_OLD_VER}; probe passed. Check before retrying the upgrade."
    append_log upgrade.log "Upgrade failed($reason); auto-rolled back to ${U_OLD_VER}"
    return 0
  fi
  warn "❌ Probe still failed after rollback; manual intervention required! Snapshot: ${U_BK}"
  append_log upgrade.log "Upgrade failed($reason); probe failed after rollback; manual intervention required"
  return 1
}

# =============================================================================
# Command: rollback
# =============================================================================
cmd_rollback() {
  local assume=0 images_only=0 list=0 args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes)      assume=1; shift ;;
      --images-only) images_only=1; shift ;;
      --list)        list=1; shift ;;
      -h|--help)     help_rollback; exit 0 ;;
      -*)            usage_die "rollback: unknown argument $1" ;;
      *)             args+=("$1"); shift ;;
    esac
  done

  wm_paths
  if [ "$list" = 1 ]; then
    hr; log "${C_BOLD}Available snapshots${C_RESET}  $BACKUP_DIR"; hr
    local d v m s
    for d in $(snapshot_list); do
      v=$(sed -n 's/^WM_VERSION=//p' "$d/meta.env" 2>/dev/null | head -1 || true)
      m=$(sed -n 's/^MIGRATION_COUNT=//p' "$d/meta.env" 2>/dev/null | head -1 || true)
      s=$(du -h "$d/cluster.sql" 2>/dev/null | cut -f1 || true)
      printf '  %-20s version=%-10s migrations=%-6s size=%s\n' "$(basename "$d")" "${v:-?}" "${m:-?}" "${s:-?}"
    done
    hr; log "Current deploy version: $(current_version)"; hr
    exit 0
  fi

  require_ready
  [ -f "$COMPOSE_FILE" ] || die "No deploy found"
  local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"
  acquire_lock

  local cur latest_bk bk target rb_img rb_extra
  cur=$(current_version)
  latest_bk=$(latest_snapshot)
  bk="${args[1]:-${latest_bk:-}}"
  target="${args[0]:-}"
  [ -n "$target" ] || target=$(sed -n 's/^WM_VERSION=//p' "$bk/meta.env" 2>/dev/null | head -1 | tr -d '[:space:]')
  [ -n "$target" ] || die "Cannot determine the target version. Usage: $CLI_NAME rollback <version> [snapshot]. List snapshots: $CLI_NAME rollback --list"

  rb_img="${WM_REPO}:rollback-${target}"
  rb_extra="${WM_EXTRA_REPO}:rollback-${target}"

  hr
  log "${C_BOLD}Rollback${C_RESET}"
  log "  Current version : $cur"
  log "  Target version  : $target"
  log "  Target image    : $rb_img"
  log "  Snapshot dir    : ${bk:-<none>}"
  log "  Mode             : $( [ "$images_only" = 1 ] && echo 'images only' || echo 'images + DB snapshot restore' )"
  hr

  docker image inspect "$rb_img" >/dev/null 2>&1 \
    || die "Image ${rb_img} is not present locally. Confirm the version number, or check: docker images | grep windmill"

  if [ "$images_only" != 1 ]; then
    [ -n "$bk" ] && [ -d "$bk" ] || die "Snapshot directory not found: ${bk:-<empty>}"
    [ -s "$bk/cluster.sql" ] || die "Snapshot missing cluster.sql: $bk"
    verify_dump_file "$bk/cluster.sql" || die "Snapshot unusable: $bk"
    if [ -f "$bk/cluster.sql.sha256" ]; then
      ( cd "$bk" && sha256sum -c cluster.sql.sha256 ) >/dev/null || die "Snapshot sha256 verification failed: $bk"
      info "  Snapshot integrity verified"
    else
      warn "  Snapshot has no sha256 file; skipping verification"
    fi
    warn "⚠️  This will delete the database volume and rebuild it from the snapshot; all changes in the current DB after this snapshot will be lost."
    if [ "$assume" = 1 ]; then ASSUME_YES=1; fi
    confirm "Confirm rollback?" || exit 0
  fi

  local stop_ts; stop_ts=$(date +%Y%m%d-%H%M%S)
  crun set_env WM_IMAGE "$rb_img"
  crun set_env WM_EXTRA_IMAGE "$rb_extra"
  info "  Pointed .env version back to $target"

  if [ "$images_only" = 1 ]; then
    step "Images only: rebuild containers in stages"
    crun stack_up_staged || die "Staged startup failed"
  else
    step "1/6 Stop the whole stack (keep volumes)"
    crun compose down --remove-orphans || true

    step "2/6 Remove the db data volume"
    local vol; vol=$(db_volume)
    [ -n "$vol" ] && crun docker volume rm -f "$vol" >/dev/null 2>&1 || true
    if [ "$DRY_RUN" != 1 ] && [ -n "$vol" ] && docker volume inspect "$vol" >/dev/null 2>&1; then
      die "Volume $vol still exists (may be in use). Run $CLI_NAME down first, then retry."
    fi

    step "3/6 Start the database"
    crun compose up -d --wait db || die "Database failed to start"
    wait_db || warn "db did not become healthy; continuing"

    step "4/6 Restore the snapshot"
    restore_cluster_from "$bk/cluster.sql" "$bk/restore-${stop_ts}.log" || warn "Restore had issues; see the log"
    sync_db_password || true

    step "5/6 Rebuild planner stats"
    refresh_planner_stats

    step "6/6 Start the whole stack in stages"
    crun stack_up_staged || die "Staged startup failed"
  fi

  if wait_version "$target" && all_running; then
    write_version "$target"
    hr; ok "Rollback complete; current version $target"
    log "  Probed version : $(probe_version)"
    log "  Migrations     : $(migration_count || echo '?')"
    hr
  else
    warn "Probe failed after rollback; manual intervention required."
    warn "  Inspect: $CLI_NAME status"
    warn "  Logs   : $CLI_NAME logs windmill_server"
    exit 1
  fi
}

# =============================================================================
# Command: backup / snapshots / restore / drill
# =============================================================================
cmd_backup() {
  local full=0 daily=0 keep="${KEEP:-7}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --full)      full=1; shift ;;
      --daily)     daily=1; shift ;;
      --keep)      keep="${2:-7}"; shift 2 ;;
      -h|--help)   help_backup; exit 0 ;;
      *)           usage_die "backup: unknown argument $1" ;;
    esac
  done
  require_ready
  wm_paths
  [ -f "$COMPOSE_FILE" ] || die "No deploy found"
  mkdir -p "$BACKUP_DIR" "$LOG_DIR"
  acquire_lock

  if [ "$full" = 1 ]; then
    hr; log "${C_BOLD}Full snapshot${C_RESET} (DB + config)  $(ts)"; hr
    db_healthy || warn "db is not healthy; attempting the backup anyway"
    local d; d=$(new_backup_dir)
    if make_backup "$d"; then
      prune_backups 5
      hr; ok "Full snapshot ready: $d"
      log "  Rebuild with: $CLI_NAME deploy --from $d"
      hr
      append_log backup.log "Full snapshot succeeded: $d"
      exit 0
    fi
    warn "Full snapshot failed; the scene is preserved for diagnosis: $d"
    append_log backup.log "Full snapshot failed: $d"
    exit 1
  fi

  # Daily backup (DB only)
  hr; log "${C_BOLD}Daily backup${C_RESET} (keeps $keep)  $(ts)"; hr
  db_healthy || warn "db is not healthy; attempting the backup anyway"

  local daily_dir="$BACKUP_DIR/daily"
  mkdir -p "$daily_dir"
  local stamp out err
  stamp=$(date +%Y%m%d-%H%M%S)
  out="$daily_dir/cluster-${stamp}.sql"
  err="$daily_dir/.last-error"

  if ! pg_exec pg_dumpall -U "$(pg_user)" > "$out" 2>"$err"; then
    warn "pg_dumpall failed:"; cat "$err" >&2; rm -f "$out"
    append_log backup.log "Daily backup failed: pg_dumpall errored"
    exit 1
  fi
  if [ ! -s "$out" ]; then warn "Backup is empty; deleted"; rm -f "$out"; append_log backup.log "Daily backup failed: empty file"; exit 1; fi
  if ! tail -3 "$out" | grep -q 'dump complete'; then
    warn "Backup incomplete (missing the dump complete marker); deleted to avoid leaving a bad backup"
    rm -f "$out"; append_log backup.log "Daily backup failed: incomplete"; exit 1
  fi

  gzip -f "$out"
  sha256sum "${out}.gz" > "${out}.gz.sha256"
  ok "Backup complete: ${out}.gz ($(du -h "${out}.gz" | cut -f1))"
  info "  sha256 $(cut -d' ' -f1 < "${out}.gz.sha256")"

  local removed=0
  while read -r f; do
    [ -n "$f" ] || continue
    log "  Prune expired backup: $(basename "$f")"
    rm -f "$f" "$f.sha256"
    removed=$((removed+1))
  done < <(ls -1t "$daily_dir"/cluster-*.sql.gz 2>/dev/null | tail -n +$((keep+1)))

  local count; count=$(count_files "$daily_dir"/cluster-*.sql.gz)
  ok "Daily backup done: pruned $removed, now keeping $count"
  hr
  append_log backup.log "Daily backup succeeded: $(basename "${out}.gz") ($(du -h "${out}.gz" | cut -f1)), keeping $count"
}

cmd_snapshots() {
  wm_paths
  local d v m s
  hr; log "${C_BOLD}Snapshot list${C_RESET}  $BACKUP_DIR"; hr
  if [ -z "$(snapshot_list)" ]; then log "  ${C_DIM}<none>${C_RESET}"; fi
  for d in $(snapshot_list); do
    v=$(sed -n 's/^WM_VERSION=//p' "$d/meta.env" 2>/dev/null | head -1 || true)
    m=$(sed -n 's/^MIGRATION_COUNT=//p' "$d/meta.env" 2>/dev/null | head -1 || true)
    s=$(du -h "$d/cluster.sql" 2>/dev/null | cut -f1 || true)
    printf '  %-20s version=%-10s migrations=%-6s size=%-8s\n' "$(basename "$d")" "${v:-?}" "${m:-?}" "${s:-?}"
  done
  log ""
  log "${C_BOLD}Daily backups${C_RESET}"
  local dfiles; dfiles=$(ls -1t "$BACKUP_DIR"/daily/cluster-*.sql.gz 2>/dev/null || true)
  if [ -n "$dfiles" ]; then
    printf '%s\n' "$dfiles" | head -10 | while read -r f; do
      printf '  %-40s %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)"
    done
  fi
  if [ -z "$(latest_daily_backup)" ]; then log "  ${C_DIM}<none>${C_RESET}"; fi
  hr
}

cmd_restore() {
  [ $# -ge 1 ] || usage_die "restore: usage $CLI_NAME restore <snapshot dir|daily backup file>"
  local src="$1"; shift
  # Daily backup file -> deploy --from-daily; snapshot directory -> deploy --from
  case "$src" in
    *.sql.gz) cmd_deploy --from-daily "$src" --yes ;;
    *)        cmd_deploy --from "$src" ;;
  esac
}

cmd_drill() {
  local snap="" keep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep)    keep=1; shift ;;
      -h|--help) help_drill; exit 0 ;;
      *)         snap="$1"; shift ;;
    esac
  done
  require_ready
  wm_paths
  mkdir -p "$LOG_DIR"
  acquire_lock

  [ -n "$snap" ] || snap=$(latest_snapshot)
  [ -n "$snap" ] || die "No snapshot found. Run $CLI_NAME backup --full first"
  [ -f "$snap/cluster.sql" ] || die "Snapshot missing cluster.sql: $snap"

  hr
  log "${C_BOLD}Backup restorability drill${C_RESET}  $(ts)"
  log "  Snapshot: $snap"
  log "  dump : $(du -h "$snap/cluster.sql" | cut -f1)"
  hr

  if [ -f "$snap/cluster.sql.sha256" ]; then
    ( cd "$snap" && sha256sum -c cluster.sql.sha256 >/dev/null ) || die "Snapshot sha256 verification failed"
    info "  sha256 verified"
  fi
  verify_dump_file "$snap/cluster.sql" || die "dump structure unusable"

  local exp_mig; exp_mig=$(sed -n 's/^MIGRATION_COUNT=//p' "$snap/meta.env" 2>/dev/null | tr -d '[:space:]')

  cleanup_drill() {
    if [ "$keep" = "1" ]; then
      warn "Kept the drill container $DRILL_CT and volume ${DRILL_VOL} (cleanup: docker rm -f $DRILL_CT && docker volume rm ${DRILL_VOL})"
      return 0
    fi
    docker rm -f "$DRILL_CT" >/dev/null 2>&1 || true
    docker volume rm -f "$DRILL_VOL" >/dev/null 2>&1 || true
  }
  trap cleanup_drill EXIT

  info "  Clean up the previous drill leftovers"
  docker rm -f "$DRILL_CT" >/dev/null 2>&1 || true
  docker volume rm -f "$DRILL_VOL" >/dev/null 2>&1 || true

  step "Start the temporary drill container (--network none, not on the production network)"
  docker run -d --name "$DRILL_CT" --network none \
    -e POSTGRES_PASSWORD=drill-only -e POSTGRES_DB=windmill \
    -v "$DRILL_VOL":/var/lib/postgresql \
    "$PG_IMAGE" >/dev/null || die "Cannot start the drill container (is the $PG_IMAGE image pulled?)"

  step "Wait for the drill DB to be ready"
  local okd=0 i
  for i in $(seq 1 40); do
    docker exec "$DRILL_CT" pg_isready -U postgres >/dev/null 2>&1 && { okd=1; break; }
    sleep 3
  done
  [ "$okd" = 1 ] || { docker logs --tail 30 "$DRILL_CT" >&2; die "Drill DB not ready"; }

  step "Restore the snapshot"
  local drill_log="$LOG_DIR/restore-drill.log"
  docker exec "$DRILL_CT" psql -U postgres -d postgres -c 'DROP DATABASE IF EXISTS windmill' >/dev/null 2>&1 || true
  docker cp "$snap/cluster.sql" "$DRILL_CT":/tmp/restore.sql >/dev/null || die "Cannot copy the dump into the drill container"
  docker exec "$DRILL_CT" psql -U postgres -d postgres -f /tmp/restore.sql > "$drill_log" 2>&1 || true

  local errs; errs=$(grep -ci '^ERROR' "$drill_log" 2>/dev/null || true); errs="${errs:-0}"
  info "  Restore log ERROR lines = ${errs} (expect 0 or 1)"

  step "Verify the restore result"
  dq() { docker exec "$DRILL_CT" psql -U postgres -d windmill -tAc "$1" 2>/dev/null | tr -d '[:space:]'; }
  local mig users wss scripts pol roles
  mig=$(dq 'select count(*) from _sqlx_migrations'); users=$(dq 'select count(*) from password')
  wss=$(dq 'select count(*) from workspace'); scripts=$(dq 'select count(*) from script')
  pol=$(dq 'select count(*) from pg_policies'); roles=$(dq "select count(*) from pg_roles where rolname like 'windmill%'")

  printf '  %-16s %s\n' "Migrations"    "$mig (snapshot record: ${exp_mig:-?})"
  printf '  %-16s %s\n' "Users"         "$users"
  printf '  %-16s %s\n' "Workspaces"    "$wss"
  printf '  %-16s %s\n' "Scripts"       "$scripts"
  printf '  %-16s %s\n' "RLS policies"  "$pol"
  printf '  %-16s %s\n' "windmill roles" "$roles"

  local fl=0
  if [ -n "$exp_mig" ] && [ "$mig" != "$exp_mig" ]; then warn "Migration count does not match the snapshot record"; fl=1; fi
  if [ "${pol:-0}" -lt 300 ]; then warn "RLS policy count is low (${pol}); some may be silently missing"; fl=1; fi
  if [ "${roles:-0}" -lt 2 ]; then warn "windmill_admin / windmill_user roles are missing"; fl=1; fi
  if [ "${users:-0}" -lt 1 ]; then warn "No users after restore"; fl=1; fi
  if [ "$errs" -gt 1 ]; then warn "Unexpected errors in the restore log"; fl=1; fi

  hr
  if [ "$fl" = 0 ]; then
    ok "Drill passed: the backup is usable; the rollback chain holds"
    append_log restore-drill.log "Drill passed: $(basename "$snap") migrations=$mig policies=$pol"
  else
    err "The drill found issues; see $drill_log"
    warn "Until fixed, do not treat this backup as a reliable rollback basis."
    append_log restore-drill.log "Drill failed: $(basename "$snap")"
  fi
  hr
  exit $fl
}

# =============================================================================
# Command: logs / shell / exec / psql
# =============================================================================
cmd_logs() {
  local svc="windmill_server" tail_n="200" follow=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      -n|--tail)   tail_n="${2:-200}"; shift 2 ;;
      -h|--help)   help_logs; exit 0 ;;
      -*)          usage_die "logs: unknown argument $1" ;;
      *)           svc="$1"; shift ;;
    esac
  done
  require_docker; wm_paths
  [ -f "$COMPOSE_FILE" ] || die "No deploy found"
  # systemd component logs go through journal
  if [ "$svc" = "systemd" ]; then
    journalctl -u 'windmill-*' -n "$tail_n" --no-pager ${follow:+-f}
    return
  fi
  if [ "$follow" = 1 ]; then compose logs -f --tail "$tail_n" "$svc"
  else compose logs --tail "$tail_n" "$svc"; fi
}

cmd_shell() {
  local svc="${1:-windmill_server}"
  case "$svc" in -h|--help) help_shell; exit 0 ;; -*) usage_die "shell: unknown argument $svc" ;; esac
  require_docker; wm_paths
  [ -t 0 ] || die "shell requires an interactive terminal (TTY)"
  compose exec "$svc" sh
}

cmd_exec() {
  [ $# -ge 2 ] || usage_die "exec: usage $CLI_NAME exec <service> <command...>"
  local svc="$1"; shift
  require_docker; wm_paths
  [ -f "$COMPOSE_FILE" ] || die "No deploy found"
  if [ -t 0 ]; then compose exec "$svc" "$@"; else dexec "$svc" "$@"; fi
}

cmd_psql() {
  local db="${1:-windmill}"
  require_docker; wm_paths
  [ -f "$COMPOSE_FILE" ] || die "No deploy found"
  log "Connecting to postgres / $db   ${C_DIM}(\\q to quit)${C_RESET}"
  if [ -t 0 ]; then compose exec db psql -U postgres -d "$db"
  else dexec db psql -U postgres -d "$db"; fi
}

# =============================================================================
# Command: credentials
# =============================================================================
cmd_credentials() {
  local action="show" newpass="" oldpass=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --show)         action="show"; shift ;;
      --rotate-admin) action="rotate-admin"; shift ;;
      --rotate-db)    action="rotate-db"; shift ;;
      --new)          newpass="${2:-}"; shift 2 ;;
      --old)          oldpass="${2:-}"; shift 2 ;;
      -h|--help)      help_credentials; exit 0 ;;
      *)              usage_die "credentials: unknown argument $1" ;;
    esac
  done
  require_ready; wm_paths
  [ -f "$ENV_FILE" ] || die "No deploy found"

  case "$action" in
    show)
      hr; log "${C_BOLD}Credentials${C_RESET}  $(ts)"; hr
      local base
      base=$(instance_url)
      printf '  %-16s %s\n' "URL"          "$base"
      printf '  %-16s %s\n' "admin account" "admin@windmill.dev"
      if [ -f "$WM_DIR/CREDENTIALS.txt" ]; then
        printf '  %-16s %s\n' "admin password" "$(sed -n 's/^ADMIN_PASSWORD=//p' "$WM_DIR/CREDENTIALS.txt" | head -1)"
        info "  (from $WM_DIR/CREDENTIALS.txt)"
      else
        printf '  %-16s %s\n' "admin password" "${C_YELLOW}<not on record; may still be changeme or manually changed>${C_RESET}"
      fi
      printf '  %-16s %s\n' "DB user"   "postgres"
      printf '  %-16s %s\n' "DB password" "$(get_env POSTGRES_PASSWORD)"
      hr
      log "${C_DIM}Rotate: $CLI_NAME credentials --rotate-admin | --rotate-db${C_RESET}"
      hr
      ;;
    rotate-admin)
      [ -n "$oldpass" ] || oldpass=$(sed -n 's/^ADMIN_PASSWORD=//p' "$WM_DIR/CREDENTIALS.txt" 2>/dev/null | head -1)
      [ -n "$oldpass" ] || oldpass="changeme"
      [ -n "$newpass" ] || newpass=$(gen_password 28)

      step "Rotate admin password"
      local token; token=$(wm_login "$oldpass")
      [ -n "$token" ] || die "Login with the current password failed. If the password is non-default, specify: --old <current password>"

      local code; code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
        -X POST "http://127.0.0.1/api/users/setpassword" \
        -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
        -d "{\"password\":\"${newpass}\"}" 2>/dev/null || echo 000)
      [ "$code" = "200" ] || die "Password change failed HTTP ${code} (the correct endpoint is setpassword, not set_password)"

      [ -n "$(wm_login "$newpass")" ] || die "New password login verification failed; please check manually"
      ok "Password rotated and verified"
      log "  New password: ${C_BOLD}${newpass}${C_RESET}"

      # Write back to the credentials file in sync
      local tmp; tmp=$(mktemp)
      if [ -f "$WM_DIR/CREDENTIALS.txt" ]; then
        grep -v '^ADMIN_PASSWORD=' "$WM_DIR/CREDENTIALS.txt" > "$tmp" || true
      else
        { echo "# Windmill credentials"; echo "ADMIN_USER=admin@windmill.dev"; } > "$tmp"
      fi
      echo "ADMIN_PASSWORD=$newpass" >> "$tmp"
      mv "$tmp" "$WM_DIR/CREDENTIALS.txt"; chmod 0600 "$WM_DIR/CREDENTIALS.txt"
      info "  Updated $WM_DIR/CREDENTIALS.txt"
      ;;
    rotate-db)
      [ -n "$newpass" ] || newpass=$(gen_password 32)

      step "Rotate the database password"
      warn "Note: running containers still hold the old password; you must rebuild immediately after rotating, or new connections will fail."
      confirm "Confirm rotating the database password?" || exit 0

      dexec db psql -U postgres -d postgres -c "ALTER USER postgres WITH PASSWORD '${newpass}'" >/dev/null 2>&1 \
        || die "ALTER USER failed"

      crun set_env POSTGRES_PASSWORD "$newpass"
      crun set_env DATABASE_URL "postgres://postgres:${newpass}@db/windmill?sslmode=disable"

      # Verify via a real network path from another container (local 127.0.0.1 uses
      # trust auth, so the password is not involved in the check)
      local r; r=$(dexec windmill_server sh -c "PGPASSWORD='${newpass}' psql -h db -U postgres -d windmill -tAc 'select 1'" 2>/dev/null | tr -d '[:space:]')
      if [ "$r" = "1" ]; then
        ok "The new password is in effect (verified via the inter-container network path)"
      else
        warn "The new password did not authenticate over the network; check the DATABASE_URL in $ENV_FILE"
      fi
      log "  New DB password: ${C_BOLD}${newpass}${C_RESET}"
      step "Rebuild containers to apply the new password"
      crun stack_up_staged || warn "Rebuild did not fully succeed; check $CLI_NAME status"
      ;;
  esac
}

