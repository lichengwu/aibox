# =============================================================================
# 入口分发
# =============================================================================
CLI_SET_DIR=0; CLI_SET_PORT=0; CLI_SET_PROXY=0; CLI_SET_MIRROR=0; CLI_SET_HUB=0

main() {
  # --- 全局选项 -------------------------------------------------------------
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--dir)    WM_DIR="${2:-}"; CLI_SET_DIR=1; shift 2 ;;
      --port)      HTTP_PORT="${2:-}"; CLI_SET_PORT=1; shift 2 ;;
      --proxy)     PROXY_URL="${2:-}"; CLI_SET_PROXY=1; shift 2 ;;
      --ghcr-mirror) WM_GHCR_MIRROR="${2:-}"; CLI_SET_MIRROR=1; shift 2 ;;
      --hub-mirror)  WM_HUB_MIRROR="${2:-}"; CLI_SET_HUB=1; shift 2 ;;
      -y|--yes)    ASSUME_YES=1; shift ;;
      -q|--quiet)  QUIET=1; shift ;;
      --dry-run)   DRY_RUN=1; shift ;;
      -h|--help)   help_main; exit 0 ;;
      -V|--version) printf '%s %s\n' "$CLI_NAME" "$WINDMILL_CLI_VERSION"; exit 0 ;;
      --)          shift; break ;;
      -*)          usage_die "未知全局选项: $1" ;;
      *)           break ;;
    esac
  done

  wm_paths
  # 从 .env 继承（命令行未显式指定时）
  if [ -f "$ENV_FILE" ]; then
    if [ "$CLI_SET_PORT" = 0 ]; then
      local p; p=$(get_env HTTP_PORT); HTTP_PORT="${p:-$HTTP_PORT}"
    fi
    if [ "$CLI_SET_PROXY" = 0 ]; then
      local px; px=$(get_env WM_PROXY); PROXY_URL="${px:-$PROXY_URL}"
    fi
    if [ "$CLI_SET_MIRROR" = 0 ]; then
      local mm; mm=$(get_env WM_GHCR_MIRROR); WM_GHCR_MIRROR="${mm:-$WM_GHCR_MIRROR}"
    fi
    if [ "$CLI_SET_HUB" = 0 ]; then
      local hm; hm=$(get_env WM_HUB_MIRROR); WM_HUB_MIRROR="${hm:-$WM_HUB_MIRROR}"
    fi
  fi

  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  # 允许**全局开关**出现在子命令之后（-y/--yes、-q/--quiet、--dry-run）。
  # 背景：本 CLI 生成的 systemd 单元里选项是挂在子命令后面的，例如
  #   ExecStart=... windmill up --quiet
  #   ExecStart=... windmill backup --daily --quiet --yes
  #   ExecStart=... windmill check --quiet
  # 而全局选项扫描只发生在子命令**之前**，于是这些调用会撞「未知参数」并让单元
  # failed（实测 windmill-stack.service 因此起不来；备份命令则卡在 --yes）。
  # 这里在分发前把任意位置出现的全局开关摘掉，使两种写法都成立。
  if [ $# -gt 0 ]; then
    local _kept=() _a
    for _a in "$@"; do
      case "$_a" in
        -q|--quiet)  QUIET=1 ;;
        -y|--yes)    ASSUME_YES=1 ;;
        --dry-run)   DRY_RUN=1 ;;
        *)           _kept+=("$_a") ;;
      esac
    done
    set -- "${_kept[@]+"${_kept[@]}"}"
  fi

  case "$cmd" in
    init)        cmd_init "$@" ;;
    deploy)      cmd_deploy "$@" ;;
    destroy)     cmd_destroy "$@" ;;
    up)          cmd_up "$@" ;;
    down)        cmd_down "$@" ;;
    status|st)   cmd_status "$@" ;;
    doctor|dr)   cmd_doctor "$@" ;;
    check)       cmd_check "$@" ;;
    upgrade)     cmd_upgrade "$@" ;;
    rollback|rb) cmd_rollback "$@" ;;
    backup|bk)   cmd_backup "$@" ;;
    snapshots)   cmd_snapshots "$@" ;;
    restore)     cmd_restore "$@" ;;
    drill)       cmd_drill "$@" ;;
    logs|log)    cmd_logs "$@" ;;
    shell|sh)    cmd_shell "$@" ;;
    exec)        cmd_exec "$@" ;;
    psql)        cmd_psql "$@" ;;
    credentials|cred) cmd_credentials "$@" ;;
    systemd)     cmd_systemd "$@" ;;
    version|ver) cmd_version "$@" ;;
    help)        cmd_help "$@" ;;
    *)           usage_die "未知命令: $cmd" ;;
  esac
}

main "$@"
