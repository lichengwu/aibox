cmd_version() {
  wm_paths
  printf '%s%s%s %s\n' "$C_BOLD" "$CLI_NAME" "$C_RESET" "$WINDMILL_CLI_VERSION"
  info "  CLI  构建于 $CLI_UPDATED"
  if [ -f "$COMPOSE_FILE" ]; then
    printf '  %-14s %s\n' "部署版本" "$(current_version)"
    printf '  %-14s %s\n' "镜像版本" "$(env_version)"
    printf '  %-14s %s\n' "运行版本" "$(probe_version)"
    printf '  %-14s %s\n' "compose"  "$(docker compose version --short 2>/dev/null || echo '?')"
    printf '  %-14s %s\n' "docker"   "$(docker --version 2>/dev/null | cut -d' ' -f3 | tr -d ',')"
  else
    info "  未发现部署（${WM_DIR}）"
  fi
}

